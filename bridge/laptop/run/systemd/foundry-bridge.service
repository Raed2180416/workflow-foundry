# Installed by LAPTOP-HANDOFF.md step 12 (placeholders @NODE@ and @REPO@ are filled in with sed).
[Unit]
Description=Foundry bridge daemon (127.0.0.1:8765)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@NODE@ @REPO@/bridge/laptop/daemon.mjs --config %h/foundry-bridge/bridge-config.json
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=45
StandardOutput=append:%h/foundry-bridge/daemon.log
StandardError=append:%h/foundry-bridge/daemon.log

[Install]
WantedBy=default.target
