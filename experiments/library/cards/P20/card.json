  "example": { "slots": {
    "GEN": { "tiers": ["claude-haiku-5-5"], "system": "Write the journal entry for the expense as debit and credit lines in minor units, using only accounts from the chart. If previousProblem is set, it describes what was wrong with your last entry.",
      "prompt": "(c) => JSON.stringify({ expense: c.input.expense, chart: c.input.chart, previousProblem: c.problem })",
      "schema": { "type": "object", "required": ["lines"], "properties": { "lines": { "type": "array", "items": { "type": "object", "required": ["account", "debitMinor", "creditMinor"], "properties": { "account": { "type": "string" }, "debitMinor": { "type": "integer" }, "creditMinor": { "type": "integer" } } } } } } },
    "VERIFY": "(out, x) => { const d = out.lines.reduce((n, l) => n + l.debitMinor, 0), c = out.lines.reduce((n, l) => n + l.creditMinor, 0); if (d !== c) return 'unbalanced: debits ' + d + ', credits ' + c; const bad = out.lines.find(l => !x.chart.includes(l.account)); return bad ? 'unknown account ' + bad.account : null; }",
    "MAX_TRIES": 3,
    "FEEDBACK": true,
    "ON_FAIL": "deopt"
  } }
