[
 {
  "alias": "Garage Garbage Day Reminders",
  "id": "3f97f3be-3d0a-4d2d-9100-5b9c0dbfd5c3",
  "description": "Remind Carlo to handle garbage day, with phone actions that silence all related speech for 30 minutes or 2 hours.",
  "mode": "restart",
  "trigger": [
   {
    "platform": "state",
    "entity_id": "group.garage_doors",
    "from": "closed",
    "to": "open",
    "for": "00:00:20",
    "id": "garage_open"
   },
   {
    "platform": "event",
    "event_type": "mobile_app_notification_action",
    "event_data": {
     "action": "SNOOZE_GARBAGE_REMINDERS_30M"
    },
    "id": "snooze_30m"
   },
   {
    "platform": "event",
    "event_type": "mobile_app_notification_action",
    "event_data": {
     "action": "SNOOZE_GARBAGE_REMINDERS_2H"
    },
    "id": "snooze_2h"
   }
  ],
  "action": [
   {
    "choose": [
     {
      "conditions": [
       {
        "condition": "trigger",
        "id": [
         "snooze_30m",
         "snooze_2h"
        ]
       }
      ],
      "sequence": [
       {
        "variables": {
         "snooze_duration": "{{ '00:30:00' if trigger.id == 'snooze_30m' else '02:00:00' }}",
         "snooze_label": "{{ '30 minutes' if trigger.id == 'snooze_30m' else '2 hours' }}"
        }
       },
       {
        "service": "timer.start",
        "target": {
         "entity_id": "timer.garbage_reminder_snooze"
        },
        "data": {
         "duration": "{{ snooze_duration }}"
        }
       },
       {
        "service": "script.send_to_logbook",
        "data": {
         "topic": "GARBAGE",
         "message": "Garbage reminders snoozed for {{ snooze_label }} from Carlo's phone."
        }
       },
       {
        "stop": "Garbage reminder snooze saved."
       }
      ]
     }
    ]
   },
   {
    "condition": "trigger",
    "id": "garage_open"
   },
   {
    "condition": "time",
    "weekday": [
     "wed",
     "sun"
    ]
   },
   {
    "condition": "state",
    "entity_id": "timer.garbage_reminder_snooze",
    "state": "idle"
   },
   {
    "variables": {
     "reminder_delays": [
      30,
      60,
      90
     ],
     "reminder_message": "Reminder: it's garbage day. {% if now().strftime('%a') == 'Wed' %} Both recycling and regular garbage go out today. {% endif %} Please take the cans to the curb before you leave."
    }
   },
   {
    "parallel": [
     {
      "service": "script.notify_engine_two_button",
      "data": {
       "title": "Garbage Day Reminder",
       "value1": "{{ reminder_message }}",
       "who": "carlo",
       "group": "Garbage_Reminders",
       "tag": "garbage_day_reminder",
       "level": "active",
       "title1": "Snooze 30m",
       "action1": "SNOOZE_GARBAGE_REMINDERS_30M",
       "icon1": "sfsymbols:clock",
       "title2": "Snooze 2h",
       "action2": "SNOOZE_GARBAGE_REMINDERS_2H",
       "icon2": "sfsymbols:clock.badge.checkmark"
      }
     },
     {
      "service": "script.speech_engine",
      "data": {
       "value1": "{{ reminder_message }}"
      }
     }
    ]
   },
   {
    "repeat": {
     "for_each": "{{ reminder_delays }}",
     "sequence": [
      {
       "delay": {
        "seconds": "{{ repeat.item }}"
       }
      },
      {
       "condition": "state",
       "entity_id": "group.garage_doors",
       "state": "open"
      },
      {
       "condition": "time",
       "weekday": [
        "wed",
        "sun"
       ]
      },
      {
       "condition": "state",
       "entity_id": "timer.garbage_reminder_snooze",
       "state": "idle"
      },
      {
       "service": "notify.alexa_media_garage",
       "data": {
        "message": "{{ reminder_message }}",
        "data": {
         "type": "announce"
        }
       }
      }
     ]
    }
   }
  ]
 }
]