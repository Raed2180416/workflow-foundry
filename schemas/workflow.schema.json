{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contrare.example/schemas/workflow-1.0.json",
  "title": "Workflow Foundry bounded workflow IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "goal", "domain", "envelope", "budget", "nodes", "acceptance"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"$ref": "#/definitions/id"},
    "version": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "goal": {"type": "string", "minLength": 1, "maxLength": 10000},
    "domain": {"type": "string", "minLength": 1, "maxLength": 80},
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["assumptions", "risks", "successCriteria"],
      "properties": {
        "assumptions": {"$ref": "#/definitions/texts"},
        "risks": {"$ref": "#/definitions/texts"},
        "successCriteria": {"$ref": "#/definitions/nonemptyTexts"},
        "unsupported": {"$ref": "#/definitions/texts"}
      }
    },
    "inputSchema": {"type": "object"},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["maxSteps", "maxConcurrency", "maxDurationMs"],
      "properties": {
        "maxSteps": {"type": "integer", "minimum": 1, "maximum": 100000},
        "maxConcurrency": {"type": "integer", "minimum": 1, "maximum": 16},
        "maxDurationMs": {"type": "integer", "minimum": 1, "maximum": 2592000000},
        "maxCost": {"type": "number", "minimum": 0, "maximum": 1000000},
        "maxTokens": {"type": "integer", "minimum": 1, "maximum": 10000000000, "description": "Model tokens the run may use (input, output and cache writes in full, cache reads at a tenth), whatever they cost in dollars."}
      }
    },
    "nodes": {"$ref": "#/definitions/nodes"},
    "acceptance": {"$ref": "#/definitions/checks"},
    "labels": {"type": "object", "maxProperties": 256, "propertyNames": {"maxLength": 512, "pattern": "^input(\\.[A-Za-z0-9_-]+)*$"}, "additionalProperties": {"$ref": "#/definitions/label"}},
    "discovery": {"type": "boolean"},
    "segregation": {
      "type": "array", "maxItems": 50,
      "description": "Segregation of duties (2026-10-21, compromise D1; src/principals.mjs): the actors who answer the named human nodes of one run must be pairwise distinct. Each named node is one human node with a principal. Optional: a workflow without it, or without principals, behaves exactly as before.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["nodes"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "nodes": {"type": "array", "minItems": 2, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
          "description": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "state": {"type": "object", "maxProperties": 32, "propertyNames": {"pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"}, "additionalProperties": {"$ref": "#/definitions/stateSlot"},
      "description": "Cross-run keyed state shared by every run (and version) of this workflow id, one slot per name (src/state.mjs). Read and written only by state nodes; only the slot's declared writer writes it."},
    "defaultClass": {"type": "string", "minLength": 1, "maxLength": 16, "description": "The model class most nodes are expected to start on. A model node that starts above it needs model.justification (strict lint CLASS_ABOVE_DEFAULT_UNJUSTIFIED). Absent: the cheapest class any model node starts on."},
    "oracle": {
      "type": "object", "additionalProperties": false, "required": ["mode", "reason"],
      "description": "Declares that no independent oracle exists for this task. Without it, acceptance that only checks that an answer exists is a strict-lint error. With it, a succeeded run ends with verdict \"unverified\", never \"pass\".",
      "properties": {
        "mode": {"const": "none"},
        "reason": {"type": "string", "minLength": 20, "maxLength": 2000, "description": "Why no executable or independent check exists and what a person should check instead."}
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sources": {"$ref": "#/definitions/texts"},
        "rationale": {"type": "string", "maxLength": 20000},
        "tags": {"$ref": "#/definitions/texts"}
      }
    }
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"},
    "roleId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,59}$"},
    "principal": {
      "type": "object", "additionalProperties": false, "required": ["role"],
      "description": "Who may answer a human node (2026-10-21, compromise D1; src/principals.mjs). Roles are names from the host's role matrix (the OT-0 constitution's roles and principals), which the host supplies and the workflow never does. The answer must carry an actor that holds `role`; with `threshold`, an amount above `above` (or unreadable, or decided by untrusted data) also needs `threshold.role` (delegation of authority). Optional: a human node without it accepts any answer, as before.",
      "properties": {
        "role": {"$ref": "#/definitions/roleId"},
        "threshold": {
          "type": "object", "additionalProperties": false, "required": ["amount", "above", "role"],
          "properties": {
            "amount": {"anyOf": [{"type": "number"}, {"type": "object", "required": ["$ref"]}]},
            "above": {"type": "number", "minimum": 0},
            "role": {"$ref": "#/definitions/roleId"}
          }
        }
      }
    },
    "texts": {"type": "array", "maxItems": 200, "items": {"type": "string", "maxLength": 10000}},
    "nonemptyTexts": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 10000}},
    "label": {"type": "string", "maxLength": 512, "pattern": "^(?:trusted|untrusted:[A-Za-z0-9_.:-]+(?:\\+[A-Za-z0-9_.:-]+)*)$"},
    "signalName": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"},
    "signalSubscription": {
      "type": "object", "additionalProperties": false, "required": ["signal"],
      "description": "One raced signal: its name, the correlation key computed from the instance when the wait starts (a template; absent: any key), and its payload schema (absent: no payload).",
      "properties": {"signal": {"$ref": "#/definitions/signalName"}, "correlate": {}, "schema": {"type": "object"}}
    },
    "modelChoice": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"class": {"type": "string", "minLength": 1, "maxLength": 16}, "id": {"type": "string", "minLength": 1, "maxLength": 128}, "maxClass": {"type": "string", "minLength": 1, "maxLength": 16},
        "justification": {"type": "string", "minLength": 10, "maxLength": 1000, "description": "Why this node starts on a class above the workflow default, ideally the result of a cheaper-class attempt."}},
      "anyOf": [{"required": ["class"]}, {"required": ["id"]}]
    },
    "contextInput": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"}, "ref": {"type": "string", "minLength": 1, "maxLength": 512}, "value": {},
        "label": {"$ref": "#/definitions/label"}, "render": {"enum": ["json", "text"]},
        "maxTokens": {"type": "integer", "minimum": 1, "maximum": 1000000}, "priority": {"type": "number", "minimum": -1000000, "maximum": 1000000}
      },
      "oneOf": [{"required": ["ref"]}, {"required": ["value"]}]
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "persona": {"type": "string", "minLength": 1, "maxLength": 10000},
        "inputs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/definitions/contextInput"}},
        "recite": {"type": "object", "additionalProperties": false, "properties": {"goal": {"type": "boolean"}, "constraints": {"$ref": "#/definitions/texts"}, "acceptance": {"$ref": "#/definitions/texts"}}},
        "history": {"enum": ["none"]},
        "budget": {"type": "object", "additionalProperties": false, "properties": {"maxInputTokens": {"type": "integer", "minimum": 1, "maximum": 1000000}, "onOverflow": {"enum": ["fail", "truncate"]}}}
      }
    },
    "decoding": {"type": "object", "additionalProperties": false, "properties": {"maxTokens": {"type": "integer", "minimum": 1, "maximum": 65536}, "reasoning": {"enum": ["none", "low", "medium", "high"]}, "temperature": {"type": "number", "minimum": 0, "maximum": 2}}},
    "escalation": {"type": "object", "additionalProperties": false, "properties": {"schemaRetries": {"type": "integer", "minimum": 0, "maximum": 3}, "onCheckFail": {"enum": ["escalate", "resample", "fail"]}, "maxEscalations": {"type": "integer", "minimum": 0, "maximum": 2}, "maxResamples": {"type": "integer", "minimum": 0, "maximum": 8}}},
    "condition": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op", "left", "right"], "properties": {"op": {"enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "contains"]}, "left": {}, "right": {}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "value"], "properties": {"op": {"const": "exists"}, "value": {}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "conditions"], "properties": {"op": {"enum": ["all", "any"]}, "conditions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/definitions/condition"}}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "condition"], "properties": {"op": {"const": "not"}, "condition": {"$ref": "#/definitions/condition"}}}
      ]
    },
    "checks": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/definitions/condition"}},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/definitions/node"}},
    "stateSlot": {
      "type": "object", "additionalProperties": false, "required": ["type", "writer", "maxItems"],
      "properties": {
        "type": {"enum": ["set", "counter", "cursor", "record"]},
        "writer": {"oneOf": [{"$ref": "#/definitions/id"}, {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}}],
          "description": "The state node (or the few nodes, such as an upsert and an expiry) that may write this slot; no other node writes it."},
        "maxItems": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxValueBytes": {"type": "integer", "minimum": 1, "maximum": 262144},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "ttlMs": {"type": "integer", "minimum": 1, "maximum": 315360000000},
        "ttlDays": {"type": "integer", "minimum": 1, "maximum": 3650},
        "schema": {"type": "object", "description": "JSON schema of a record or cursor value."},
        "monotonic": {"type": "boolean", "description": "A cursor that never moves back in its order; it has no delete and no TTL."},
        "order": {"enum": ["number", "instant"], "description": "What a monotonic cursor compares: finite numbers (the default) or ISO 8601 date-times with an explicit offset, as instants."},
        "label": {"$ref": "#/definitions/label", "description": "The integrity label every read carries; no write may carry more taint."},
        "description": {"type": "string", "maxLength": 2000}
      },
      "not": {"required": ["ttlMs", "ttlDays"]},
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["record", "cursor"]}}}, "then": {"required": ["schema"]}},
        {"if": {"properties": {"type": {"enum": ["set", "counter"]}}}, "then": {"not": {"required": ["schema"]}}},
        {"if": {"properties": {"type": {"enum": ["set", "counter", "record"]}}}, "then": {"not": {"anyOf": [{"required": ["monotonic"]}, {"required": ["order"]}]}}}
      ]
    },
    "flow": {
      "type": "object", "additionalProperties": false, "required": ["nodes", "acceptance"],
      "properties": {"nodes": {"$ref": "#/definitions/nodes"}, "acceptance": {"$ref": "#/definitions/checks"}}
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "needs", "description"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "kind": {"enum": ["task", "assert", "human", "map", "loop", "wait", "agent", "code", "verify", "state"]},
        "needs": {"type": "array", "uniqueItems": true, "maxItems": 500, "items": {"$ref": "#/definitions/id"}},
        "join": {"enum": ["all_success", "all_resolved"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 10000},
        "when": {"$ref": "#/definitions/condition"},
        "tool": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$"},
        "args": {},
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 2592000000, "description": "At most 1 hour, except on a signal wait (at most 30 days)."},
        "retry": {
          "type": "object", "additionalProperties": false, "required": ["maxAttempts"],
          "properties": {
            "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 10},
            "backoffMs": {"type": "integer", "minimum": 0, "maximum": 60000}
          }
        },
        "onError": {"enum": ["stop", "continue"]},
        "checks": {"$ref": "#/definitions/checks"},
        "question": {"type": "string", "minLength": 1, "maxLength": 10000},
        "answerSchema": {"type": "object"},
        "principal": {"$ref": "#/definitions/principal"},
        "body": {"$ref": "#/definitions/flow"},
        "input": {},
        "items": {},
        "maxItems": {"type": "integer", "minimum": 0, "maximum": 1000},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
        "failure": {"enum": ["fail_fast", "collect"]},
        "maxIterations": {"type": "integer", "minimum": 1, "maximum": 1000},
        "initial": {},
        "until": {"$ref": "#/definitions/condition"},
        "delayMs": {"type": "integer", "minimum": 0, "maximum": 3600000},
        "at": {"description": "Absolute wake time: epoch milliseconds, an ISO 8601 date-time with an explicit offset, or a reference to one.",
          "anyOf": [{"type": "integer", "minimum": 0, "maximum": 8640000000000000}, {"type": "string", "minLength": 1, "maxLength": 64}, {"type": "object", "required": ["$ref"]}]},
        "signal": {"$ref": "#/definitions/signalName"},
        "correlate": {},
        "schema": {"type": "object"},
        "race": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/definitions/signalSubscription"}},
        "onTimeout": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$", "description": "fail (default), continue, or the id of the node in the same flow that runs instead of the wait's other dependents when it times out."},
        "role": {"enum": ["classify", "route", "extract", "judge", "generate", "synthesis", "code_edit", "plan", "verify"]},
        "instructions": {"type": "string", "minLength": 1, "maxLength": 50000},
        "context": {"$ref": "#/definitions/context"},
        "returns": {"type": "object"},
        "model": {"$ref": "#/definitions/modelChoice"},
        "decoding": {"$ref": "#/definitions/decoding"},
        "escalation": {"$ref": "#/definitions/escalation"},
        "quarantined": {"type": "boolean"},
        "lang": {"enum": ["js", "python"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 262144},
        "method": {"enum": ["code", "agent", "capability"]},
        "subject": {},
        "independence": {"enum": ["execution", "different-model", "same-model"]},
        "gate": {"type": "boolean"},
        "label": {"$ref": "#/definitions/label", "description": "A signal wait: the integrity label of what its signals carry (default trusted: an authenticated delivery, like an answer)."},
        "slot": {"$ref": "#/definitions/id"},
        "op": {"enum": ["get", "put", "add", "incr", "delete"]},
        "key": {},
        "value": {},
        "by": {},
        "ifVersion": {}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "task"}}}, "then": {"required": ["tool", "args", "timeoutMs", "retry"]}},
        {"if": {"properties": {"kind": {"const": "assert"}}}, "then": {"required": ["checks"]}},
        {"if": {"properties": {"kind": {"const": "human"}}}, "then": {"required": ["question", "answerSchema"]}},
        {"if": {"required": ["principal"]}, "then": {"properties": {"kind": {"const": "human"}}}},
        {"if": {"properties": {"kind": {"const": "map"}}}, "then": {"required": ["items", "maxItems", "body"]}},
        {"if": {"properties": {"kind": {"const": "loop"}}}, "then": {"required": ["maxIterations", "body", "until", "initial"]}},
        {"if": {"properties": {"kind": {"const": "wait"}}}, "then": {"anyOf": [{"required": ["delayMs"]}, {"required": ["at"]}, {"required": ["signal"]}, {"required": ["race"]}]}},
        {"if": {"properties": {"kind": {"not": {"const": "wait"}}}}, "then": {"properties": {"timeoutMs": {"maximum": 3600000}}}},
        {"if": {"properties": {"kind": {"const": "agent"}}}, "then": {"required": ["instructions", "returns", "model"]}},
        {"if": {"properties": {"kind": {"const": "code"}}}, "then": {"required": ["lang", "source"]}},
        {"if": {"properties": {"kind": {"const": "verify"}}}, "then": {"required": ["method", "subject", "independence"]}},
        {"if": {"properties": {"kind": {"const": "state"}}}, "then": {"required": ["slot", "op", "key"]}},
        {"if": {"required": ["method"], "properties": {"kind": {"const": "verify"}, "method": {"const": "code"}}}, "then": {"required": ["lang", "source"]}},
        {"if": {"required": ["method"], "properties": {"kind": {"const": "verify"}, "method": {"const": "agent"}}}, "then": {"required": ["instructions", "model"]}},
        {"if": {"required": ["method"], "properties": {"kind": {"const": "verify"}, "method": {"const": "capability"}}}, "then": {"required": ["tool", "args"]}}
      ]
    }
  }
}
