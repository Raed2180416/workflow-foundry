 "workflow": {
  "schemaVersion": "1.0",
  "id": "support-deflection",
  "version": 1,
  "title": "Support ticket answers and escalation",
  "goal": "Each run, answer the open, non-urgent tickets that mention a known keyword with the person's reply for it, and send every other open ticket to support@nimbusdesk.app in one digest, after a person approves each e-mail.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The tickets sheet holds one row per ticket with id, from, subject, body, priority and status",
    "Delivery is a local outbox file standing in for e-mail; nothing leaves this machine"
   ],
   "risks": [
    "An urgent or unusual ticket answered by a canned reply",
    "A ticket that nobody sees"
   ],
   "successCriteria": [
    "Every open ticket was either answered with a matching reply or sent to the person",
    "No urgent ticket was answered automatically",
    "This run delivered exactly the planned e-mails, each intact (checked by re-reading the outbox)"
   ],
   "unsupported": [
    "Closing tickets",
    "Writing new answers",
    "Running on a schedule by itself"
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string",
     "minLength": 10,
     "maxLength": 40
    }
   }
  },
  "budget": {
   "maxSteps": 3000,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read",
    "kind": "task",
    "needs": [],
    "description": "Read the tickets sheet",
    "tool": "sheet.read",
    "args": {
     "sheet": "tickets"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "open",
    "kind": "task",
    "needs": [
     "read"
    ],
    "description": "Keep the open tickets",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "open"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "routed",
    "kind": "task",
    "needs": [
     "open"
    ],
    "description": "Decide for each ticket: a known answer, or a person (urgent tickets always go to a person)",
    "tool": "rows.route",
    "args": {
     "rows": {
      "$ref": "nodes.open.rows"
     },
     "rules": [
      {
       "field": "priority",
       "op": "eq",
       "value": "urgent",
       "set": {
        "route": "person",
        "answer": ""
       }
      },
      {
       "field": [
        "subject",
        "body"
       ],
       "op": "contains",
       "value": "invoice",
       "set": {
        "route": "auto",
        "answer": "You can get a copy of your invoice in your account under Billing > Invoices."
       }
      }
     ],
     "otherwise": {
      "route": "person",
      "answer": ""
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "auto",
    "kind": "task",
    "needs": [
     "routed"
    ],
    "description": "The tickets with a known answer",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.routed.rows"
     },
     "where": [
      {
       "field": "route",
       "op": "eq",
       "value": "auto"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "person",
    "kind": "task",
    "needs": [
     "routed"
    ],
    "description": "The tickets a person must handle",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.routed.rows"
     },
     "where": [
      {
       "field": "route",
       "op": "eq",
       "value": "person"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "urgentAuto",
    "kind": "task",
    "needs": [
     "auto"
    ],
    "description": "Urgent tickets among the automatic answers (used by a check: must be none)",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.auto.rows"
     },
     "where": [
      {
       "field": "priority",
       "op": "eq",
       "value": "urgent"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "reply",
    "kind": "map",
    "needs": [
     "auto"
    ],
    "description": "Send each known answer",
    "items": {
     "$ref": "nodes.auto.rows"
    },
    "maxItems": 500,
    "concurrency": 1,
    "body": {
     "nodes": [
      {
       "id": "compose",
       "kind": "task",
       "needs": [],
       "description": "Write the reply",
       "tool": "core.template",
       "args": {
        "text": "Hi,\n\nThanks for getting in touch about \"{{subject}}\".\n\n{{answer}}\n\nIf this does not answer your question, just reply to this e-mail and a person will pick it up.\n\nNimbus Support",
        "variables": {
         "subject": {
          "$ref": "item.subject",
          "default": "your message"
         },
         "answer": {
          "$ref": "item.answer"
         }
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 2
       }
      },
      {
       "id": "subject",
       "kind": "task",
       "needs": [],
       "description": "Write the subject line",
       "tool": "core.template",
       "args": {
        "text": "Re: {{subject}} [ticket {{id}}]",
        "variables": {
         "subject": {
          "$ref": "item.subject",
          "default": "your message"
         },
         "id": {
          "$ref": "item.id"
         }
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 2
       }
      },
      {
       "id": "send",
       "kind": "task",
       "needs": [
        "compose",
        "subject"
       ],
       "description": "E-mail the answer to the customer (asks you first)",
       "tool": "outbox.send",
       "args": {
        "to": {
         "$ref": "item.from"
        },
        "subject": {
         "$ref": "nodes.subject.text"
        },
        "body": {
         "$ref": "nodes.compose.text"
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 1
       }
      }
     ],
     "acceptance": [
      {
       "op": "eq",
       "left": {
        "$ref": "nodes.send.delivered"
       },
       "right": true
      }
     ]
    }
   },
   {
    "id": "personLines",
    "kind": "task",
    "needs": [
     "person"
    ],
    "description": "List the tickets for a person",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.person.rows"
     },
     "line": "- ticket {{id}} [{{priority}}] {{subject}} (from {{from}})\n  {{body}}",
     "empty": "- none today"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "digest",
    "kind": "task",
    "needs": [
     "personLines",
     "auto"
    ],
    "description": "Write the digest for the person",
    "tool": "core.template",
    "args": {
     "text": "Tickets that need a person ({{count}}):\n{{lines}}\n\nAnswered automatically with your replies: {{auto}}.",
     "variables": {
      "count": {
       "$ref": "nodes.personLines.count"
      },
      "lines": {
       "$ref": "nodes.personLines.text"
      },
      "auto": {
       "$ref": "nodes.auto.count"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "digestSubject",
    "kind": "task",
    "needs": [
     "personLines"
    ],
    "description": "Write the digest subject",
    "tool": "core.template",
    "args": {
     "text": "Support: {{count}} ticket(s) need a person",
     "variables": {
      "count": {
       "$ref": "nodes.personLines.count"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "sendDigest",
    "kind": "task",
    "needs": [
     "digest",
     "digestSubject",
     "reply"
    ],
    "description": "E-mail the digest to support@nimbusdesk.app (asks you first)",
    "tool": "outbox.send",
    "args": {
     "to": "support@nimbusdesk.app",
     "subject": {
      "$ref": "nodes.digestSubject.text"
     },
     "body": {
      "$ref": "nodes.digest.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "expected",
    "kind": "task",
    "needs": [
     "auto"
    ],
    "description": "Which customers should have received an answer",
    "tool": "core.pluck",
    "args": {
     "items": {
      "$ref": "nodes.auto.rows"
     },
     "field": "from"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "audit",
    "kind": "verify",
    "needs": [
     "expected",
     "sendDigest"
    ],
    "description": "Re-read the outbox: one answer per matched ticket plus one digest, each intact",
    "method": "capability",
    "tool": "outbox.audit",
    "args": {
     "to": [
      {
       "$ref": "nodes.expected.items"
      },
      "support@nimbusdesk.app"
     ]
    },
    "subject": {
     "$ref": "nodes.reply"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.reply.count"
    },
    "right": {
     "$ref": "nodes.auto.count"
    }
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.urgentAuto.count"
    },
    "right": 0
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.sendDigest.delivered"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.audit.pass"
    },
    "right": true
   }
  ],
