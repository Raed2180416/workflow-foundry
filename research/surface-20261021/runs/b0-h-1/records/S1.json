 "workflow": {
  "schemaVersion": "1.0",
  "id": "ticket-triage-cobalt",
  "version": 1,
  "title": "Ticket triage: shipping and password replies, forward the rest",
  "goal": "Read open support tickets. Tickets that ask about shipping or where an order is get a reply that orders ship in 2-3 business days and a tracking link is emailed. Tickets about passwords get a reply pointing to the 'Forgot password' link on the login page. All other open tickets are forwarded in one summary to help@cobaltcandle.com.",
  "domain": "support",
  "envelope": {
   "assumptions": [
    "Topic is decided by keyword match on ticket subject or body: 'shipping', 'where is my order', 'where's my order' (shipping); 'password' (password); anything else is other.",
    "Only tickets with status open are handled. Tickets are not closed or edited by this flow.",
    "Each outbound send to a customer or to help@cobaltcandle.com is approved by a person before dispatch."
   ],
   "risks": [
    "Customer replies use a fixed 2-3 business day promise even when an order is delayed.",
    "Keyword matching can misfile a ticket; a misfiled ticket gets the wrong canned reply.",
    "Re-running the flow on the same open tickets may send duplicate replies, since outbox.send is non-idempotent (maxAttempts 1)."
   ],
   "successCriteria": [
    "Every open shipping ticket receives exactly one shipping reply, verified by outbox.audit.",
    "Every open password ticket receives exactly one password reply, verified by outbox.audit.",
    "One summary of all other open tickets is delivered to help@cobaltcandle.com.",
    "The outbox audit passes for all recipients of this run."
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "budget": {
   "maxSteps": 1000,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_tickets",
    "kind": "task",
    "needs": [],
    "description": "Read all rows of the tickets sheet.",
    "tool": "sheet.read",
    "args": {
     "sheet": "tickets"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "open_tickets",
    "kind": "task",
    "needs": [
     "read_tickets"
    ],
    "description": "Keep only open tickets.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_tickets.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "open"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "triage",
    "kind": "task",
    "needs": [
     "open_tickets"
    ],
    "description": "Label each open ticket as shipping, password or other by keyword in subject or body. First matching rule wins.",
    "tool": "rows.route",
    "args": {
     "rows": {
      "$ref": "nodes.open_tickets.rows"
     },
     "rules": [
      {
       "field": [
        "subject",
        "body"
       ],
       "op": "contains",
       "value": "shipping",
       "set": {
        "topic": "shipping"
       }
      },
      {
       "field": [
        "subject",
        "body"
       ],
       "op": "contains",
       "value": "where is my order",
       "set": {
        "topic": "shipping"
       }
      },
      {
       "field": [
        "subject",
        "body"
       ],
       "op": "contains",
       "value": "where's my order",
       "set": {
        "topic": "shipping"
       }
      },
      {
       "field": [
        "subject",
        "body"
       ],
       "op": "contains",
       "value": "password",
       "set": {
        "topic": "password"
       }
      }
     ],
     "otherwise": {
      "topic": "other"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "shipping_rows",
    "kind": "task",
    "needs": [
     "triage"
    ],
    "description": "Shipping tickets.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.triage.rows"
     },
     "where": [
      {
       "field": "topic",
       "op": "eq",
       "value": "shipping"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "password_rows",
    "kind": "task",
    "needs": [
     "triage"
    ],
    "description": "Password tickets.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.triage.rows"
     },
     "where": [
      {
       "field": "topic",
       "op": "eq",
       "value": "password"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "other_rows",
    "kind": "task",
    "needs": [
     "triage"
    ],
    "description": "All other open tickets.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.triage.rows"
     },
     "where": [
      {
       "field": "topic",
       "op": "eq",
       "value": "other"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "send_shipping",
    "kind": "map",
    "needs": [
     "shipping_rows"
    ],
    "description": "Send the shipping reply to each shipping ticket's sender.",
    "items": {
     "$ref": "nodes.shipping_rows.rows"
    },
    "maxItems": 500,
    "concurrency": 1,
    "body": {
     "nodes": [
      {
       "id": "reply",
       "kind": "task",
       "needs": [],
       "description": "Send the shipping reply.",
       "tool": "outbox.send",
       "args": {
        "to": {
         "$ref": "item.from"
        },
        "subject": "Re: your question about your order",
        "body": "Hello,\n\nThanks for getting in touch. Orders ship within 2-3 business days. Once your order has shipped, you will receive a tracking link by email.\n\nCobalt Candle Support"
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 1
       }
      }
     ],
     "acceptance": [
      {
       "op": "eq",
       "left": {
        "$ref": "nodes.reply.delivered"
       },
       "right": true
      }
     ]
    }
   },
   {
    "id": "send_password",
    "kind": "map",
    "needs": [
     "password_rows"
    ],
    "description": "Send the password reply to each password ticket's sender.",
    "items": {
     "$ref": "nodes.password_rows.rows"
    },
    "maxItems": 500,
    "concurrency": 1,
    "body": {
     "nodes": [
      {
       "id": "reply",
       "kind": "task",
       "needs": [],
       "description": "Send the password reply.",
       "tool": "outbox.send",
       "args": {
        "to": {
         "$ref": "item.from"
        },
        "subject": "Re: your password question",
        "body": "Hello,\n\nTo reset your password, please use the 'Forgot password' link on the login page.\n\nCobalt Candle Support"
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 1
       }
      }
     ],
     "acceptance": [
      {
       "op": "eq",
       "left": {
        "$ref": "nodes.reply.delivered"
       },
       "right": true
      }
     ]
    }
   },
   {
    "id": "lines_other",
    "kind": "task",
    "needs": [
     "other_rows"
    ],
    "description": "Render one summary line per other ticket.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.other_rows.rows"
     },
     "line": "Ticket {{id}} | From: {{from}} | Subject: {{subject}} | Priority: {{priority}}\\n{{body}}\\n",
     "empty": "No other open tickets."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "send_forward",
    "kind": "task",
    "needs": [
     "lines_other"
    ],
    "description": "Forward the other open tickets to help@cobaltcandle.com in one message.",
    "tool": "outbox.send",
    "args": {
     "to": "help@cobaltcandle.com",
     "subject": "Support tickets needing a person",
     "body": {
      "$ref": "nodes.lines_other.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "pluck_shipping",
    "kind": "task",
    "needs": [
     "shipping_rows"
    ],
    "description": "Recipients of shipping replies.",
    "tool": "core.pluck",
    "args": {
     "items": {
      "$ref": "nodes.shipping_rows.rows"
     },
     "field": "from"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "pluck_password",
    "kind": "task",
    "needs": [
     "password_rows"
    ],
    "description": "Recipients of password replies.",
    "tool": "core.pluck",
    "args": {
     "items": {
      "$ref": "nodes.password_rows.rows"
     },
     "field": "from"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "audit_sends",
    "kind": "verify",
    "needs": [
     "send_shipping",
     "send_password",
     "send_forward",
     "pluck_shipping",
     "pluck_password"
    ],
    "description": "Independently re-read the outbox and confirm every expected recipient received exactly the messages this run sent.",
    "method": "capability",
    "tool": "outbox.audit",
    "args": {
     "to": [
      {
       "$ref": "nodes.pluck_shipping.items"
      },
      {
       "$ref": "nodes.pluck_password.items"
      },
      [
       "help@cobaltcandle.com"
      ]
     ]
    },
    "subject": {
     "$ref": "nodes.send_forward"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
