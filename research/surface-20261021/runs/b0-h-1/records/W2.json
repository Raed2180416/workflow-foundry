 "workflow": {
  "schemaVersion": "1.0",
  "id": "mobile-squad-weekly-status",
  "version": 1,
  "title": "Mobile squad weekly status",
  "goal": "Read the tracker, summarise the Mobile squad's finished, open and blocked work items, and e-mail the status to tom@ortega-apps.co, then verify the message was delivered.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The tracker sheet contains only Mobile squad work items (the sheet has no squad field).",
    "Recipient is tom@ortega-apps.co as given in the request.",
    "Each outbound send is confirmed by a person before dispatch when the flow runs live."
   ],
   "risks": [
    "Tracker rows without an owner show an empty owner.",
    "If the tracker includes other squads' items, the report will include them.",
    "The e-mail is sent only once; a failed send is not retried automatically."
   ],
   "successCriteria": [
    "The e-mail lists every done, open and blocked tracker item by title.",
    "The message is delivered to tom@ortega-apps.co and the outbox audit passes."
   ]
  },
  "budget": {
   "maxSteps": 20,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "nodes": [
   {
    "id": "read_tracker",
    "kind": "task",
    "needs": [],
    "description": "Read all tracker work items.",
    "tool": "sheet.read",
    "args": {
     "sheet": "tracker"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "select_fields",
    "kind": "task",
    "needs": [
     "read_tracker"
    ],
    "description": "Keep title, status and owner of each item.",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.read_tracker.rows"
     },
     "fields": [
      "title",
      "status",
      "owner"
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "tally",
    "kind": "task",
    "needs": [
     "select_fields"
    ],
    "description": "Count done, open and blocked items and list the done ones.",
    "tool": "report.tally",
    "args": {
     "items": {
      "$ref": "nodes.select_fields.rows"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "open_items",
    "kind": "task",
    "needs": [
     "select_fields"
    ],
    "description": "Keep the open items.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.select_fields.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "open"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "blocked_items",
    "kind": "task",
    "needs": [
     "select_fields"
    ],
    "description": "Keep the blocked items.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.select_fields.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "blocked"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "open_lines",
    "kind": "task",
    "needs": [
     "open_items"
    ],
    "description": "Render open items as lines.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.open_items.rows"
     },
     "line": "- {{title}} ({{owner}})",
     "empty": "None"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "blocked_lines",
    "kind": "task",
    "needs": [
     "blocked_items"
    ],
    "description": "Render blocked items as lines.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.blocked_items.rows"
     },
     "line": "- {{title}} ({{owner}})",
     "empty": "None"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "compose",
    "kind": "task",
    "needs": [
     "tally",
     "open_lines",
     "blocked_lines"
    ],
    "description": "Fill the status report text.",
    "tool": "core.template",
    "args": {
     "text": "Mobile squad weekly status ({{now}})\n\nDone ({{done}}):\n{{doneLines}}\n\nStill open ({{open}}):\n{{openLines}}\n\nBlocked ({{blocked}}):\n{{blockedLines}}",
     "variables": {
      "now": {
       "$ref": "input.now"
      },
      "done": {
       "$ref": "nodes.tally.done"
      },
      "open": {
       "$ref": "nodes.tally.open"
      },
      "blocked": {
       "$ref": "nodes.tally.blocked"
      },
      "doneLines": {
       "$ref": "nodes.tally.doneLines"
      },
      "openLines": {
       "$ref": "nodes.open_lines.text"
      },
      "blockedLines": {
       "$ref": "nodes.blocked_lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "send_status",
    "kind": "task",
    "needs": [
     "compose"
    ],
    "description": "E-mail the status report to tom@ortega-apps.co (asks a person before dispatch).",
    "tool": "outbox.send",
    "args": {
     "to": "tom@ortega-apps.co",
     "subject": "Mobile squad weekly status",
     "body": {
      "$ref": "nodes.compose.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "verify_sent",
    "kind": "verify",
    "needs": [
     "send_status"
    ],
    "description": "Re-read the outbox and confirm the report reached tom@ortega-apps.co unchanged.",
    "method": "capability",
    "tool": "outbox.audit",
    "args": {
     "to": [
      [
       "tom@ortega-apps.co"
      ]
     ]
    },
    "subject": {
     "$ref": "nodes.send_status"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.send_status.delivered"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.verify_sent.pass"
    },
    "right": true
   }
  ],
  "metadata": {
