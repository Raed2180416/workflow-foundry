 "workflow": {
  "schemaVersion": "1.0",
  "id": "route-leads-by-country",
  "version": 1,
  "title": "Route new leads to country owners",
  "goal": "Read the leads sheet, skip spam, assign Germany and Austria leads to Lena, France leads to Paul, and all other leads to me; append each routed lead to lead-log and verify the appended rows.",
  "domain": "general",
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "envelope": {
   "assumptions": [
    "Country values are written as country names (Germany, Austria, France) or common codes (DE, AT, FR); any other spelling falls through to 'me'.",
    "Leads with status 'spam' are not routed; all other leads are routed, including already contacted ones.",
    "'Anyone else -> me' is recorded as assignTo 'me'.",
    "assignedAt is the run input time."
   ],
   "risks": [
    "A country spelled differently from the listed values is assigned to 'me' rather than the country owner.",
    "Routing is re-run over the whole leads sheet, so leads already in lead-log may get a second routed row."
   ],
   "successCriteria": [
    "Every non-spam lead in the leads sheet gets exactly one lead-log row.",
    "Germany/Austria leads go to Lena, France leads to Paul, all others to me.",
    "The audit of lead-log confirms the rows appended by this run."
   ]
  },
  "budget": {
   "maxSteps": 1000,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_leads",
    "kind": "task",
    "needs": [],
    "description": "Read every row of the leads sheet.",
    "tool": "sheet.read",
    "args": {
     "sheet": "leads"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "active_leads",
    "kind": "task",
    "needs": [
     "read_leads"
    ],
    "description": "Drop leads marked as spam.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_leads.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "ne",
       "value": "spam"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "route_leads",
    "kind": "task",
    "needs": [
     "active_leads"
    ],
    "description": "Label each lead with its owner by country; Germany/Austria to Lena, France to Paul, everything else to me.",
    "tool": "rows.route",
    "args": {
     "rows": {
      "$ref": "nodes.active_leads.rows"
     },
     "rules": [
      {
       "field": "country",
       "op": "in",
       "value": [
        "Germany",
        "Deutschland",
        "DE",
        "Austria",
        "Österreich",
        "AT"
       ],
       "set": {
        "assignTo": "Lena"
       }
      },
      {
       "field": "country",
       "op": "in",
       "value": [
        "France",
        "FR"
       ],
       "set": {
        "assignTo": "Paul"
       }
      }
     ],
     "otherwise": {
      "assignTo": "me"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "append_leads",
    "kind": "map",
    "needs": [
     "route_leads"
    ],
    "description": "Append one lead-log row per routed lead.",
    "items": {
     "$ref": "nodes.route_leads.rows"
    },
    "maxItems": 500,
    "concurrency": 1,
    "body": {
     "nodes": [
      {
       "id": "append_one",
       "kind": "task",
       "needs": [],
       "description": "Append this lead's routing row to lead-log.",
       "tool": "sheet.append",
       "args": {
        "sheet": "lead-log",
        "rows": [
         {
          "name": {
           "$ref": "item.name"
          },
          "email": {
           "$ref": "item.email"
          },
          "company": {
           "$ref": "item.company"
          },
          "assignTo": {
           "$ref": "item.assignTo"
          },
          "assignedAt": {
           "$ref": "input.now"
          }
         }
        ]
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 2
       }
      }
     ],
     "acceptance": [
      {
       "op": "eq",
       "left": {
        "$ref": "nodes.append_one.appended"
       },
       "right": 1
      }
     ]
    }
   },
   {
    "id": "verify_log",
    "kind": "verify",
    "needs": [
     "append_leads"
    ],
    "description": "Independently re-read lead-log and confirm this run's rows are present as written.",
    "method": "capability",
    "tool": "sheet.audit",
    "args": {
     "sheet": "lead-log",
     "rows": {
      "$ref": "nodes.route_leads.count"
     }
    },
    "subject": {
     "$ref": "nodes.append_leads"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.verify_log.pass"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.append_leads.count"
    },
    "right": {
     "$ref": "nodes.route_leads.count"
    }
   }
  ]
 },
