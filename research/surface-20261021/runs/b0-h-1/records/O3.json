 "workflow": {
  "schemaVersion": "1.0",
  "id": "daily-alerts-digest",
  "version": 1,
  "title": "Daily monitoring alerts digest to #eng-alerts",
  "goal": "Each day, read the alerts sheet, keep the unresolved alerts, and post a digest of them to the #eng-alerts team channel, then verify the post was recorded.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "A digest covers alerts with resolved = false (all unresolved alerts, regardless of age).",
    "The channel is #eng-alerts.",
    "The run input 'now' is the digest date."
   ],
   "risks": [
    "Posting to chat is an outside action; a person is asked before each post when the flow runs live.",
    "If the alerts sheet is missing, the run fails rather than posting an empty digest."
   ],
   "successCriteria": [
    "The digest lists every unresolved alert from the alerts sheet.",
    "The chat post is delivered once and the audit confirms it in #eng-alerts."
   ]
  },
  "budget": {
   "maxSteps": 8,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "nodes": [
   {
    "id": "alerts",
    "kind": "task",
    "needs": [],
    "description": "Read every row of the alerts sheet.",
    "tool": "sheet.read",
    "args": {
     "sheet": "alerts"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "open",
    "kind": "task",
    "needs": [
     "alerts"
    ],
    "description": "Keep only unresolved alerts.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.alerts.rows"
     },
     "where": [
      {
       "field": "resolved",
       "op": "eq",
       "value": false
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "lines",
    "kind": "task",
    "needs": [
     "open"
    ],
    "description": "Render one line per unresolved alert.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.open.rows"
     },
     "line": "- [{{severity}}] {{service}}: {{message}} (id {{id}}, at {{at}})",
     "empty": "No unresolved alerts."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "digest",
    "kind": "task",
    "needs": [
     "lines",
     "open"
    ],
    "description": "Build the digest text with the date and count.",
    "tool": "core.template",
    "args": {
     "text": "Monitoring alerts digest for {{date}}: {{count}} unresolved\n{{lines}}",
     "variables": {
      "date": {
       "$ref": "input.now"
      },
      "count": {
       "$ref": "nodes.open.count"
      },
      "lines": {
       "$ref": "nodes.lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "post",
    "kind": "task",
    "needs": [
     "digest"
    ],
    "description": "Post the digest to #eng-alerts.",
    "tool": "chat.post",
    "args": {
     "channel": "#eng-alerts",
     "text": {
      "$ref": "nodes.digest.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "verify",
    "kind": "verify",
    "needs": [
     "post"
    ],
    "description": "Independently confirm the digest post is in #eng-alerts.",
    "method": "capability",
    "tool": "chat.audit",
    "args": {
     "channel": "#eng-alerts",
     "posts": 1
    },
    "subject": {
     "$ref": "nodes.post"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.verify.pass"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.post.posted"
    },
    "right": true
   }
  ]
 },
