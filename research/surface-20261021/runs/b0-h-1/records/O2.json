 "workflow": {
  "schemaVersion": "1.0",
  "id": "overnight-critical-alerts",
  "version": 1,
  "title": "Post overnight critical alerts to #oncall and page pager for unacknowledged ones",
  "goal": "Read the alerts sheet, keep critical alerts from the last 12 hours, post them to #oncall, and email pager@fennec.dev when any of those critical alerts has not been acknowledged.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The alerts sheet has ISO date-time 'at' values with an offset and boolean 'acknowledged' values.",
    "The run input 'now' is the current time.",
    "The #oncall channel name is '#oncall'."
   ],
   "risks": [
    "chat.post and outbox.send ask a person before each live dispatch.",
    "Paging is only sent when at least one critical alert in the window is unacknowledged."
   ],
   "successCriteria": [
    "Every critical alert from the last 12 hours is listed in the #oncall post.",
    "pager@fennec.dev is emailed exactly when unacknowledged critical alerts exist in the window.",
    "The #oncall post is confirmed by an independent chat.audit check."
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "budget": {
   "maxSteps": 20,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_alerts",
    "kind": "task",
    "needs": [],
    "description": "Read all alert rows.",
    "tool": "sheet.read",
    "args": {
     "sheet": "alerts"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "age",
    "kind": "task",
    "needs": [
     "read_alerts"
    ],
    "description": "Add hours elapsed since each alert's time.",
    "tool": "rows.age",
    "args": {
     "rows": {
      "$ref": "nodes.read_alerts.rows"
     },
     "field": "at",
     "now": {
      "$ref": "input.now"
     },
     "unit": "hours",
     "as": "hoursAgo"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "overnight",
    "kind": "task",
    "needs": [
     "age"
    ],
    "description": "Keep critical alerts from the last 12 hours.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.age.rows"
     },
     "where": [
      {
       "field": "severity",
       "op": "eq",
       "value": "critical"
      },
      {
       "field": "hoursAgo",
       "op": "gte",
       "value": 0
      },
      {
       "field": "hoursAgo",
       "op": "lte",
       "value": 12
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "overnight_lines",
    "kind": "task",
    "needs": [
     "overnight"
    ],
    "description": "Render one line per overnight critical alert.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.overnight.rows"
     },
     "line": "{{service}} | {{at}} | {{message}} | acknowledged: {{acknowledged}}",
     "empty": "No critical alerts overnight."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "post_text",
    "kind": "task",
    "needs": [
     "overnight_lines"
    ],
    "description": "Build the #oncall message.",
    "tool": "core.template",
    "args": {
     "text": "Overnight critical alerts (last 12h):\n{{lines}}",
     "variables": {
      "lines": {
       "$ref": "nodes.overnight_lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "post_oncall",
    "kind": "task",
    "needs": [
     "post_text"
    ],
    "description": "Post the overnight critical alerts to #oncall.",
    "tool": "chat.post",
    "args": {
     "channel": "#oncall",
     "text": {
      "$ref": "nodes.post_text.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "verify_post",
    "kind": "verify",
    "needs": [
     "post_oncall"
    ],
    "description": "Independently confirm the #oncall post was left in the channel.",
    "method": "capability",
    "tool": "chat.audit",
    "args": {
     "channel": "#oncall",
     "posts": 1
    },
    "subject": {
     "$ref": "nodes.post_oncall"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   },
   {
    "id": "unacked",
    "kind": "task",
    "needs": [
     "overnight"
    ],
    "description": "Keep overnight critical alerts not yet acknowledged.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.overnight.rows"
     },
     "where": [
      {
       "field": "acknowledged",
       "op": "eq",
       "value": false
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "unacked_lines",
    "kind": "task",
    "needs": [
     "unacked"
    ],
    "description": "Render one line per unacknowledged critical alert.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.unacked.rows"
     },
     "line": "{{service}} | {{at}} | {{message}}",
     "empty": "No unacknowledged critical alerts."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "page_text",
    "kind": "task",
    "needs": [
     "unacked_lines"
    ],
    "description": "Build the pager email body.",
    "tool": "core.template",
    "args": {
     "text": "Unacknowledged CRITICAL alerts from the last 12 hours. Please acknowledge:\n{{lines}}",
     "variables": {
      "lines": {
       "$ref": "nodes.unacked_lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "page_pager",
    "kind": "task",
    "needs": [
     "unacked",
     "page_text"
    ],
    "description": "Email pager@fennec.dev when unacknowledged critical alerts exist.",
    "when": {
     "op": "gt",
     "left": {
      "$ref": "nodes.unacked.count"
     },
     "right": 0
    },
    "tool": "outbox.send",
    "args": {
     "to": "pager@fennec.dev",
     "subject": "CRITICAL unacknowledged alert - please respond",
     "body": {
      "$ref": "nodes.page_text.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.verify_post.pass"
    },
    "right": true
   },
   {
    "op": "any",
    "conditions": [
     {
      "op": "eq",
      "left": {
       "$ref": "nodes.unacked.count"
      },
      "right": 0
     },
     {
      "op": "all",
      "conditions": [
       {
        "op": "exists",
        "value": {
         "$ref": "nodes.page_pager.delivered"
        }
       },
       {
        "op": "eq",
        "left": {
         "$ref": "nodes.page_pager.delivered"
        },
        "right": true
       }
      ]
     }
    ]
   }
  ]
 },
