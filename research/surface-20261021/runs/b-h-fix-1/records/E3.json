 "workflow": {
  "schemaVersion": "1.0",
  "id": "expense-approval",
  "version": 1,
  "title": "Expense approvals",
  "goal": "Each run, approve automatically the submitted claims up to 75, record every decision, and e-mail beth@gladwell-law.com the claims that need a decision, after a person approves the send.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The expenses sheet holds one row per claim with id, employee, email, amount, category, description, receipt and status",
    "Delivery is a local outbox file standing in for e-mail; nothing leaves this machine"
   ],
   "risks": [
    "Approving spending over the limit",
    "A claim nobody decides on"
   ],
   "successCriteria": [
    "Every approval is within the limit (and has a receipt when required)",
    "Every submitted claim is recorded with its decision",
    "The approver received the claims that need a decision",
    "This run delivered exactly the planned e-mails and rows (checked by re-reading them)"
   ],
   "unsupported": [
    "Payments",
    "Several approvers",
    "Running on a schedule by itself"
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string",
     "minLength": 10,
     "maxLength": 40
    }
   }
  },
  "budget": {
   "maxSteps": 3000,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read",
    "kind": "task",
    "needs": [],
    "description": "Read the expenses sheet",
    "tool": "sheet.read",
    "args": {
     "sheet": "expenses"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "submitted",
    "kind": "task",
    "needs": [
     "read"
    ],
    "description": "Keep the submitted claims",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "submitted"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "decided",
    "kind": "task",
    "needs": [
     "submitted"
    ],
    "description": "Decide each claim: approved within the limit, otherwise waiting for the approver",
    "tool": "rows.route",
    "args": {
     "rows": {
      "$ref": "nodes.submitted.rows"
     },
     "rules": [
      {
       "field": "amount",
       "op": "lte",
       "value": 75,
       "set": {
        "decision": "approved",
        "reason": "within the limit"
       }
      }
     ],
     "otherwise": {
      "decision": "waiting for approver",
      "reason": "over the limit"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "approved",
    "kind": "task",
    "needs": [
     "decided"
    ],
    "description": "The claims approved automatically",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.decided.rows"
     },
     "where": [
      {
       "field": "decision",
       "op": "eq",
       "value": "approved"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "waiting",
    "kind": "task",
    "needs": [
     "decided"
    ],
    "description": "The claims that need the approver",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.decided.rows"
     },
     "where": [
      {
       "field": "decision",
       "op": "eq",
       "value": "waiting for approver"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "withinLimit",
    "kind": "task",
    "needs": [
     "approved"
    ],
    "description": "Recheck the approvals against the limit a second way (used by a check)",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.approved.rows"
     },
     "where": [
      {
       "field": "amount",
       "op": "lte",
       "value": 75
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "recordRows",
    "kind": "task",
    "needs": [
     "decided"
    ],
    "description": "Prepare the decision rows",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.decided.rows"
     },
     "fields": [
      "id",
      "employee",
      "amount",
      "decision",
      "reason"
     ],
     "set": {
      "at": {
       "$ref": "input.now"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "record",
    "kind": "task",
    "needs": [
     "recordRows",
     "withinLimit"
    ],
    "description": "Record every decision in the expense-decisions sheet",
    "tool": "sheet.append",
    "args": {
     "sheet": "expense-decisions",
     "rows": {
      "$ref": "nodes.recordRows.rows"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "waitingLines",
    "kind": "task",
    "needs": [
     "waiting"
    ],
    "description": "List the claims for the approver",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.waiting.rows"
     },
     "line": "- {{id}} {{employee}}: {{amount}} for {{description}} ({{category}}; {{reason}})",
     "empty": "- nothing today"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "approvedLines",
    "kind": "task",
    "needs": [
     "approved"
    ],
    "description": "List the claims approved automatically",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.approved.rows"
     },
     "line": "- {{id}} {{employee}}: {{amount}} for {{description}}",
     "empty": "- none"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "message",
    "kind": "task",
    "needs": [
     "waitingLines",
     "approvedLines"
    ],
    "description": "Write the e-mail to the approver",
    "tool": "core.template",
    "args": {
     "text": "Expense claims waiting for your decision ({{n}}):\n{{waiting}}\n\nApproved automatically (up to 75) ({{m}}):\n{{approved}}\n\nReply to approve or reject the waiting ones. This flow never pays anything.",
     "variables": {
      "n": {
       "$ref": "nodes.waitingLines.count"
      },
      "waiting": {
       "$ref": "nodes.waitingLines.text"
      },
      "m": {
       "$ref": "nodes.approvedLines.count"
      },
      "approved": {
       "$ref": "nodes.approvedLines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "subject",
    "kind": "task",
    "needs": [
     "waitingLines"
    ],
    "description": "Write the subject line",
    "tool": "core.template",
    "args": {
     "text": "Expenses: {{n}} waiting for your approval",
     "variables": {
      "n": {
       "$ref": "nodes.waitingLines.count"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "sendApprover",
    "kind": "task",
    "needs": [
     "message",
     "subject",
     "record"
    ],
    "description": "E-mail beth@gladwell-law.com the claims that need a decision (asks you first)",
    "tool": "outbox.send",
    "args": {
     "to": "beth@gladwell-law.com",
     "subject": {
      "$ref": "nodes.subject.text"
     },
     "body": {
      "$ref": "nodes.message.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "audit",
    "kind": "verify",
    "needs": [
     "sendApprover"
    ],
    "description": "Re-read the outbox: exactly the planned e-mails went out, each intact",
    "method": "capability",
    "tool": "outbox.audit",
    "args": {
     "to": [
      "beth@gladwell-law.com",
      []
     ]
    },
    "subject": {
     "$ref": "nodes.sendApprover"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   },
   {
    "id": "sheetAudit",
    "kind": "verify",
    "needs": [
     "record",
     "decided"
    ],
    "description": "Re-read the decisions sheet: one row per submitted claim",
    "method": "capability",
    "tool": "sheet.audit",
    "args": {
     "sheet": "expense-decisions",
     "rows": {
      "$ref": "nodes.decided.count"
     }
    },
    "subject": {
     "$ref": "nodes.record"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
