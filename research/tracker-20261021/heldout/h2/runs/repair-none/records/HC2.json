 "workflow": {
  "schemaVersion": "1.0",
  "id": "newsletter-sync-crm",
  "version": 2,
  "title": "Add missing subscribed CRM contacts to newsletter and report",
  "goal": "Add every subscribed contact from the crm sheet that is not already on the newsletter list, skip unsubscribed contacts, and e-mail janet@happytailsbakery.com a report of who was added.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The crm and newsletter sheets exist in the workspace and use email as the key.",
    "Contacts are matched by email, ignoring case and spaces.",
    "Newly added newsletter rows get source 'crm sheet'; addedAt is left empty because rows.select cannot take the run time as a constant reference.",
    "The report recipient is janet@happytailsbakery.com."
   ],
   "risks": [
    "Sending the report is an outside action and asks a person before dispatch.",
    "If the newsletter sheet is missing, the read fails and nothing is added.",
    "If the crm sheet lists the same unsubscribed-free email twice and it is missing from the newsletter, it may be appended twice.",
    "addedAt is blank on newly appended newsletter rows."
   ],
   "successCriteria": [
    "Every subscribed crm contact missing from the newsletter is appended to the newsletter sheet.",
    "Unsubscribed crm contacts are never appended.",
    "The number of appended rows equals the number of contacts found missing.",
    "The appended rows are confirmed by sheet.audit.",
    "The report is delivered to janet@happytailsbakery.com and confirmed by outbox.check."
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "budget": {
   "maxSteps": 20,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_crm",
    "kind": "task",
    "needs": [],
    "description": "Read the customer sheet.",
    "tool": "sheet.read",
    "args": {
     "sheet": "crm"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "read_newsletter",
    "kind": "task",
    "needs": [],
    "description": "Read the current mailing list.",
    "tool": "sheet.read",
    "args": {
     "sheet": "newsletter"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "subscribed",
    "kind": "task",
    "needs": [
     "read_crm"
    ],
    "description": "Keep contacts that are not unsubscribed.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_crm.rows"
     },
     "where": [
      {
       "field": "unsubscribed",
       "op": "ne",
       "value": true
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "recon",
    "kind": "task",
    "needs": [
     "subscribed",
     "read_newsletter"
    ],
    "description": "Find subscribed contacts whose e-mail is not on the mailing list.",
    "tool": "rows.reconcile",
    "args": {
     "left": {
      "$ref": "nodes.subscribed.rows"
     },
     "right": {
      "$ref": "nodes.read_newsletter.rows"
     },
     "key": "email"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "new_rows",
    "kind": "task",
    "needs": [
     "recon"
    ],
    "description": "Shape the missing contacts as mailing list rows.",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.recon.missing"
     },
     "fields": [
      "email",
      "name"
     ],
     "set": {
      "source": "crm sheet"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "append_contacts",
    "kind": "task",
    "needs": [
     "new_rows"
    ],
    "description": "Append the missing contacts to the newsletter sheet.",
    "tool": "sheet.append",
    "args": {
     "sheet": "newsletter",
     "rows": {
      "$ref": "nodes.new_rows.rows"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "count_added",
    "kind": "task",
    "needs": [
     "recon"
    ],
    "description": "Count the added contacts.",
    "tool": "core.aggregate",
    "args": {
     "operation": "count",
     "values": {
      "$ref": "nodes.recon.missing"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "verify_append",
    "kind": "verify",
    "needs": [
     "append_contacts",
     "count_added"
    ],
    "description": "Confirm the appended rows are in the newsletter sheet.",
    "method": "capability",
    "tool": "sheet.audit",
    "args": {
     "sheet": "newsletter",
     "rows": {
      "$ref": "nodes.count_added.value"
     }
    },
    "subject": {
     "$ref": "nodes.append_contacts"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   },
   {
    "id": "report_lines",
    "kind": "task",
    "needs": [
     "recon"
    ],
    "description": "Render one line per added contact.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.recon.missing"
     },
     "line": "- {{name}} <{{email}}>",
     "empty": "No new contacts were added."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "report_text",
    "kind": "task",
    "needs": [
     "report_lines",
     "count_added"
    ],
    "description": "Build the report body.",
    "tool": "core.template",
    "args": {
     "text": "Newsletter sync on {{date}}: {{count}} contact(s) added from the crm sheet. Unsubscribed contacts were skipped.\n\n{{lines}}",
     "variables": {
      "date": {
       "$ref": "input.now"
      },
      "count": {
       "$ref": "nodes.count_added.value"
      },
      "lines": {
       "$ref": "nodes.report_lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "send_report",
    "kind": "task",
    "needs": [
     "report_text",
     "verify_append"
    ],
    "description": "E-mail the report to Janet.",
    "tool": "outbox.send",
    "args": {
     "to": "janet@happytailsbakery.com",
     "subject": "Newsletter sync: contacts added",
     "body": {
      "$ref": "nodes.report_text.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "verify_report",
    "kind": "verify",
    "needs": [
     "send_report"
    ],
    "description": "Re-read the delivered report and compare its hash.",
    "method": "capability",
    "tool": "outbox.check",
    "args": {
     "messageId": {
      "$ref": "nodes.send_report.messageId"
     },
     "sha256": {
      "$ref": "nodes.send_report.sha256"
     }
    },
    "subject": {
     "$ref": "nodes.send_report"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.verify_append.pass"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.append_contacts.appended"
    },
    "right": {
     "$ref": "nodes.count_added.value"
    }
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.send_report.delivered"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.verify_report.pass"
    },
    "right": true
   }
  ],
  "metadata": {
   "rationale": "Filter out unsubscribed rows, reconcile by email, append only the missing subscribed contacts, then report the added names to Janet and verify both the append and the sent message.",
   "tags": [
    "newsletter",
    "crm",
    "report"
   ]
  }
 },
