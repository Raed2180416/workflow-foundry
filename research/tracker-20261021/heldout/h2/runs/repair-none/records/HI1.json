    ],
    "description": "Compute full days past due from the due date.",
    "tool": "rows.age",
    "args": {
     "rows": {
      "$ref": "nodes.open-invoices.rows"
     },
     "field": "due",
     "now": {
      "$ref": "input.now"
     },
