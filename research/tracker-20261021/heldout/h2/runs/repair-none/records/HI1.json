 "workflow": {
  "schemaVersion": "1.0",
  "id": "invoice-overdue-reminders",
  "version": 2,
  "title": "Overdue invoice reminders (once per tier) and Monday summary",
  "goal": "Read open invoices, skip disputed and paid ones, and send one polite reminder at 30-59 days past due, one firmer reminder at 60-89 days, and one final reminder at 90+ days. Each invoice/tier pair is emailed only once, tracked in the reminder-log sheet. Then email maria@pixelandpixel.com a summary of all open, non-disputed invoices.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The flow is scheduled to run on Mondays and supplies input.now; every run sends the summary.",
    "The sheet reminder-log exists (it may be empty, with columns invoice, customer, email, tier) before the first run.",
    "Days past due are full days between the invoice due date and input.now.",
    "Reminder bands: 30-59 days polite, 60-89 days firm, 90+ days final. An invoice receives each tier's reminder at most once.",
    "Only invoices with status 'open' are reminded; 'disputed' and 'paid' are never sent to.",
    "Summary recipient is maria@pixelandpixel.com."
   ],
   "risks": [
    "If reminder-log is missing, the flow fails at its first read and sends nothing.",
    "Each send asks a person for approval first.",
    "A client with several overdue invoices receives one email per invoice."
   ],
   "successCriteria": [
    "Only open invoices are reminded; disputed invoices receive no message.",
    "Each client receives the reminder matching its days-past-due band, at most once per invoice and tier.",
    "Every reminder sent in this run is recorded in reminder-log.",
    "The summary is delivered to maria@pixelandpixel.com.",
    "Outbox audit confirms every recipient and message hash for this run."
   ]
  },
  "budget": {
   "maxSteps": 3000,
   "maxConcurrency": 2,
   "maxDurationMs": 1800000,
   "maxCost": 0
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "nodes": [
