    ],
    "description": "Keep only open invoices (excludes disputed and paid).",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read-invoices.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "open"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "aged",
    "kind": "task",
    "needs": [
