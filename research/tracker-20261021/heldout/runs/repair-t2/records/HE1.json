 "workflow": {
  "schemaVersion": "1.0",
  "id": "expense-auto-approve",
  "version": 2,
  "title": "Auto-approve small expense claims with receipts; route the rest to Dana by decision row and e-mail",
  "goal": "Read submitted expense claims. Claims under $50 with a receipt are logged as approved. Claims of $50 or more, and claims without a receipt, are logged as waiting for approver in expense-decisions and e-mailed to dana@brightleafmarketing.com with the list of claims.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "Amounts are numeric in one currency (USD assumed) and the receipt field is boolean.",
    "Only claims with status 'submitted' are processed.",
    "Dana is notified by one e-mail per routed group (amount 50 or more; no receipt under 50), sent through outbox.send only when that group is non-empty."
   ],
   "risks": [
    "The expenses sheet status is not changed to approved (the flow only appends to expense-decisions), so the same claim could be reprocessed on a later run; the append step is idempotent per step, not per claim.",
    "Claims with a missing or non-numeric amount are not routed by any branch and are left out of the decision log and the e-mails.",
    "Each e-mail send is non-idempotent and asks a person before dispatch when live; a retry could duplicate it, so sends are capped at one attempt."
   ],
   "successCriteria": [
    "Every submitted claim with amount under 50 and receipt true has an 'approved' decision row.",
    "Every submitted claim with amount 50 or more, or receipt false, has a 'waiting for approver' decision row naming dana@brightleafmarketing.com.",
    "An e-mail naming dana@brightleafmarketing.com is delivered for each non-empty routed group and confirmed by outbox.audit.",
    "Each append is confirmed by sheet.audit."
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "budget": {
   "maxSteps": 30,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_expenses",
    "kind": "task",
    "needs": [],
    "description": "Read all expense claims.",
    "tool": "sheet.read",
    "args": {
     "sheet": "expenses"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "submitted",
    "kind": "task",
    "needs": [
     "read_expenses"
    ],
    "description": "Keep only submitted claims.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_expenses.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "submitted"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "approved_claims",
    "kind": "task",
    "needs": [
     "submitted"
    ],
    "description": "Submitted claims under 50 with a receipt.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.submitted.rows"
     },
     "where": [
      {
       "field": "amount",
       "op": "lt",
       "value": 50
      },
      {
       "field": "receipt",
       "op": "eq",
       "value": true
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "over_limit_claims",
    "kind": "task",
    "needs": [
     "submitted"
    ],
    "description": "Submitted claims of 50 or more.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.submitted.rows"
     },
     "where": [
      {
       "field": "amount",
       "op": "gte",
       "value": 50
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "no_receipt_claims",
    "kind": "task",
    "needs": [
     "submitted"
    ],
    "description": "Submitted claims under 50 without a receipt.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.submitted.rows"
     },
     "where": [
      {
       "field": "amount",
       "op": "lt",
       "value": 50
      },
      {
       "field": "receipt",
       "op": "eq",
       "value": false
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
