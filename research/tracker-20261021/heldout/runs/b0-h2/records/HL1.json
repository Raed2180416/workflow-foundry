      "$ref": "nodes.other_leads.rows"
     },
     "fields": [
      "name",
      "email",
      "company"
     ],
     "set": {
      "assignTo": "Priya",
      "assignedAt": {
       "$ref": "input.now"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "priya_rows_b",
    "kind": "task",
    "needs": [
     "big_leads"
    ],
    "description": "Log rows for Priya (over 200 employees).",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.big_leads.rows"
     },
     "fields": [
      "name",
      "email",
      "company"
     ],
     "set": {
      "assignTo": "Priya",
      "assignedAt": {
       "$ref": "input.now"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "append_marcus",
    "kind": "task",
    "needs": [
     "marcus_rows"
    ],
    "description": "Append Marcus assignments to lead-log.",
    "tool": "sheet.append",
    "args": {
     "sheet": "lead-log",
     "rows": {
      "$ref": "nodes.marcus_rows.rows"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
