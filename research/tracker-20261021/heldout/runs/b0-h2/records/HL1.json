 "workflow": {
  "schemaVersion": "1.0",
  "id": "lead-routing",
  "version": 1,
  "title": "Route new website leads and log assignments",
  "goal": "Read new website leads, assign California leads to Marcus, assign other leads with 200 or fewer employees to Priya, also assign leads with more than 200 employees to Priya, and append one lead-log row per assignment.",
  "domain": "sales",
  "envelope": {
   "assumptions": [
    "'send to' means record the assignment in lead-log; no outbound e-mail or chat is sent.",
    "California is identified by region equal to 'California' or 'CA' (case-insensitive).",
    "Leads with status 'new' are the only ones routed.",
    "A lead over 200 employees in California gets two log rows: one for Marcus and one for Priya."
   ],
   "risks": [
    "Region values spelled differently (e.g. 'Calif.') will not match and will go to Priya.",
    "Leads with a missing companySize are not routed to the non-California Priya branch."
   ],
   "successCriteria": [
    "Every new lead is logged to lead-log for the correct assignee.",
    "The lead-log rows written by this run pass the independent sheet audit."
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "budget": {
   "maxSteps": 50,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_leads",
    "kind": "task",
    "needs": [],
    "description": "Read all leads.",
    "tool": "sheet.read",
    "args": {
     "sheet": "leads"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "new_leads",
    "kind": "task",
    "needs": [
     "read_leads"
    ],
    "description": "Keep only new leads.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_leads.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "new"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "ca_leads",
    "kind": "task",
    "needs": [
     "new_leads"
    ],
    "description": "New leads in California.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.new_leads.rows"
     },
     "where": [
      {
       "field": "region",
       "op": "in",
       "value": [
        "California",
        "CA"
       ]
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "other_leads",
    "kind": "task",
    "needs": [
     "new_leads"
    ],
    "description": "New leads outside California with 200 or fewer employees.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.new_leads.rows"
     },
     "where": [
      {
       "field": "region",
       "op": "not_in",
       "value": [
        "California",
        "CA"
       ]
      },
      {
       "field": "companySize",
       "op": "lte",
       "value": 200
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "big_leads",
    "kind": "task",
    "needs": [
     "new_leads"
    ],
    "description": "New leads with more than 200 employees.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.new_leads.rows"
     },
     "where": [
      {
       "field": "companySize",
       "op": "gt",
       "value": 200
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "marcus_rows",
    "kind": "task",
    "needs": [
     "ca_leads"
    ],
    "description": "Log rows for Marcus.",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.ca_leads.rows"
     },
     "fields": [
      "name",
      "email",
      "company"
     ],
     "set": {
      "assignTo": "Marcus",
      "assignedAt": {
       "$ref": "input.now"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "priya_rows_a",
    "kind": "task",
    "needs": [
     "other_leads"
    ],
    "description": "Log rows for Priya (non-California, 200 or fewer).",
