 "workflow": {
  "schemaVersion": "1.0",
  "id": "invoice-overdue-reminders",
  "version": 1,
  "title": "Overdue invoice reminders and Monday summary",
  "goal": "Read open invoices, skip disputed ones, and send a polite reminder at 30-59 days past due, a firmer one at 60-89 days, and a final one at 90+ days. Then email maria@pixelandpixel.com a summary of who still owes. Nothing is sent to clients with disputed invoices.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The flow is scheduled to run on Mondays and supplies input.now; no weekday check is available, so every run sends the summary.",
    "Days past due are computed from the invoice due date against input.now (full days).",
    "Reminder bands: 30-59 days polite, 60-89 days firm, 90+ days final.",
    "Only invoices with status 'open' are reminded; status 'disputed' (and 'paid') is never sent to.",
    "The Monday summary covers all open, non-disputed invoices, with days past due shown (negative means not yet due).",
    "Summary recipient is maria@pixelandpixel.com."
   ],
   "risks": [
    "Each run re-sends a reminder to every invoice still in its band, so running more than once within the same band duplicates emails; no reminder log is kept.",
    "Reminders go to real client addresses; each send asks a person for approval first.",
    "If a run is missed, the 30/60/90-day reminder for that invoice is still sent on the next run while it remains in the band."
   ],
   "successCriteria": [
    "Only open invoices are reminded; disputed invoices receive no message.",
    "Each client receives the reminder matching its days-past-due band.",
    "The summary is delivered to maria@pixelandpixel.com.",
    "Outbox audit confirms every recipient and message hash for this run."
   ]
  },
  "budget": {
   "maxSteps": 3000,
   "maxConcurrency": 2,
   "maxDurationMs": 1800000,
   "maxCost": 0
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
