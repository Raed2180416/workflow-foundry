 "workflow": {
  "schemaVersion": "1.0",
  "id": "newsletter-crm-diff",
  "version": 1,
  "title": "Newsletter vs CRM diff (read-only)",
  "goal": "Read the CRM and newsletter sheets, list CRM contacts that are not yet on the newsletter list, skipping anyone marked unsubscribed. Write the diff as an artifact. Do not append or change any sheet.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The 'crm' and 'newsletter' sheets are keyed by email.",
    "Contacts with unsubscribed = true must not be added and are excluded from the diff."
   ],
   "risks": [
    "Email case or spacing differences are handled by the reconcile key matching; malformed emails are not checked."
   ],
   "successCriteria": [
    "A diff artifact lists every non-unsubscribed CRM contact whose email is absent from the newsletter sheet.",
    "No sheet is written."
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "budget": {
   "maxSteps": 10,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_crm",
    "kind": "task",
    "needs": [],
    "description": "Read the CRM contact sheet.",
    "tool": "sheet.read",
    "args": {
     "sheet": "crm"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "read_newsletter",
    "kind": "task",
    "needs": [],
    "description": "Read the newsletter mailing list.",
    "tool": "sheet.read",
    "args": {
     "sheet": "newsletter"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "drop_unsubscribed",
    "kind": "task",
    "needs": [
     "read_crm"
    ],
    "description": "Keep only CRM contacts that have not unsubscribed.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_crm.rows"
     },
     "where": [
      {
       "field": "unsubscribed",
       "op": "ne",
       "value": true
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "diff",
    "kind": "task",
    "needs": [
     "drop_unsubscribed",
     "read_newsletter"
    ],
    "description": "Find active CRM contacts missing from the newsletter list (by email).",
    "tool": "rows.reconcile",
    "args": {
     "left": {
      "$ref": "nodes.drop_unsubscribed.rows"
     },
     "right": {
      "$ref": "nodes.read_newsletter.rows"
     },
     "key": "email",
     "compare": [
      "name"
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "render_diff",
    "kind": "task",
    "needs": [
     "diff"
    ],
    "description": "Render the missing contacts as text lines.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.diff.missing"
     },
     "line": "{{email}} | {{name}} | {{company}}",
     "empty": "No active CRM contacts are missing from the newsletter."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "save_diff",
    "kind": "task",
    "needs": [
     "render_diff"
    ],
    "description": "Save the diff as a report artifact (no sheet changes).",
    "tool": "core.artifact",
    "args": {
     "name": "newsletter-diff.txt",
     "content": {
      "$ref": "nodes.render_diff.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   }
  ],
  "acceptance": [
   {
    "op": "exists",
    "value": {
     "$ref": "nodes.save_diff.sha256"
    }
   },
   {
    "op": "gte",
    "left": {
     "$ref": "nodes.diff.matched"
    },
    "right": 0
   },
   {
    "op": "gte",
    "left": {
     "$ref": "nodes.render_diff.count"
    },
    "right": 0
   }
  ],
  "oracle": {
   "mode": "none",
   "reason": "No independent oracle exists for a set difference between two local sheets; a person should spot-check the artifact against the two sheets before acting on it."
  },
  "metadata": {
   "tags": [
    "newsletter",
    "crm",
    "read-only"
   ],
   "rationale": "Read-only diff so the user can review who is missing before any sync; unsubscribed contacts are excluded and nothing is appended."
  }
 },
