 "workflow": {
  "schemaVersion": "1.0",
  "id": "weekly-tracker-report",
  "version": 1,
  "title": "Weekly tracker report to Rick",
  "goal": "Read the tracker export, summarise what got done, and list open and blocked items, then e-mail the report to rick@summitconstruction.com and verify the delivered message.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The tracker sheet is the current week's export; rows carry no dates, so the whole export is reported as this week's work.",
    "Friday 16:00 scheduling is handled by an external scheduler that starts this workflow; the workflow itself runs on demand.",
    "Each outbox.send asks a person before dispatch when run live."
   ],
   "risks": [
    "Rows with an empty owner may have a null owner, which could fail the report.tally input check.",
    "Recipient address is taken from the request and not verified."
   ],
   "successCriteria": [
    "Report counts match the tracker rows (done, open, blocked).",
    "The report is delivered to rick@summitconstruction.com once.",
    "The independent outbox check passes against the saved report hash."
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "budget": {
   "maxSteps": 20,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_tracker",
    "kind": "task",
    "needs": [],
    "description": "Read the tracker export.",
    "tool": "sheet.read",
    "args": {
     "sheet": "tracker"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "select_fields",
    "kind": "task",
    "needs": [
     "read_tracker"
    ],
    "description": "Keep only title, status and owner.",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.read_tracker.rows"
     },
     "fields": [
      "title",
      "status",
      "owner"
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "tally",
    "kind": "task",
    "needs": [
     "select_fields"
    ],
    "description": "Count done, open and blocked items and list the finished ones.",
    "tool": "report.tally",
    "args": {
     "items": {
      "$ref": "nodes.select_fields.rows"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "open_items",
    "kind": "task",
    "needs": [
     "select_fields"
    ],
    "description": "Keep open items.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.select_fields.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "open"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "blocked_items",
    "kind": "task",
    "needs": [
     "select_fields"
    ],
    "description": "Keep blocked items.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.select_fields.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "blocked"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "open_lines",
    "kind": "task",
    "needs": [
     "open_items"
    ],
    "description": "Render open items as lines.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.open_items.rows"
     },
     "line": "- {{title}} (owner: {{owner}})",
     "empty": "None"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "blocked_lines",
    "kind": "task",
    "needs": [
     "blocked_items"
    ],
    "description": "Render blocked items as lines.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.blocked_items.rows"
     },
     "line": "- {{title}} (owner: {{owner}})",
     "empty": "None"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "compose",
    "kind": "task",
    "needs": [
     "tally",
     "open_lines",
     "blocked_lines"
    ],
    "description": "Write the report body.",
    "tool": "core.template",
    "args": {
     "text": "Weekly tracker report as of {{now}}\n\nDone ({{done}} of {{total}}):\n{{doneLines}}\n\nOpen ({{open}}):\n{{openLines}}\n\nBlocked ({{blocked}}):\n{{blockedLines}}\n",
     "variables": {
      "now": {
       "$ref": "input.now"
      },
      "done": {
       "$ref": "nodes.tally.done"
      },
      "total": {
       "$ref": "nodes.tally.total"
      },
      "open": {
       "$ref": "nodes.tally.open"
      },
      "blocked": {
       "$ref": "nodes.tally.blocked"
      },
      "doneLines": {
       "$ref": "nodes.tally.doneLines"
      },
      "openLines": {
       "$ref": "nodes.open_lines.text"
      },
      "blockedLines": {
       "$ref": "nodes.blocked_lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "send_report",
    "kind": "task",
    "needs": [
     "compose"
    ],
    "description": "E-mail the report to Rick (asks a person before dispatch).",
    "tool": "outbox.send",
    "args": {
     "to": "rick@summitconstruction.com",
     "subject": "Weekly tracker report",
     "body": {
      "$ref": "nodes.compose.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "verify_send",
    "kind": "verify",
    "needs": [
     "send_report"
    ],
    "description": "Independently re-read the delivered message and compare its hash.",
    "method": "capability",
    "tool": "outbox.check",
    "args": {
     "messageId": {
      "$ref": "nodes.send_report.messageId"
     },
     "sha256": {
      "$ref": "nodes.send_report.sha256"
     }
    },
    "subject": {
     "$ref": "nodes.send_report"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.send_report.delivered"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.verify_send.pass"
    },
    "right": true
   }
  ]
 },
