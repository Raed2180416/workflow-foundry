 "workflow": {
  "schemaVersion": "1.0",
  "id": "it-oncall-alert-digest",
  "version": 1,
  "title": "Unresolved alert digest to #it-oncall with critical escalation email",
  "goal": "Read the alerts sheet, post a summary of unresolved warnings and criticals to #it-oncall, and if any critical alert is unresolved and unacknowledged, email the escalation recipient with those critical alerts. Warnings never trigger an email.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The alerts sheet has columns id, at, service, severity, message, acknowledged, resolved.",
    "Unresolved means resolved is false; unacknowledged means acknowledged is false.",
    "The escalation recipient is requester@example.test pending confirmation of the recipient question."
   ],
   "risks": [
    "chat.post and outbox.send ask a person before each live dispatch.",
    "The recipient is unconfirmed: the reviewer asked for n.okafor@stmaryshospital.org, which the request does not name.",
    "If resolved or acknowledged is missing on a row, that row is left out of the filter."
   ],
   "successCriteria": [
    "Summary posted to #it-oncall lists every unresolved warning and critical alert.",
    "An email is sent only when at least one unresolved critical alert is unacknowledged, and lists those alerts.",
    "No email is sent for warnings alone."
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "budget": {
   "maxSteps": 20,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_alerts",
    "kind": "task",
    "needs": [],
    "description": "Read all alert rows.",
    "tool": "sheet.read",
    "args": {
     "sheet": "alerts"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "open_alerts",
    "kind": "task",
    "needs": [
     "read_alerts"
    ],
    "description": "Keep unresolved warning and critical alerts.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_alerts.rows"
     },
     "where": [
      {
       "field": "resolved",
       "op": "eq",
       "value": false
      },
      {
       "field": "severity",
       "op": "in",
       "value": [
        "warning",
        "critical"
       ]
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "critical_unacked",
    "kind": "task",
    "needs": [
     "open_alerts"
    ],
    "description": "Keep unresolved critical alerts nobody has acknowledged.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.open_alerts.rows"
     },
     "where": [
      {
       "field": "severity",
       "op": "eq",
       "value": "critical"
      },
      {
       "field": "acknowledged",
       "op": "eq",
       "value": false
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "summary_lines",
    "kind": "task",
    "needs": [
     "open_alerts"
    ],
    "description": "Render one line per unresolved alert.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.open_alerts.rows"
     },
     "line": "{{severity}} | {{service}} | {{message}} | acknowledged: {{acknowledged}}",
     "empty": "No unresolved warnings or criticals."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "post_text",
    "kind": "task",
    "needs": [
     "open_alerts",
     "summary_lines"
    ],
    "description": "Build the channel summary text.",
    "tool": "core.template",
    "args": {
     "text": "Unresolved warnings and criticals as of {{now}}: {{count}}\n{{lines}}",
     "variables": {
      "now": {
       "$ref": "input.now"
      },
      "count": {
       "$ref": "nodes.open_alerts.count"
      },
      "lines": {
       "$ref": "nodes.summary_lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "post_summary",
    "kind": "task",
    "needs": [
     "post_text"
    ],
    "description": "Post the summary to #it-oncall.",
    "tool": "chat.post",
    "args": {
     "channel": "#it-oncall",
     "text": {
      "$ref": "nodes.post_text.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "verify_post",
    "kind": "verify",
    "needs": [
     "post_summary"
    ],
    "description": "Re-read #it-oncall and confirm the summary post is there.",
    "method": "capability",
    "tool": "chat.audit",
    "args": {
     "channel": "#it-oncall",
     "posts": 1
    },
    "subject": {
     "$ref": "nodes.post_summary"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   },
   {
    "id": "critical_lines",
    "kind": "task",
    "needs": [
     "critical_unacked"
    ],
    "when": {
     "op": "gt",
     "left": {
      "$ref": "nodes.critical_unacked.count"
     },
     "right": 0
    },
    "description": "Render one line per unacknowledged critical alert.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.critical_unacked.rows"
     },
     "line": "{{id}} | {{at}} | {{service}} | {{message}}",
     "empty": "None."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "email_text",
    "kind": "task",
    "needs": [
     "critical_unacked",
     "critical_lines"
    ],
    "when": {
     "op": "gt",
     "left": {
      "$ref": "nodes.critical_unacked.count"
     },
     "right": 0
    },
    "description": "Build the escalation email body.",
    "tool": "core.template",
    "args": {
     "text": "Unacknowledged critical alerts as of {{now}}: {{count}}\n{{lines}}",
     "variables": {
      "now": {
       "$ref": "input.now"
      },
      "count": {
       "$ref": "nodes.critical_unacked.count"
      },
      "lines": {
       "$ref": "nodes.critical_lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "send_email",
    "kind": "task",
    "needs": [
     "email_text"
    ],
    "when": {
     "op": "gt",
     "left": {
      "$ref": "nodes.critical_unacked.count"
     },
     "right": 0
    },
    "description": "Email the escalation recipient the unacknowledged critical alerts.",
    "tool": "outbox.send",
    "args": {
     "to": "requester@example.test",
     "subject": "Unacknowledged critical alerts",
     "body": {
      "$ref": "nodes.email_text.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "verify_email",
    "kind": "verify",
    "needs": [
     "send_email"
    ],
    "when": {
     "op": "gt",
     "left": {
      "$ref": "nodes.critical_unacked.count"
     },
     "right": 0
    },
    "description": "Re-read the outbox and confirm the escalation email was delivered to the escalation recipient.",
    "method": "capability",
    "tool": "outbox.audit",
    "args": {
     "to": [
      "requester@example.test"
     ]
    },
    "subject": {
     "$ref": "nodes.send_email"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.verify_post.pass"
    },
    "right": true
   },
   {
    "op": "any",
    "conditions": [
     {
      "op": "eq",
      "left": {
       "$ref": "nodes.critical_unacked.count"
      },
      "right": 0
     },
     {
      "op": "eq",
      "left": {
       "$ref": "nodes.verify_email.pass"
      },
      "right": true
     }
    ]
   }
  ],
  "metadata": {
   "rationale": "Warnings alone never trigger email. The email is gated on the count of unacknowledged unresolved criticals and verified by re-reading the outbox. Recipient pending user confirmation.",
   "tags": [
    "alerts",
    "on-call",
    "digest"
   ]
  }
 },
