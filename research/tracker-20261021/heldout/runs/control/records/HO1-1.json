 "template": "oncall-digest",
 "slots": {
  "channel": "#oncall",
  "windowHours": 168,
  "minSeverity": "warning",
  "page": true,
  "pageTo": "jordan@corestackit.com"
 },
 "workflow": {
  "schemaVersion": "1.0",
  "id": "oncall-digest",
  "version": 1,
  "title": "On-call digest for #oncall",
  "goal": "Each run, post one digest of the unresolved alerts of the last 168 hours (warning and above) to #oncall after a person approves the post.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The alerts sheet holds one row per alert with id, at, service, severity, message, acknowledged and resolved",
    "The channel is a local file standing in for chat and the outbox stands in for e-mail; nothing leaves this machine"
   ],
   "risks": [
    "Posting to the wrong channel",
    "Missing a critical alert",
    "Paging the wrong person or paging for nothing"
   ],
   "successCriteria": [
    "One digest was posted to the channel you named",
    "This run left exactly the planned post and e-mails, each intact (checked by re-reading them)"
   ],
   "unsupported": [
    "Fixing anything",
    "Phone or SMS paging",
    "Running on a schedule by itself"
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string",
     "minLength": 10,
     "maxLength": 40
    }
   }
  },
  "budget": {
   "maxSteps": 2000,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read",
    "kind": "task",
    "needs": [],
    "description": "Read the alerts sheet",
    "tool": "sheet.read",
    "args": {
     "sheet": "alerts"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "aged",
    "kind": "task",
    "needs": [
     "read"
    ],
    "description": "Work out how many hours ago each alert was raised",
    "tool": "rows.age",
    "args": {
     "rows": {
      "$ref": "nodes.read.rows"
     },
     "field": "at",
     "now": {
      "$ref": "input.now"
     },
     "unit": "hours",
     "as": "hoursAgo"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "recent",
    "kind": "task",
    "needs": [
     "aged"
    ],
    "description": "Keep unresolved alerts in the window at the chosen severity or above",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.aged.rows"
     },
     "where": [
      {
       "field": "hoursAgo",
       "op": "lte",
       "value": 168
      },
      {
       "field": "hoursAgo",
       "op": "gte",
       "value": 0
      },
      {
       "field": "resolved",
       "op": "ne",
       "value": true
      },
      {
       "field": "severity",
       "op": "in",
       "value": [
        "warning",
        "critical"
       ]
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "lines",
    "kind": "task",
    "needs": [
     "recent"
    ],
    "description": "List the alerts",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.recent.rows"
     },
     "line": "- [{{severity}}] {{service}}: {{message}} (alert {{id}}, {{hoursAgo}}h ago, acknowledged: {{acknowledged}})",
     "empty": "- nothing unresolved. A quiet shift."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "digest",
    "kind": "task",
    "needs": [
     "lines"
    ],
    "description": "Write the digest",
    "tool": "core.template",
    "args": {
     "text": "On-call digest: {{n}} unresolved alert(s) in the last 168 hours (warning and above)\n{{lines}}",
     "variables": {
      "n": {
       "$ref": "nodes.lines.count"
      },
      "lines": {
       "$ref": "nodes.lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "post",
    "kind": "task",
    "needs": [
     "digest"
    ],
    "description": "Post the digest to #oncall (asks you first)",
    "tool": "chat.post",
    "args": {
     "channel": "#oncall",
     "text": {
      "$ref": "nodes.digest.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "critical",
    "kind": "task",
    "needs": [
     "recent"
    ],
    "description": "Critical alerts nobody acknowledged",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.recent.rows"
     },
     "where": [
      {
       "field": "severity",
       "op": "eq",
       "value": "critical"
      },
      {
       "field": "acknowledged",
       "op": "ne",
       "value": true
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "pages",
    "kind": "map",
    "needs": [
     "critical",
     "post"
    ],
    "description": "Page jordan@corestackit.com about each one",
    "items": {
     "$ref": "nodes.critical.rows"
    },
    "maxItems": 200,
    "concurrency": 1,
    "body": {
     "nodes": [
      {
       "id": "compose",
       "kind": "task",
       "needs": [],
       "description": "Write the page",
       "tool": "core.template",
       "args": {
        "text": "CRITICAL alert {{id}} on {{service}}: {{message}}\nRaised {{hours}}h ago and not acknowledged.",
        "variables": {
         "id": {
          "$ref": "item.id"
         },
         "service": {
          "$ref": "item.service"
         },
         "message": {
          "$ref": "item.message",
          "default": ""
         },
         "hours": {
          "$ref": "item.hoursAgo"
         }
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 2
       }
      },
      {
       "id": "subject",
       "kind": "task",
       "needs": [],
       "description": "Write the subject",
       "tool": "core.template",
       "args": {
        "text": "Page: {{service}} critical (alert {{id}})",
        "variables": {
         "service": {
          "$ref": "item.service"
         },
         "id": {
          "$ref": "item.id"
         }
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 2
       }
      },
      {
       "id": "send",
       "kind": "task",
       "needs": [
        "compose",
        "subject"
       ],
       "description": "E-mail the page (asks you first)",
       "tool": "outbox.send",
       "args": {
        "to": "jordan@corestackit.com",
        "subject": {
         "$ref": "nodes.subject.text"
        },
        "body": {
         "$ref": "nodes.compose.text"
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 1
       }
      }
     ],
     "acceptance": [
      {
       "op": "eq",
       "left": {
        "$ref": "nodes.send.delivered"
       },
       "right": true
      }
     ]
    }
   },
   {
    "id": "pageList",
    "kind": "task",
    "needs": [
     "critical"
    ],
    "description": "One expected page per critical alert",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.critical.rows"
     },
     "fields": [
      "id"
     ],
     "set": {
      "to": "jordan@corestackit.com"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "pageExpected",
    "kind": "task",
    "needs": [
     "pageList"
    ],
    "description": "Who should have been paged",
    "tool": "core.pluck",
    "args": {
     "items": {
      "$ref": "nodes.pageList.rows"
     },
     "field": "to"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "chatAudit",
    "kind": "verify",
    "needs": [
     "post"
    ],
    "description": "Re-read the channel: exactly one digest from this run, intact",
    "method": "capability",
    "tool": "chat.audit",
    "args": {
     "channel": "#oncall",
     "posts": 1
    },
    "subject": {
     "$ref": "nodes.post"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   },
   {
    "id": "mailAudit",
    "kind": "verify",
    "needs": [
     "pages",
     "pageExpected",
     "post"
    ],
    "description": "Re-read the outbox: only the planned pages went out (none when paging is off)",
    "method": "capability",
    "tool": "outbox.audit",
    "args": {
     "to": [
      {
       "$ref": "nodes.pageExpected.items"
      }
     ]
    },
    "subject": {
     "$ref": "nodes.post"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.post.posted"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.chatAudit.pass"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.mailAudit.pass"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.pages.count"
    },
    "right": {
     "$ref": "nodes.critical.count"
    }
   }
  ],
  "metadata": {
   "sources": [
