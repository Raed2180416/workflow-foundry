 "workflow": {
  "schemaVersion": "1.0",
  "id": "oncall-alert-digest",
  "version": 1,
  "title": "Daily unresolved alerts digest to #oncall and critical-unacknowledged escalation",
  "goal": "Each run: read the alerts sheet, post a digest of all unresolved alerts (with severity and service) to the #oncall channel, and if any unresolved critical alert has not been acknowledged for at least one hour, email the requester directly.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The run is started every morning at 8:00 by an external scheduler and receives the current time as input.now.",
    "The Slack stand-in channel is named #oncall.",
    "The escalation email goes to the requester's own address, requester@example.test, as the user asked.",
    "The one-hour check is evaluated only at each run, so a critical alert is escalated at the first run after it has been unacknowledged for an hour."
   ],
   "risks": [
    "Escalation only happens when the flow runs; if the schedule is missed, overdue critical alerts are not emailed until the next run.",
    "chat.post and outbox.send are non-idempotent and are attempted only once; a failed post needs manual re-run.",
    "Outbound messages require a person's approval when the flow runs live."
   ],
   "successCriteria": [
    "The digest lists every alert with resolved=false, including severity and service, and is posted once to #oncall.",
    "Every critical alert with acknowledged=false, resolved=false and age of at least one hour triggers exactly one email to the requester.",
    "No email is sent when no critical alert is overdue."
   ]
  },
  "budget": {
   "maxSteps": 30,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "nodes": [
   {
    "id": "read_alerts",
    "kind": "task",
    "needs": [],
    "description": "Read all alert rows.",
    "tool": "sheet.read",
    "args": {
     "sheet": "alerts"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "unresolved",
    "kind": "task",
    "needs": [
     "read_alerts"
    ],
    "description": "Keep alerts that are not resolved.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_alerts.rows"
     },
     "where": [
      {
       "field": "resolved",
       "op": "eq",
       "value": false
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "digest_lines",
    "kind": "task",
    "needs": [
     "unresolved"
    ],
    "description": "Render one line per unresolved alert with severity and service.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.unresolved.rows"
     },
     "line": "[{{severity}}] {{service}} | {{id}} | {{message}}",
     "empty": "No unresolved alerts."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "digest_text",
    "kind": "task",
    "needs": [
     "digest_lines"
    ],
    "description": "Build the digest message text.",
    "tool": "core.template",
    "args": {
     "text": "Unresolved alerts digest for {{now}} ({{count}} total):\n{{lines}}",
     "variables": {
      "now": {
       "$ref": "input.now"
      },
      "count": {
       "$ref": "nodes.digest_lines.count"
      },
      "lines": {
       "$ref": "nodes.digest_lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "post_digest",
    "kind": "task",
    "needs": [
     "digest_text"
    ],
    "description": "Post the digest to #oncall.",
    "tool": "chat.post",
    "args": {
     "channel": "#oncall",
     "text": {
      "$ref": "nodes.digest_text.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "verify_digest",
    "kind": "verify",
    "needs": [
     "post_digest"
    ],
    "description": "Re-read #oncall and confirm the digest post is there.",
    "method": "capability",
    "tool": "chat.audit",
    "args": {
     "channel": "#oncall",
     "posts": 1
    },
    "subject": {
     "$ref": "nodes.post_digest"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   },
   {
    "id": "critical_unacked",
    "kind": "task",
    "needs": [
     "read_alerts"
    ],
    "description": "Keep unresolved, unacknowledged critical alerts.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_alerts.rows"
     },
     "where": [
      {
       "field": "severity",
       "op": "eq",
       "value": "critical"
      },
      {
       "field": "acknowledged",
       "op": "eq",
       "value": false
      },
      {
       "field": "resolved",
       "op": "eq",
       "value": false
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "aged",
    "kind": "task",
    "needs": [
     "critical_unacked"
    ],
    "description": "Compute hours since each alert was raised.",
    "tool": "rows.age",
    "args": {
     "rows": {
      "$ref": "nodes.critical_unacked.rows"
     },
     "field": "at",
     "now": {
      "$ref": "input.now"
     },
     "unit": "hours",
     "as": "ageHours"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "overdue",
    "kind": "task",
    "needs": [
     "aged"
    ],
    "description": "Keep critical alerts unacknowledged for at least one hour.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.aged.rows"
     },
     "where": [
      {
       "field": "ageHours",
       "op": "gte",
       "value": 1
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "escalation_lines",
    "kind": "task",
    "needs": [
     "overdue"
    ],
    "description": "Render the overdue critical alerts.",
    "when": {
     "op": "gte",
     "left": {
      "$ref": "nodes.overdue.count"
     },
     "right": 1
    },
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.overdue.rows"
     },
     "line": "{{id}} | {{service}} | {{message}} | raised {{at}}",
     "empty": "none"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "escalation_body",
    "kind": "task",
    "needs": [
     "escalation_lines"
    ],
    "description": "Build the escalation email body.",
    "when": {
     "op": "gte",
     "left": {
      "$ref": "nodes.overdue.count"
     },
     "right": 1
    },
    "tool": "core.template",
    "args": {
     "text": "{{count}} critical alert(s) have not been acknowledged for at least one hour:\n{{lines}}",
     "variables": {
      "count": {
       "$ref": "nodes.overdue.count"
      },
      "lines": {
       "$ref": "nodes.escalation_lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "email_escalation",
    "kind": "task",
    "needs": [
     "escalation_body"
    ],
    "description": "Email the requester about overdue critical alerts.",
    "when": {
     "op": "gte",
     "left": {
      "$ref": "nodes.overdue.count"
     },
     "right": 1
    },
    "join": "all_resolved",
    "tool": "outbox.send",
    "args": {
     "to": "requester@example.test",
     "subject": "Critical alert not acknowledged within 1 hour",
     "body": {
      "$ref": "nodes.escalation_body.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "verify_escalation",
    "kind": "verify",
    "needs": [
     "email_escalation"
    ],
    "description": "Re-read the outbox and confirm the escalation email was delivered once.",
    "when": {
     "op": "gte",
     "left": {
      "$ref": "nodes.overdue.count"
     },
     "right": 1
    },
    "method": "capability",
    "tool": "outbox.audit",
    "args": {
     "to": [
      "requester@example.test"
     ]
    },
    "subject": {
     "$ref": "nodes.email_escalation"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.verify_digest.pass"
    },
    "right": true
   },
   {
    "op": "any",
    "conditions": [
     {
      "op": "eq",
      "left": {
       "$ref": "nodes.overdue.count"
      },
      "right": 0
     },
     {
      "op": "eq",
      "left": {
       "$ref": "nodes.verify_escalation.pass"
      },
      "right": true
     }
    ]
   }
  ],
  "metadata": {
   "rationale": "Digest is built from the alerts sheet with deterministic filters; the escalation uses the one-hour age rule on unacknowledged critical alerts. Both outbound actions are verified by independent re-read.",
   "tags": [
    "oncall",
    "alerts",
    "digest",
    "escalation"
   ]
  }
 },
