 "workflow": {
  "schemaVersion": "1.0",
  "id": "crm-newsletter-sync",
  "version": 1,
  "title": "Sync customers from CRM into newsletter list and report additions",
  "goal": "Add every non-unsubscribed CRM contact missing from the newsletter list to the newsletter sheet, then send Janet a report of who was added.",
  "domain": "general",
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "envelope": {
   "assumptions": [
    "The crm and newsletter sheets are keyed by email and compared case-insensitively.",
    "Contacts with unsubscribed = true are skipped; all others are eligible.",
    "The report recipient is janet@happytailsbakery.com as stated by the requester."
   ],
   "risks": [
    "addedAt is not filled in for appended rows because rows.select can only set constant values; it will be null.",
    "The outbox send is an outside action and asks a person before dispatch."
   ],
   "successCriteria": [
    "Every eligible CRM contact not already in newsletter is appended exactly once.",
    "Unsubscribed contacts are never appended.",
    "The report lists exactly the appended contacts and is delivered to Janet and verified."
   ]
  },
  "budget": {
   "maxSteps": 30,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_crm",
    "kind": "task",
    "needs": [],
    "description": "Read the CRM sheet.",
    "tool": "sheet.read",
    "args": {
     "sheet": "crm"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "read_newsletter",
    "kind": "task",
    "needs": [],
    "description": "Read the newsletter list.",
    "tool": "sheet.read",
    "args": {
     "sheet": "newsletter"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "active",
    "kind": "task",
    "needs": [
     "read_crm"
    ],
    "description": "Keep only contacts that are not unsubscribed.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_crm.rows"
     },
     "where": [
      {
       "field": "unsubscribed",
       "op": "eq",
       "value": false
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "diff",
    "kind": "task",
    "needs": [
     "active",
     "read_newsletter"
    ],
    "description": "Find eligible CRM contacts missing from the newsletter list.",
    "tool": "rows.reconcile",
    "args": {
     "left": {
      "$ref": "nodes.active.rows"
     },
     "right": {
      "$ref": "nodes.read_newsletter.rows"
     },
     "key": "email"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "pick",
    "kind": "task",
    "needs": [
     "diff"
    ],
    "description": "Shape missing contacts as newsletter rows.",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.diff.missing"
     },
     "fields": [
      "email",
      "name"
     ],
     "set": {
      "source": "crm"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "append",
    "kind": "task",
    "needs": [
     "pick"
    ],
    "description": "Append the missing contacts to the newsletter sheet.",
    "tool": "sheet.append",
    "args": {
     "sheet": "newsletter",
     "rows": {
      "$ref": "nodes.pick.rows"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "audit",
    "kind": "verify",
    "needs": [
     "append",
     "pick"
    ],
    "description": "Confirm the appended rows are in the newsletter sheet.",
    "method": "capability",
    "tool": "sheet.audit",
    "args": {
     "sheet": "newsletter",
     "rows": {
      "$ref": "nodes.pick.count"
     }
    },
    "subject": {
     "$ref": "nodes.append"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   },
   {
    "id": "lines",
    "kind": "task",
    "needs": [
     "diff"
    ],
    "description": "Render one report line per added contact.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.diff.missing"
     },
     "line": "{{email}} ({{name}})",
     "empty": "No new contacts were added."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "body",
    "kind": "task",
    "needs": [
     "pick",
     "lines"
    ],
    "description": "Build the report text.",
    "tool": "core.template",
    "args": {
     "text": "Newsletter sync ({{now}}): {{count}} contact(s) added from the customer sheet.\n\n{{lines}}",
     "variables": {
      "now": {
       "$ref": "input.now"
      },
      "count": {
       "$ref": "nodes.pick.count"
      },
      "lines": {
       "$ref": "nodes.lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "send",
    "kind": "task",
    "needs": [
     "body",
     "audit"
    ],
    "description": "Send the report to Janet.",
    "tool": "outbox.send",
    "args": {
     "to": "janet@happytailsbakery.com",
     "subject": "Newsletter sync report",
     "body": {
      "$ref": "nodes.body.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "check_send",
    "kind": "verify",
    "needs": [
     "send"
    ],
    "description": "Confirm the report was delivered to Janet.",
    "method": "capability",
    "tool": "outbox.audit",
    "args": {
     "to": [
      "janet@happytailsbakery.com"
     ]
    },
    "subject": {
     "$ref": "nodes.send"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.audit.pass"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.check_send.pass"
    },
    "right": true
   }
  ]
 },
