 "workflow": {
  "schemaVersion": "1.0",
  "id": "weekly-tracker-report",
  "version": 1,
  "title": "Weekly tracker report to Rick",
  "goal": "Read the tracker export, summarise what got done, and list what is open and blocked, then e-mail the report to rick@summitconstruction.com. Intended to run every Friday at 16:00.",
  "domain": "general",
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "envelope": {
   "assumptions": [
    "The tracker sheet holds the export for the current week; it has no date field, so no week filtering is applied.",
    "The every-Friday-at-4 schedule is provided by an external trigger that starts a run with input.now.",
    "Each outbox.send to Rick requires a person's approval when the flow runs live."
   ],
   "risks": [
    "Without dates in the tracker, items completed in earlier weeks may appear as done if the export is not limited to this week.",
    "The report is only as current as the tracker export at run time."
   ],
   "successCriteria": [
    "The tracker is read and every row is counted as done, open or blocked.",
    "The report e-mail is delivered to rick@summitconstruction.com.",
    "The delivered message matches the saved report hash."
   ]
  },
  "budget": {
   "maxSteps": 14,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read",
    "kind": "task",
    "needs": [],
    "description": "Read every row of the tracker export.",
    "tool": "sheet.read",
    "args": {
     "sheet": "tracker"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "select",
    "kind": "task",
    "needs": [
     "read"
    ],
    "description": "Keep only title, status and owner of each tracker row.",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.read.rows"
     },
     "fields": [
      "title",
      "status",
      "owner"
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "tally",
    "kind": "task",
    "needs": [
     "select"
    ],
    "description": "Count done, open and blocked items and list the done ones.",
    "tool": "report.tally",
    "args": {
     "items": {
      "$ref": "nodes.select.rows"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "open_rows",
    "kind": "task",
    "needs": [
     "select"
    ],
    "description": "Keep the open items.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.select.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "open"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "blocked_rows",
    "kind": "task",
    "needs": [
     "select"
    ],
    "description": "Keep the blocked items.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.select.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "blocked"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "open_lines",
    "kind": "task",
    "needs": [
     "open_rows"
    ],
    "description": "Render one line per open item.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.open_rows.rows"
     },
     "line": "- {{title}} (owner: {{owner}})",
     "empty": "None"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "blocked_lines",
    "kind": "task",
    "needs": [
     "blocked_rows"
    ],
    "description": "Render one line per blocked item.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.blocked_rows.rows"
     },
     "line": "- {{title}} (owner: {{owner}})",
     "empty": "None"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "compose",
    "kind": "task",
    "needs": [
     "tally",
     "open_lines",
     "blocked_lines",
     "read"
    ],
    "description": "Assemble the report text.",
    "tool": "core.template",
    "args": {
     "text": "Weekly tracker report as of {{now}}\n\nDone: {{done}} of {{total}}\n{{doneLines}}\n\nOpen: {{open}}\n{{openLines}}\n\nBlocked: {{blocked}}\n{{blockedLines}}\n",
     "variables": {
      "now": {
       "$ref": "input.now"
      },
      "done": {
       "$ref": "nodes.tally.done"
      },
      "total": {
       "$ref": "nodes.tally.total"
      },
      "open": {
       "$ref": "nodes.tally.open"
      },
      "blocked": {
       "$ref": "nodes.tally.blocked"
      },
      "doneLines": {
       "$ref": "nodes.tally.doneLines"
      },
      "openLines": {
       "$ref": "nodes.open_lines.text"
      },
      "blockedLines": {
       "$ref": "nodes.blocked_lines.text"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "send",
    "kind": "task",
    "needs": [
     "compose"
    ],
    "description": "E-mail the weekly report to Rick.",
    "tool": "outbox.send",
    "args": {
     "to": "rick@summitconstruction.com",
     "subject": "Weekly tracker report",
     "body": {
      "$ref": "nodes.compose.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "verify",
    "kind": "verify",
    "needs": [
     "send"
    ],
    "description": "Re-read the delivered message and compare its hash with the saved report.",
    "method": "capability",
    "tool": "outbox.check",
    "args": {
     "messageId": {
      "$ref": "nodes.send.messageId"
     },
     "sha256": {
      "$ref": "nodes.send.sha256"
     }
    },
    "subject": {
     "$ref": "nodes.send"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.send.delivered"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.verify.pass"
    },
    "right": true
   }
  ]
 },
