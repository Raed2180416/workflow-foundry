 "workflow": {
  "schemaVersion": "1.0",
  "id": "expense-auto-approve",
  "version": 1,
  "title": "Auto-approve small expense claims with receipts; route the rest to Dana",
  "goal": "Read submitted expense claims. Claims under $50 with a receipt are logged as approved. Claims of $50 or more, and claims without a receipt, are logged as waiting for approver and routed to dana@brightleafmarketing.com. Every decision is appended to the expense-decisions sheet.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "Amounts are numeric in one currency (USD assumed) and the receipt field is boolean.",
    "Only claims with status 'submitted' are processed.",
    "Routing to Dana is recorded as a 'waiting for approver' decision row naming dana@brightleafmarketing.com in the reason; no e-mail is sent.",
    "The decision row has no 'at' timestamp because rows.select can only set constant values."
   ],
   "risks": [
    "The expenses sheet status is not changed to approved (the flow only appends to expense-decisions), so the same claim could be reprocessed on a later run; the append step is idempotent per step, not per claim.",
    "Claims with a missing or non-numeric amount are not routed by any branch and are left out of the decision log."
   ],
   "successCriteria": [
    "Every submitted claim with amount under 50 and receipt true has an 'approved' decision row.",
    "Every submitted claim with amount 50 or more, or receipt false, has a 'waiting for approver' decision row naming dana@brightleafmarketing.com.",
    "Each append is confirmed by sheet.audit."
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "budget": {
   "maxSteps": 30,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_expenses",
    "kind": "task",
    "needs": [],
    "description": "Read all expense claims.",
    "tool": "sheet.read",
    "args": {
     "sheet": "expenses"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "submitted",
    "kind": "task",
    "needs": [
     "read_expenses"
    ],
    "description": "Keep only submitted claims.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_expenses.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "submitted"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "approved_claims",
    "kind": "task",
    "needs": [
     "submitted"
    ],
    "description": "Submitted claims under 50 with a receipt.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.submitted.rows"
     },
     "where": [
      {
       "field": "amount",
       "op": "lt",
       "value": 50
      },
      {
       "field": "receipt",
       "op": "eq",
       "value": true
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "over_limit_claims",
    "kind": "task",
    "needs": [
     "submitted"
    ],
    "description": "Submitted claims of 50 or more.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.submitted.rows"
     },
     "where": [
      {
       "field": "amount",
       "op": "gte",
       "value": 50
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "no_receipt_claims",
    "kind": "task",
    "needs": [
     "submitted"
    ],
    "description": "Submitted claims under 50 without a receipt.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.submitted.rows"
     },
     "where": [
      {
       "field": "amount",
       "op": "lt",
       "value": 50
      },
      {
       "field": "receipt",
       "op": "eq",
       "value": false
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "decide_approved",
    "kind": "task",
    "needs": [
     "approved_claims"
    ],
    "description": "Build approved decision rows.",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.approved_claims.rows"
     },
     "fields": [
      "id",
      "employee",
      "amount"
     ],
     "set": {
      "decision": "approved",
      "reason": "under 50 with receipt"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "decide_over_limit",
    "kind": "task",
    "needs": [
     "over_limit_claims"
    ],
    "description": "Build waiting rows for claims of 50 or more.",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.over_limit_claims.rows"
     },
     "fields": [
      "id",
      "employee",
      "amount"
     ],
     "set": {
      "decision": "waiting for approver",
      "reason": "amount 50 or more; routed to dana@brightleafmarketing.com"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "decide_no_receipt",
    "kind": "task",
    "needs": [
     "no_receipt_claims"
    ],
    "description": "Build waiting rows for claims without a receipt.",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.no_receipt_claims.rows"
     },
     "fields": [
      "id",
      "employee",
      "amount"
     ],
     "set": {
      "decision": "waiting for approver",
      "reason": "no receipt; routed to dana@brightleafmarketing.com"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "append_approved",
    "kind": "task",
    "needs": [
     "decide_approved"
    ],
    "description": "Log approved decisions.",
    "tool": "sheet.append",
    "args": {
     "sheet": "expense-decisions",
     "rows": {
      "$ref": "nodes.decide_approved.rows"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "append_over_limit",
    "kind": "task",
    "needs": [
     "decide_over_limit"
    ],
    "description": "Log claims routed to Dana for amount.",
    "tool": "sheet.append",
    "args": {
     "sheet": "expense-decisions",
     "rows": {
      "$ref": "nodes.decide_over_limit.rows"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "append_no_receipt",
    "kind": "task",
    "needs": [
     "decide_no_receipt"
    ],
    "description": "Log claims routed to Dana for missing receipt.",
    "tool": "sheet.append",
    "args": {
     "sheet": "expense-decisions",
     "rows": {
      "$ref": "nodes.decide_no_receipt.rows"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "audit_approved",
    "kind": "verify",
    "needs": [
     "append_approved"
    ],
    "description": "Confirm approved decision rows were written.",
    "method": "capability",
    "tool": "sheet.audit",
    "args": {
     "sheet": "expense-decisions",
     "rows": {
      "$ref": "nodes.append_approved.appended"
     }
    },
    "subject": {
     "$ref": "nodes.append_approved"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   },
   {
    "id": "audit_over_limit",
    "kind": "verify",
    "needs": [
     "append_over_limit"
    ],
    "description": "Confirm amount-based routing rows were written.",
    "method": "capability",
    "tool": "sheet.audit",
    "args": {
     "sheet": "expense-decisions",
     "rows": {
      "$ref": "nodes.append_over_limit.appended"
     }
    },
    "subject": {
     "$ref": "nodes.append_over_limit"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   },
   {
    "id": "audit_no_receipt",
    "kind": "verify",
    "needs": [
     "append_no_receipt"
    ],
    "description": "Confirm no-receipt routing rows were written.",
    "method": "capability",
    "tool": "sheet.audit",
    "args": {
     "sheet": "expense-decisions",
     "rows": {
      "$ref": "nodes.append_no_receipt.appended"
     }
    },
    "subject": {
     "$ref": "nodes.append_no_receipt"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
