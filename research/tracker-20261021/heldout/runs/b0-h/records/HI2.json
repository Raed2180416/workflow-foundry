    "tool": "outbox.audit",
    "args": {
     "to": {
      "$ref": "nodes.due_emails.items"
     }
    },
    "subject": {
     "$ref": "nodes.send_reminders"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
