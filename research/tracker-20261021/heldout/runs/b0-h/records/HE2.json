 "workflow": {
  "schemaVersion": "1.0",
  "id": "expense-claim-routing",
  "version": 1,
  "title": "Route expense claims: auto-approve small receipted claims, send the rest to Owen",
  "goal": "Read submitted expense claims. Approve automatically claims under 100 that have a receipt (photo). Send every other submitted claim (100 or more, or no receipt) to Owen at owen@evergreenlandscaping.co in one summary email, and record one decision row per submitted claim in the expense-decisions sheet.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "'Under 100' means amount < 100; an amount of exactly 100 or more goes to Owen.",
    "'Has a photo' means the expenses row has receipt = true.",
    "Only rows with status 'submitted' are processed.",
    "Amounts are in the same currency and are numbers.",
    "Owen's address is owen@evergreenlandscaping.co, as the person stated."
   ],
   "risks": [
    "outbox.send asks a person before dispatch, so the Owen email only goes out after approval.",
    "Auto-approval only records the decision in expense-decisions; it does not change the expenses sheet status or pay anyone.",
    "The 'at' timestamp is filled from the run input; if the reference does not resolve, the at field may be empty."
   ],
   "successCriteria": [
    "Every submitted claim gets exactly one row in expense-decisions.",
    "Claims under 100 with a receipt are marked approved; all others are marked waiting for approver.",
    "Owen receives one summary email listing the claims waiting for approver, when there are any.",
    "The sheet audit confirms the appended rows are in the expense-decisions file."
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "budget": {
   "maxSteps": 20,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read_expenses",
    "kind": "task",
    "needs": [],
    "description": "Read every row of the expenses sheet.",
    "tool": "sheet.read",
    "args": {
     "sheet": "expenses"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "submitted",
    "kind": "task",
    "needs": [
     "read_expenses"
    ],
    "description": "Keep only claims with status submitted.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_expenses.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "submitted"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "route",
    "kind": "task",
    "needs": [
     "submitted"
    ],
    "description": "Label each claim: waiting for approver if amount is 100 or more, or there is no receipt; otherwise approved.",
    "tool": "rows.route",
    "args": {
     "rows": {
      "$ref": "nodes.submitted.rows"
     },
     "rules": [
      {
       "field": "amount",
       "op": "gte",
       "value": 100,
       "set": {
        "decision": "waiting for approver",
        "reason": "amount 100 or more - sent to Owen"
       }
      },
      {
       "field": "receipt",
       "op": "ne",
       "value": true,
       "set": {
        "decision": "waiting for approver",
        "reason": "no receipt - sent to Owen"
       }
      }
     ],
     "otherwise": {
      "decision": "approved",
      "reason": "under 100 with receipt - auto-approved"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "decisions",
    "kind": "task",
    "needs": [
     "route"
    ],
    "description": "Shape each decision row for the expense-decisions sheet.",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.route.rows"
     },
     "fields": [
      "id",
      "employee",
      "amount",
      "decision",
      "reason"
     ],
     "set": {
      "at": {
       "$ref": "input.now"
      }
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "append_decisions",
    "kind": "task",
    "needs": [
     "decisions"
    ],
    "description": "Record one decision row per submitted claim.",
    "tool": "sheet.append",
    "args": {
     "sheet": "expense-decisions",
     "rows": {
      "$ref": "nodes.decisions.rows"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "waiting",
    "kind": "task",
    "needs": [
     "decisions"
    ],
    "description": "Keep only the claims waiting for Owen.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.decisions.rows"
     },
     "where": [
      {
       "field": "decision",
       "op": "eq",
       "value": "waiting for approver"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "digest",
    "kind": "task",
    "needs": [
     "waiting"
    ],
    "description": "Build the text listing claims for Owen.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.waiting.rows"
     },
     "line": "{{id}} | {{employee}} | {{amount}} | {{reason}}",
     "empty": "No expense claims are waiting for approval."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "notify_owen",
    "kind": "task",
    "needs": [
     "digest"
    ],
    "when": {
     "op": "gt",
     "left": {
      "$ref": "nodes.digest.count"
     },
     "right": 0
    },
    "description": "Send Owen one summary email of claims that need approval.",
    "tool": "outbox.send",
    "args": {
     "to": "owen@evergreenlandscaping.co",
     "subject": "Expense claims waiting for your approval",
     "body": {
      "$ref": "nodes.digest.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "audit_decisions",
    "kind": "verify",
    "needs": [
     "append_decisions",
     "submitted"
    ],
    "description": "Independently confirm the appended decision rows are in the expense-decisions sheet.",
    "method": "capability",
    "tool": "sheet.audit",
    "args": {
     "sheet": "expense-decisions",
     "rows": {
      "$ref": "nodes.append_decisions.appended"
     }
    },
    "subject": {
     "$ref": "nodes.append_decisions"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.audit_decisions.pass"
    },
    "right": true
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.append_decisions.appended"
    },
    "right": {
     "$ref": "nodes.submitted.count"
    }
   }
  ],
  "metadata": {
   "rationale": "Rules come straight from the request: under 100 with a photo is auto-approved; over that, or with no receipt, goes to Owen; every decision is recorded in the expense-decisions sheet.",
   "tags": [
    "expenses",
    "approval"
   ]
  }
 },
