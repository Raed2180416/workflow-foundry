 "workflow": {
  "schemaVersion": "1.0",
  "id": "newsletter-crm-diff",
  "version": 1,
  "title": "Diff CRM contacts missing from newsletter list (report only)",
  "goal": "Read the CRM sheet and the newsletter list, skip CRM contacts marked unsubscribed, and report which remaining CRM contacts are not in the newsletter list. Make no changes to any sheet and send nothing.",
  "domain": "general",
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "envelope": {
   "assumptions": [
    "The crm sheet is the Mindbody contact export with email, name, company, tags, unsubscribed.",
    "The newsletter sheet stands in for the Mailchimp audience.",
    "Emails are matched ignoring case and spaces, as rows.reconcile does.",
    "Unsubscribed CRM contacts are left out of the diff entirely."
   ],
   "risks": [
    "Sheet exports may contain duplicate or malformed emails that are reported as-is.",
    "The report is a snapshot; it does not make any change to either list."
   ],
   "successCriteria": [
    "Every reported contact is in crm, has unsubscribed not true, and is absent from the newsletter sheet.",
    "No rows are appended to any sheet and no message is sent.",
    "A diff artifact is written for review."
   ]
  },
  "budget": {
   "maxSteps": 10,
   "maxConcurrency": 2,
   "maxDurationMs": 120000,
   "maxCost": 0
  },
  "nodes": [
   {
    "id": "read-crm",
    "kind": "task",
    "needs": [],
    "description": "Read all CRM contacts.",
    "tool": "sheet.read",
    "args": {
     "sheet": "crm"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "read-newsletter",
    "kind": "task",
    "needs": [],
    "description": "Read the current newsletter list.",
    "tool": "sheet.read",
    "args": {
     "sheet": "newsletter"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "eligible",
    "kind": "task",
    "needs": [
     "read-crm"
    ],
    "description": "Keep CRM contacts that are not unsubscribed.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read-crm.rows"
     },
     "where": [
      {
       "field": "unsubscribed",
       "op": "ne",
       "value": true
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "diff",
    "kind": "task",
    "needs": [
     "eligible",
     "read-newsletter"
    ],
    "description": "Find eligible CRM contacts whose email is not in the newsletter list.",
    "tool": "rows.reconcile",
    "args": {
     "left": {
      "$ref": "nodes.eligible.rows"
     },
     "right": {
      "$ref": "nodes.read-newsletter.rows"
     },
     "key": "email"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "report",
    "kind": "task",
    "needs": [
     "diff"
    ],
    "description": "Render the missing contacts as one line each.",
    "tool": "rows.lines",
    "args": {
     "rows": {
      "$ref": "nodes.diff.missing"
     },
     "line": "{{email}} | {{name}} | {{company}}",
     "empty": "No eligible CRM contacts are missing from the newsletter list."
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "artifact",
    "kind": "task",
    "needs": [
     "report"
    ],
    "description": "Save the diff report as a run artifact for review.",
    "tool": "core.artifact",
    "args": {
     "name": "newsletter-diff.txt",
     "content": {
      "$ref": "nodes.report.text"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   }
  ],
  "acceptance": [
   {
    "op": "gte",
    "left": {
     "$ref": "nodes.report.count"
    },
    "right": 0
   },
   {
    "op": "exists",
    "value": {
     "$ref": "nodes.artifact.sha256"
    }
   }
  ],
  "oracle": {
   "mode": "none",
   "reason": "No capability independently re-checks a reconcile diff of two sheets; a person should spot-check a few reported emails against the crm and newsletter sheets before acting on the list."
  }
 },
