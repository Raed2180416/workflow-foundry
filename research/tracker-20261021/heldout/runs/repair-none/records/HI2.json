        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 1
       }
      }
     ],
     "acceptance": [
      {
       "op": "eq",
       "left": {
        "$ref": "nodes.copy.delivered"
       },
       "right": true
      }
     ]
    }
   },
