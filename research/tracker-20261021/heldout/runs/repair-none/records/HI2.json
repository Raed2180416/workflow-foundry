 "workflow": {
  "schemaVersion": "1.0",
  "id": "overdue-invoice-reminders",
  "version": 2,
  "title": "Overdue invoice reminders (day 3, 10, 17)",
  "goal": "For each open invoice whose due date is exactly 3, 10 or 17 days in the past, send the matching payment reminder to the invoice's email from the invoices sheet. Send a separate copy of each second reminder (10 days overdue) to dave@midwestpipesupply.com, since outbox.send has no BCC field.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "Reminders are chosen by exact whole-day match: 3, 10 and 17 days after the due date. The flow is expected to run once per day.",
    "Days overdue are counted from the due date (YYYY-MM-DD, midnight UTC) to input.now.",
    "outbox.send has no BCC field, so Dave receives a separate copy of each second reminder rather than a hidden copy on the customer message.",
    "Only invoices with status 'open' are considered; paid and disputed invoices are skipped."
   ],
   "risks": [
    "A run skipped on a due day means that reminder is never sent, since nothing tracks past sends.",
    "Re-running the same day sends duplicate reminders (outbox.send is non-idempotent).",
    "One invoice with an unreadable due date makes rows.age fail and stops the whole run.",
    "Dave's copies are included in the audit's expected list, so an unexpected extra message would still be flagged."
   ],
   "successCriteria": [
    "Every open invoice exactly 3, 10 or 17 days overdue gets one reminder to its sheet email.",
    "Each 10-days-overdue invoice also produces one copy to dave@midwestpipesupply.com.",
    "The outbox audit confirms all recipients (customers and Dave's copies) match the expected list."
   ]
  },
  "budget": {
   "maxSteps": 5000,
   "maxConcurrency": 2,
   "maxDurationMs": 900000,
   "maxCost": 0
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string"
    }
   }
  },
  "nodes": [
   {
    "id": "read_invoices",
    "kind": "task",
    "needs": [],
    "description": "Read the invoices sheet.",
    "tool": "sheet.read",
    "args": {
     "sheet": "invoices"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2,
     "backoffMs": 1000
    }
   },
   {
    "id": "open_invoices",
    "kind": "task",
    "needs": [
     "read_invoices"
    ],
    "description": "Keep only open invoices.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read_invoices.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "open"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "aged",
    "kind": "task",
    "needs": [
     "open_invoices"
    ],
    "description": "Add whole days overdue (daysOverdue) from due date to input.now.",
    "tool": "rows.age",
    "args": {
     "rows": {
      "$ref": "nodes.open_invoices.rows"
     },
     "field": "due",
     "now": {
      "$ref": "input.now"
     },
     "unit": "days",
     "as": "daysOverdue"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "staged",
    "kind": "task",
    "needs": [
     "aged"
    ],
    "description": "Label stage 1, 2 or 3 for invoices exactly 3, 10 or 17 days overdue; others get stage 0.",
    "tool": "rows.route",
    "args": {
     "rows": {
      "$ref": "nodes.aged.rows"
     },
     "rules": [
      {
       "field": "daysOverdue",
       "op": "eq",
       "value": 3,
       "set": {
        "stage": 1
       }
      },
      {
       "field": "daysOverdue",
       "op": "eq",
       "value": 10,
       "set": {
        "stage": 2
       }
      },
      {
       "field": "daysOverdue",
       "op": "eq",
       "value": 17,
       "set": {
        "stage": 3
       }
      }
     ],
     "otherwise": {
      "stage": 0
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "due_now",
    "kind": "task",
    "needs": [
     "staged"
    ],
    "description": "Keep invoices that get a reminder today.",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.staged.rows"
     },
     "where": [
      {
       "field": "stage",
       "op": "gt",
       "value": 0
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "stage2_rows",
    "kind": "task",
    "needs": [
     "staged"
    ],
    "description": "Keep invoices getting the second reminder (10 days overdue).",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.staged.rows"
     },
     "where": [
      {
       "field": "stage",
       "op": "eq",
       "value": 2
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "due_emails",
    "kind": "task",
    "needs": [
     "due_now"
    ],
    "description": "List the customer emails receiving a reminder today.",
    "tool": "core.pluck",
    "args": {
     "items": {
      "$ref": "nodes.due_now.rows"
     },
     "field": "email"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "copy_recipients",
    "kind": "task",
    "needs": [
     "stage2_rows"
    ],
    "description": "One row per day-10 invoice, tagged with Dave's address as the copy recipient.",
    "tool": "rows.select",
    "args": {
     "rows": {
      "$ref": "nodes.stage2_rows.rows"
     },
     "fields": [
      "invoice"
     ],
     "set": {
      "copyTo": "dave@midwestpipesupply.com"
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "copy_addresses",
    "kind": "task",
    "needs": [
     "copy_recipients"
    ],
    "description": "List Dave's copy address once per day-10 copy that should be sent.",
    "tool": "core.pluck",
    "args": {
     "items": {
      "$ref": "nodes.copy_recipients.rows"
     },
     "field": "copyTo"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 1
    }
   },
   {
    "id": "send_reminders",
    "kind": "map",
    "needs": [
     "due_now"
    ],
    "description": "Send one reminder to each due invoice's customer email.",
    "items": {
     "$ref": "nodes.due_now.rows"
    },
    "maxItems": 500,
    "concurrency": 1,
    "body": {
     "nodes": [
      {
       "id": "subj",
       "kind": "task",
       "needs": [],
       "description": "Build the reminder subject.",
       "tool": "core.template",
       "args": {
        "text": "Payment reminder {{stage}}: invoice {{invoice}} is overdue",
        "variables": {
         "stage": {
          "$ref": "item.stage"
         },
         "invoice": {
          "$ref": "item.invoice"
         }
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 1
       }
      },
      {
       "id": "body",
       "kind": "task",
       "needs": [],
       "description": "Build the reminder body.",
       "tool": "core.template",
       "args": {
        "text": "Hello {{customer}},\n\nThis is reminder {{stage}} for invoice {{invoice}} ({{amount}}), which was due on {{due}} and is now {{days}} days overdue. Please arrange payment, or reply if there is an issue.\n\nThank you.",
        "variables": {
         "customer": {
          "$ref": "item.customer"
         },
         "stage": {
          "$ref": "item.stage"
         },
         "invoice": {
          "$ref": "item.invoice"
         },
         "amount": {
          "$ref": "item.amount"
         },
         "due": {
          "$ref": "item.due"
         },
         "days": {
          "$ref": "item.daysOverdue"
         }
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 1
       }
      },
      {
       "id": "send",
       "kind": "task",
       "needs": [
        "subj",
        "body"
       ],
       "description": "Send the reminder to the customer.",
       "tool": "outbox.send",
       "args": {
        "to": {
         "$ref": "item.email"
        },
        "subject": {
         "$ref": "nodes.subj.text"
        },
        "body": {
         "$ref": "nodes.body.text"
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 1
       }
      }
     ],
     "acceptance": [
      {
       "op": "eq",
       "left": {
        "$ref": "nodes.send.delivered"
       },
       "right": true
      }
     ]
    }
   },
   {
    "id": "send_copies",
    "kind": "map",
    "needs": [
