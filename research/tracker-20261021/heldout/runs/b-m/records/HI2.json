 },
 "workflow": {
  "schemaVersion": "1.0",
  "id": "invoice-chase",
  "version": 1,
  "title": "Invoice reminders",
  "goal": "Each run, e-mail every customer whose open invoice is overdue the reminder its age calls for (a friendly reminder once an invoice is 3 days late, a second reminder at 10 days, a final notice at 17 days), never twice for the same stage, after a person approves each send.",
  "domain": "general",
  "envelope": {
   "assumptions": [
    "The invoices sheet holds one row per invoice with invoice, customer, email, amount, due (YYYY-MM-DD) and status (open, paid or disputed)",
    "Delivery is a local outbox file standing in for e-mail; nothing leaves this machine"
   ],
   "risks": [
    "Chasing a customer who already paid or disputes the invoice",
    "Sending the same reminder twice",
    "Sending a reminder to the wrong address"
   ],
   "successCriteria": [
    "Every overdue open invoice got the reminder its age calls for",
    "This run delivered exactly the planned reminders, each intact (checked by re-reading the outbox)"
   ],
   "unsupported": [
    "Payments",
    "Changing the invoices sheet",
    "Running on a schedule by itself"
   ]
  },
  "inputSchema": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "now"
   ],
   "properties": {
    "now": {
     "type": "string",
     "minLength": 10,
     "maxLength": 40
    }
   }
  },
  "budget": {
   "maxSteps": 4000,
   "maxConcurrency": 2,
   "maxDurationMs": 300000,
   "maxCost": 0
  },
  "state": {
   "reminded": {
    "type": "set",
    "writer": "mark",
    "maxItems": 100000,
    "ttlDays": 400,
    "description": "invoice|stage pairs already reminded"
   }
  },
  "nodes": [
   {
    "id": "read",
    "kind": "task",
    "needs": [],
    "description": "Read the invoices sheet",
    "tool": "sheet.read",
    "args": {
     "sheet": "invoices"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "open",
    "kind": "task",
    "needs": [
     "read"
    ],
    "description": "Keep open invoices only (not paid, not disputed)",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.read.rows"
     },
     "where": [
      {
       "field": "status",
       "op": "eq",
       "value": "open"
      },
      {
       "field": "email",
       "op": "exists"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "aged",
    "kind": "task",
    "needs": [
     "open"
    ],
    "description": "Work out how many days late each open invoice is",
    "tool": "rows.age",
    "args": {
     "rows": {
      "$ref": "nodes.open.rows"
     },
     "field": "due",
     "now": {
      "$ref": "input.now"
     },
     "unit": "days",
     "as": "daysLate"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "staged",
    "kind": "task",
    "needs": [
     "aged"
    ],
    "description": "Decide which reminder each invoice is due for",
    "tool": "rows.route",
    "args": {
     "rows": {
      "$ref": "nodes.aged.rows"
     },
     "rules": [
      {
       "field": "daysLate",
       "op": "gte",
       "value": 17,
       "set": {
        "stage": "final notice",
        "subjectPrefix": "Final notice",
        "opening": "This is a final notice."
       }
      },
      {
       "field": "daysLate",
       "op": "gte",
       "value": 10,
       "set": {
        "stage": "second reminder",
        "subjectPrefix": "Second reminder",
        "opening": "This is our second reminder."
       }
      },
      {
       "field": "daysLate",
       "op": "gte",
       "value": 3,
       "set": {
        "stage": "reminder",
        "subjectPrefix": "Friendly reminder",
        "opening": "Just a friendly reminder."
       }
      }
     ],
     "otherwise": {
      "stage": "none",
      "subjectPrefix": "",
      "opening": ""
     }
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "due",
    "kind": "task",
    "needs": [
     "staged"
    ],
    "description": "Keep the invoices due for a reminder",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.staged.rows"
     },
     "where": [
      {
       "field": "stage",
       "op": "ne",
       "value": "none"
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "remind",
    "kind": "map",
    "needs": [
     "due"
    ],
    "description": "Remind each customer once per stage",
    "items": {
     "$ref": "nodes.due.rows"
    },
    "maxItems": 500,
    "concurrency": 1,
    "body": {
     "nodes": [
      {
       "id": "plan",
       "kind": "task",
       "needs": [],
       "description": "Note who this reminder is for",
       "tool": "core.identity",
       "args": {
        "to": {
         "$ref": "item.email"
        },
        "invoice": {
         "$ref": "item.invoice"
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 2
       }
      },
      {
       "id": "key",
       "kind": "task",
       "needs": [],
       "description": "Name this invoice and stage",
       "tool": "core.template",
       "args": {
        "text": "{{invoice}}|{{stage}}",
        "variables": {
         "invoice": {
          "$ref": "item.invoice"
         },
         "stage": {
          "$ref": "item.stage"
         }
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 2
       }
      },
      {
       "id": "mark",
       "kind": "state",
       "needs": [
        "key"
       ],
       "description": "Remember this reminder; skip it if it was sent before",
       "slot": "reminded",
       "op": "add",
       "key": {
        "$ref": "nodes.key.text"
       }
      },
      {
       "id": "compose",
       "kind": "task",
       "needs": [],
       "description": "Write the reminder",
       "tool": "core.template",
       "args": {
        "text": "Hello {{customer}},\n\n{{opening}} Invoice {{invoice}} for {{amount}} was due on {{due}} ({{days}} days ago) and we have not received payment yet.\n\nIf you have already paid, please ignore this message. If something about the invoice is wrong, just reply and we will sort it out.\n\nThank you,\nAccounts team",
        "variables": {
         "customer": {
          "$ref": "item.customer"
         },
         "opening": {
          "$ref": "item.opening"
         },
         "invoice": {
          "$ref": "item.invoice"
         },
         "amount": {
          "$ref": "item.amount"
         },
         "due": {
          "$ref": "item.due"
         },
         "days": {
          "$ref": "item.daysLate"
         }
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 2
       }
      },
      {
       "id": "subject",
       "kind": "task",
       "needs": [],
       "description": "Write the subject line",
       "tool": "core.template",
       "args": {
        "text": "{{prefix}}: invoice {{invoice}}",
        "variables": {
         "prefix": {
          "$ref": "item.subjectPrefix"
         },
         "invoice": {
          "$ref": "item.invoice"
         }
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 2
       }
      },
      {
       "id": "send",
       "kind": "task",
       "needs": [
        "mark",
        "compose",
        "subject",
        "plan"
       ],
       "when": {
        "op": "eq",
        "left": {
         "$ref": "nodes.mark.added"
        },
        "right": true
       },
       "description": "E-mail the reminder to the customer (asks you first)",
       "tool": "outbox.send",
       "args": {
        "to": {
         "$ref": "nodes.plan.to"
        },
        "subject": {
         "$ref": "nodes.subject.text"
        },
        "body": {
         "$ref": "nodes.compose.text"
        }
       },
       "timeoutMs": 10000,
       "retry": {
        "maxAttempts": 1
       }
      }
     ],
     "acceptance": [
      {
       "op": "any",
       "conditions": [
        {
         "op": "eq",
         "left": {
          "$ref": "nodes.mark.added"
         },
         "right": false
        },
        {
         "op": "eq",
         "left": {
          "$ref": "nodes.send.delivered",
          "default": false
         },
         "right": true
        }
       ]
      }
     ]
    }
   },
   {
    "id": "fresh",
    "kind": "task",
    "needs": [
     "remind"
    ],
    "description": "List the reminders this run actually sent",
    "tool": "rows.filter",
    "args": {
     "rows": {
      "$ref": "nodes.remind.items"
     },
     "where": [
      {
       "field": "mark.added",
       "op": "eq",
       "value": true
      }
     ]
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "expected",
    "kind": "task",
    "needs": [
     "fresh"
    ],
    "description": "Who should have received a reminder this run",
    "tool": "core.pluck",
    "args": {
     "items": {
      "$ref": "nodes.fresh.rows"
     },
     "field": "plan.to"
    },
    "timeoutMs": 10000,
    "retry": {
     "maxAttempts": 2
    }
   },
   {
    "id": "audit",
    "kind": "verify",
    "needs": [
     "expected"
    ],
    "description": "Re-read the outbox: exactly the planned e-mails went out this run, each intact",
    "method": "capability",
    "tool": "outbox.audit",
    "args": {
     "to": [
      {
       "$ref": "nodes.expected.items"
      },
      []
     ]
    },
    "subject": {
     "$ref": "nodes.remind"
    },
    "independence": "execution",
    "gate": true,
    "timeoutMs": 10000
   }
  ],
  "acceptance": [
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.remind.count"
    },
    "right": {
     "$ref": "nodes.due.count"
    }
   },
   {
    "op": "eq",
    "left": {
     "$ref": "nodes.audit.pass"
    },
    "right": true
   }
  ],
