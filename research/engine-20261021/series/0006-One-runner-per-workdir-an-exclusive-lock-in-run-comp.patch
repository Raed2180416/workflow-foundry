diff --git a/experiments/lib/workdir-lock.mjs b/experiments/lib/workdir-lock.mjs
new file mode 100644
index 0000000..af9b9a2
--- /dev/null
+++ b/experiments/lib/workdir-lock.mjs
@@ -0,0 +1,54 @@
+// One runner per workdir (orch-20261021 rank 12, chaos F1): two orchestrators that ran compiled solvers in one shared workdir both
+// reported "ok" with each other's traces and answers mixed in. A runner now takes an exclusive lock file in the workdir before it
+// writes anything there; a second runner, in this process or another, is refused (WORKDIR_BUSY) while the holder lives.
+//
+// Creation is atomic and complete: the record is written to a private file opened O_EXCL, then hard-linked to the lock name, which
+// fails with EEXIST exactly as an O_EXCL open would, so no runner ever reads a half-written lock. A lock whose holder is gone (its
+// pid is dead, or now belongs to another process: the start time differs) is stale and taken over: it is renamed aside first, so of
+// two runners that find it stale only one moves it, and both then race for a fresh link.
+//
+//   const lock = lockWorkdir(dir, { label });   // -> { ok: true, release() } | { ok: false, holder: {pid, label, at} }
+import { closeSync, linkSync, mkdirSync, openSync, readFileSync, renameSync, rmSync, writeSync } from 'node:fs';
+import { randomUUID } from 'node:crypto';
+import path from 'node:path';
+import { startOf } from '../../src/children.mjs';
+
+export const LOCK_FILE = '.foundry-workdir.lock';
+
+const alive = pid => { try { process.kill(pid, 0); return true; } catch (error) { return error.code === 'EPERM'; } };
+// The holder still runs: its pid answers and, where /proc gives start times, it is the same process (not a reused pid).
+function holds(record) {
+  if (!Number.isInteger(record?.pid) || !alive(record.pid)) return false;
+  const start = startOf(record.pid);
+  return record.start == null || start == null || start === record.start;
+}
+const readLock = file => { try { return JSON.parse(readFileSync(file, 'utf8')); } catch { return null; } };
+
+export function lockWorkdir(workdir, { label = null } = {}) {
+  mkdirSync(workdir, { recursive: true });
+  const file = path.join(workdir, LOCK_FILE), token = randomUUID(), mine = `${file}.${token}`;
+  const record = { pid: process.pid, start: startOf(process.pid), token, label, at: Date.now() };
+  const fd = openSync(mine, 'wx', 0o600);
+  try { writeSync(fd, JSON.stringify(record)); } finally { closeSync(fd); }
+  try {
+    for (let tries = 0; tries < 4; tries++) {
+      try { linkSync(mine, file); }
+      catch (error) {
+        if (error.code !== 'EEXIST') throw error;
+        const held = readLock(file);
+        if (held && holds(held)) return { ok: false, holder: { pid: held.pid, label: held.label ?? null, at: held.at ?? null } };
+        // Stale (or unreadable, which a linked lock never is): move it aside and race again for a fresh link.
+        const aside = `${file}.stale-${token}-${tries}`;
+        try { renameSync(file, aside); rmSync(aside, { force: true }); } catch (e) { if (e.code !== 'ENOENT') throw e; }
+        continue;
+      }
+      return {
+        ok: true, file, token,
+        // Released only by its holder, and only while the lock is still its own (never another runner's).
+        release() { if (readLock(file)?.token === token) rmSync(file, { force: true }); },
+      };
+    }
+    const held = readLock(file);
+    return { ok: false, holder: { pid: held?.pid ?? null, label: held?.label ?? null, at: held?.at ?? null } };
+  } finally { rmSync(mine, { force: true }); }
+}
diff --git a/experiments/lib/workdir-lock.test.mjs b/experiments/lib/workdir-lock.test.mjs
new file mode 100644
index 0000000..dbfef90
--- /dev/null
+++ b/experiments/lib/workdir-lock.test.mjs
@@ -0,0 +1,51 @@
+// One runner per workdir (orch-20261021 rank 12, chaos F1). $0, local files and one short-lived child process only.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { existsSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { spawn } from 'node:child_process';
+import { lockWorkdir, LOCK_FILE } from './workdir-lock.mjs';
+import { startOf } from '../../src/children.mjs';
+
+const scratch = t => { const dir = mkdtempSync(path.join(tmpdir(), 'wd-lock-')); t.after(() => rmSync(dir, { recursive: true, force: true })); return dir; };
+
+test('a second runner in the same process is refused while the first holds the workdir; release frees it', t => {
+  const dir = path.join(scratch(t), 'w');
+  const a = lockWorkdir(dir, { label: 'A' });
+  assert.equal(a.ok, true);
+  const b = lockWorkdir(dir, { label: 'B' });
+  assert.equal(b.ok, false); assert.equal(b.holder.pid, process.pid); assert.equal(b.holder.label, 'A');
+  a.release();
+  assert.equal(existsSync(path.join(dir, LOCK_FILE)), false);
+  const c = lockWorkdir(dir, { label: 'C' });
+  assert.equal(c.ok, true); c.release();
+  assert.deepEqual(readdirSync(dir), [], 'no temporary or stale files are left behind');
+});
+
+test('a lock whose holder is gone is taken over; a live holder in another process is refused; release never removes another runner\'s lock', async t => {
+  const dir = path.join(scratch(t), 'w');
+  const sleeper = spawn(process.execPath, ['-e', 'setTimeout(() => {}, 20000)'], { stdio: 'ignore' });
+  t.after(() => { try { sleeper.kill('SIGKILL'); } catch {} });
+  await new Promise(resolve => sleeper.once('spawn', resolve));
+  const file = path.join(dir, LOCK_FILE);
+  const first = lockWorkdir(dir); first.release();
+  // Held by another live process (same start time as on record): refused.
+  writeFileSync(file, JSON.stringify({ pid: sleeper.pid, start: startOf(sleeper.pid), token: 'other', label: 'elsewhere', at: Date.now() }));
+  const refused = lockWorkdir(dir);
+  assert.equal(refused.ok, false); assert.equal(refused.holder.label, 'elsewhere');
+  // The same pid with another start time is a reused pid: stale.
+  if (startOf(sleeper.pid) !== null) {
+    writeFileSync(file, JSON.stringify({ pid: sleeper.pid, start: '1', token: 'reused', label: 'old', at: 1 }));
+    const taken = lockWorkdir(dir);
+    assert.equal(taken.ok, true, 'a reused pid does not hold the lock');
+    // Another runner's lock replaces ours behind our back: our release leaves it alone.
+    writeFileSync(file, JSON.stringify({ pid: sleeper.pid, start: startOf(sleeper.pid), token: 'theirs', label: 'theirs', at: Date.now() }));
+    taken.release();
+    assert.equal(JSON.parse(readFileSync(file, 'utf8')).token, 'theirs');
+  }
+  // A dead holder: stale, taken over.
+  sleeper.kill('SIGKILL'); await new Promise(resolve => sleeper.once('exit', resolve));
+  const after = lockWorkdir(dir);
+  assert.equal(after.ok, true); after.release();
+});
