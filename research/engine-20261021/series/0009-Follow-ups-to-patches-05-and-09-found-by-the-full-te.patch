diff --git a/src/children.mjs b/src/children.mjs
index 05fe114..78ac67f 100644
--- a/src/children.mjs
+++ b/src/children.mjs
@@ -18,6 +18,9 @@ import { existsSync, readdirSync, readFileSync } from 'node:fs';
 const SETPRIV = process.platform === 'linux' ? (['/usr/bin/setpriv', '/bin/setpriv'].find(p => { try { return existsSync(p); } catch { return false; } }) ?? null) : null;
 /** [command, args] for spawn(): `command` wrapped so that it dies with the process that spawns it (see SETPRIV); unchanged without setpriv. */
 export function lifeline(command, args) { return SETPRIV ? [SETPRIV, ['--pdeathsig', 'KILL', '--', command, ...args]] : [command, args]; }
+/** Did setpriv itself fail to exec the wrapped command (it exits 126/127 and says so)? That is a launch failure of the command, as a spawn
+ *  ENOENT/EACCES was before the lifeline wrapped it, never a run of the command that failed. */
+export const lifelineExecFailed = (code, stderr = '') => !!SETPRIV && (code === 126 || code === 127) && /^setpriv: failed to execute /m.test(String(stderr));
 
 /** Set by the runtime around a sandbox or model call: {add(child), remove(pid)}. */
 export const childScope = new AsyncLocalStorage();
diff --git a/src/process.mjs b/src/process.mjs
index a457846..79be5d7 100644
--- a/src/process.mjs
+++ b/src/process.mjs
@@ -1,7 +1,7 @@
 import { spawn } from 'node:child_process';
 import { StringDecoder } from 'node:string_decoder';
 import { FoundryError } from './data.mjs';
-import { lifeline, trackChild } from './children.mjs';
+import { lifeline, lifelineExecFailed, trackChild } from './children.mjs';
 
 /** Bounded argv-only subprocess. No shell parsing or inherited credential env. */
 export async function runProcess(command, args, { cwd, env, input = '', timeoutMs = 60000, signal, maxBytes = 4 * 1024 * 1024 } = {}) {
@@ -41,6 +41,8 @@ export async function runProcess(command, args, { cwd, env, input = '', timeoutM
       if (failure) kill();
       const result = { command, args, code, signal: terminationSignal, stdout, stderr, elapsedMs: Date.now() - startedAt };
       if (failure) { failure.processResult = result; reject(failure); }
+      // The lifeline (setpriv) could not exec the command: a launch failure, as the spawn error was before the wrapper (patch 05 follow-up).
+      else if (lifelineExecFailed(code, stderr)) { const error = new FoundryError('PROCESS_LAUNCH', `${command} could not be launched: ${stderr.trim().split('\n').at(-1).slice(0, 200)}`); error.processResult = result; reject(error); }
       else if (code !== 0) { const error = new FoundryError('PROCESS_FAILED', `${command} exited with ${code ?? terminationSignal}`); error.processResult = result; reject(error); }
       else resolve(result);
     });
