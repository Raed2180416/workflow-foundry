diff -ruN a/tests/cancellation.test.mjs b/tests/cancellation.test.mjs
--- a/tests/cancellation.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/cancellation.test.mjs	2026-11-04 14:33:20.047848465 +0000
@@ -0,0 +1,73 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { programHarness } from './helpers/program.mjs';
+
+const cx = programHarness('cancellation');
+const F1 = 'ORD-1-F1', F2 = 'ORD-1-F2';
+const T = '2026-03-02T10:00:00+01:00';
+const CANCEL = '2026-03-02T11:00:00+01:00';
+// A fulfilment as its module holds it: running, with the given reports and nothing committed yet.
+const fulfilmentWith = reports => ({ orderId: 'ORD-1', fid: F1, customerId: 'C-1', currency: 'EUR', edition: 'ed-2026-1', location: 'WH-AMS',
+  items: [{ sku: 'A', qty: 1 }], amountMinor: 299, phase: 'running', batches: 0, reserve: { A: 'none' }, charge: 'none', ship: 'none',
+  shipUndo: 'none', refund: 'none', collectionFailed: false, dispatched: false, reports, end: null, endedAt: null });
+const base = (statuses, reports = [], fulfilmentStates = {}) => ({
+  key: 'ORD-1', state: null, now: CANCEL,
+  states: {
+    statuses: { 'ORD-1': statuses },
+    'order-progress': { 'ORD-1': { state: 'processing', outcome: null, at: T } },
+    notices: { 'ORD-1': { customerId: 'C-1', sent: [] } },
+    fulfilment: { [F1]: fulfilmentWith(reports), ...fulfilmentStates },
+  },
+});
+const processing = { order: 'processing', fulfilments: { [F1]: 'processing', [F2]: 'pending' } };
+const cancel = (phase, eventId = 'ev-9') => ({ op: 'customer-cancel', orderId: 'ORD-1', at: CANCEL, eventId, phase, fulfilmentIds: [F1, F2] });
+const noticeKeys = r => r.effects.filter(e => e.system === 'notify').map(e => e.key);
+const statusSets = r => r.effects.filter(e => e.system === 'orders').map(e => `${e.args.fulfilmentId ?? 'order'}=${e.args.status}`);
+
+test('a cancel before clearing counts: the order and its fulfilments are cancelled, one notice (R6.4)', () => {
+  const statuses = { order: 'pending', fulfilments: { [F1]: 'pending', [F2]: 'unavailable' } };
+  const r = cx.step(cancel('not-cleared'), base(statuses));
+  assert.equal(r.output.verdict, 'counts');
+  assert.deepEqual(statusSets(r), [`${F1}=cancelled`, `${F2}=cancelled`, 'order=cancelled']);
+  assert.deepEqual(noticeKeys(r), ['order-cancelled.ORD-1']);
+});
+
+test('a collection reported before the cancel refuses it: cancel-refused, nothing else (R6.3, S7)', () => {
+  const r = cx.step(cancel('processing'), base(processing, [{ meaning: 'collected', reportedAt: T }]));
+  assert.equal(r.output.verdict, 'refused');
+  assert.deepEqual(noticeKeys(r), ['cancel-refused.ev-9']);
+  assert.equal(statusSets(r).length, 0);
+});
+
+test('a report of transit or delivery also proves collection (S7)', () => {
+  for (const meaning of ['inTransit', 'delivered']) {
+    const r = cx.step(cancel('processing'), base(processing, [{ meaning, reportedAt: T }]));
+    assert.equal(r.output.verdict, 'refused', meaning);
+  }
+});
+
+test('a collection in the same instant as the cancel wins (S4, S7)', () => {
+  const r = cx.step(cancel('processing'), base(processing, [{ meaning: 'collected', reportedAt: CANCEL }]));
+  assert.equal(r.output.verdict, 'refused');
+});
+
+test('no collection before the cancel: it counts, every open fulfilment is stopped and cancelled (R6.2)', () => {
+  const r = cx.step(cancel('processing'), base(processing, [{ meaning: 'collected', reportedAt: '2026-03-02T12:00:00+01:00' }]));
+  assert.equal(r.output.verdict, 'counts');
+  assert.deepEqual(statusSets(r), [`${F1}=cancelled`, `${F2}=cancelled`, 'order=cancelled']);
+  assert.deepEqual(noticeKeys(r), ['order-cancelled.ORD-1']);
+});
+
+test('an ended order changes nothing (R6.3, S15)', () => {
+  const r = cx.step(cancel('ended'), base({ order: 'completed', fulfilments: { [F1]: 'completed' } }));
+  assert.equal(r.output.verdict, 'nothing');
+  assert.equal(r.effects.length, 0);
+});
+
+test('cancel-order cancels the open fulfilments and the order with its reason (R6.1)', () => {
+  const r = cx.step({ op: 'cancel-order', orderId: 'ORD-1', at: CANCEL, reason: 'fraud' },
+    base({ order: 'pending', fulfilments: { [F1]: 'pending', [F2]: 'pending' } }));
+  assert.equal(r.output.verdict, 'done');
+  assert.equal(r.output.reason, 'fraud');
+  assert.deepEqual(statusSets(r), [`${F1}=cancelled`, `${F2}=cancelled`, 'order=cancelled']);
+});
diff -ruN a/tests/customer-action.test.mjs b/tests/customer-action.test.mjs
--- a/tests/customer-action.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/customer-action.test.mjs	2026-11-04 14:33:20.048055982 +0000
@@ -0,0 +1,68 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { programHarness } from './helpers/program.mjs';
+
+const ca = programHarness('customer-action');
+const P = '2026-03-02T09:30:00+01:00';            // p; D = p + 4 h = 2026-03-02T12:30:00Z
+const D = '2026-03-02T12:30:00.000Z';
+const files = { 'rulebook/ed-2026-1/policy.json': JSON.stringify({ customerActionHours: 4, fraudReviewHours: 24, collectionCutoffMinutes: 30 }) };
+const fulfilments = [{ fulfilmentId: 'ORD-1-F1', available: true }, { fulfilmentId: 'ORD-1-F2', available: false }];
+const statuses = { 'ORD-1': { order: 'pending', fulfilments: { 'ORD-1-F1': 'pending', 'ORD-1-F2': 'unavailable' } } };
+const opts = (state, extra = {}) => ({ key: 'ORD-1', state, now: P, files, states: { statuses, notices: {} }, ...extra });
+const start = (fs = fulfilments) => ca.step({ op: 'start', orderId: 'ORD-1', placedAt: P, edition: 'ed-2026-1', fulfilments: fs }, opts(null));
+const waiting = () => ca.step({ op: 'advance', clearedAt: P }, opts(start().state)).state;
+const sets = r => r.effects.filter(e => e.system === 'orders' && e.op === 'setStatus').map(e => `${e.args.fulfilmentId ?? 'order'}=${e.args.status}`);
+
+test('nothing unavailable: no wake-up, nothing to do (R3.1)', () => {
+  const r = start([{ fulfilmentId: 'ORD-1-F1', available: true }]);
+  assert.equal(r.output.state, 'inert');
+  assert.equal(r.obligations.upsert.length, 0);
+});
+
+test('an unavailable item sets the deadline D = p + customerActionHours, with a wake-up just after D (R3.2, S1)', () => {
+  const r = start();
+  assert.equal(r.output.state, 'review');
+  assert.equal(r.obligations.upsert[0].id, 'deadline');
+  assert.equal(r.obligations.upsert[0].dueAt, '2026-03-02T13:00:00.000Z');
+});
+
+test('after clearing: customerActionRequired and action-required, within the window (R3.1)', () => {
+  const r = ca.step({ op: 'advance', clearedAt: P }, opts(start().state));
+  assert.equal(r.output.state, 'waiting');
+  assert.deepEqual(sets(r), ['order=customerActionRequired']);
+  assert.equal(r.effects.find(e => e.system === 'notify').args.template, 'action-required');
+});
+
+test('an amend at D counts: the unavailable items are cancelled and the order is ready (R3.2)', () => {
+  const r = ca.step({ op: 'action', action: 'amend', at: D }, opts(waiting()));
+  assert.equal(r.output.state, 'ready');
+  assert.deepEqual(sets(r), ['ORD-1-F2=cancelled']);
+});
+
+test('an action after D changes nothing (R3.2)', () => {
+  const r = ca.step({ op: 'action', action: 'cancel', at: '2026-03-02T12:30:01.000Z' }, opts(waiting()));
+  assert.equal(r.output.state, 'waiting');
+  assert.equal(r.effects.length, 0);
+});
+
+test('a cancel counts with reason customer and the wake-up is withdrawn (R3.2)', () => {
+  const r = ca.step({ op: 'action', action: 'cancel', at: '2026-03-02T11:00:00.000Z' }, opts(waiting()));
+  assert.equal(r.output.state, 'cancel');
+  assert.equal(r.output.reason, 'customer');
+  assert.deepEqual(r.obligations.cancel, ['deadline']);
+});
+
+test('an amend with nothing available cancels the order for nothing-available (R3.2)', () => {
+  const s = start([{ fulfilmentId: 'ORD-1-F2', available: false }]).state;
+  const r = ca.step({ op: 'action', action: 'amend', at: '2026-03-02T11:00:00.000Z' }, opts(s));
+  assert.equal(r.output.state, 'cancel');
+  assert.equal(r.output.reason, 'nothing-available');
+});
+
+test('nothing counted by D: after D every fulfilment cancelled, the order timed out, one notice (R3.2)', () => {
+  const r = ca.onEvent({ type: 'timer.fired', at: '2026-03-02T13:00:00.000Z', payload: { obligationId: 'deadline' } },
+    opts(waiting()));
+  assert.equal(r.output.state, 'timedOut');
+  assert.deepEqual(sets(r).sort(), ['ORD-1-F1=cancelled', 'ORD-1-F2=cancelled', 'order=timedOut']);
+  assert.equal(r.effects.find(e => e.system === 'notify').args.template, 'order-timed-out');
+});
diff -ruN a/tests/fraud.test.mjs b/tests/fraud.test.mjs
--- a/tests/fraud.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/fraud.test.mjs	2026-11-04 14:33:20.048100846 +0000
@@ -0,0 +1,69 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { moduleHarness } from '../compose-kit/kit.mjs';
+
+const fraud = moduleHarness('fraud');
+const NOW = '2026-03-02T10:00:00+01:00';
+const P = '2026-03-02T09:30:00+01:00';
+const files = { 'rulebook/ed-2026-1/policy.json': JSON.stringify({ customerActionHours: 4, fraudReviewHours: 24, collectionCutoffMinutes: 30 }) };
+const check = verdict => ({ type: 'effect.result', at: NOW, payload: { key: 'check', system: 'fraud', op: 'check', status: 'ok', verdict } });
+const started = () => fraud.step({ op: 'start', orderId: 'ORD-1', placedAt: P, edition: 'ed-2026-1' }, { key: 'ORD-1', state: null, now: NOW, files });
+
+test('a new order is checked for fraud (R2.1)', () => {
+  const r = started();
+  assert.deepEqual(r.effects.map(e => `${e.system}.${e.op}`), ['fraud.check']);
+  assert.equal(r.output.state, 'checking');
+});
+
+test('pass clears the order at p (R2.1)', () => {
+  const r = fraud.onEvent(check('pass'), { key: 'ORD-1', state: started().state, now: NOW, files });
+  assert.equal(r.output.state, 'cleared');
+  assert.equal(r.output.at, P);
+});
+
+test('reject cancels for fraud (R2.1)', () => {
+  const r = fraud.onEvent(check('reject'), { key: 'ORD-1', state: started().state, now: NOW, files });
+  assert.equal(r.output.state, 'cancel');
+  assert.equal(r.output.reason, 'fraud');
+});
+
+test('review opens one fraudReview task, due at the review deadline, and a wake-up after it (R2.2)', () => {
+  const r = fraud.onEvent(check('review'), { key: 'ORD-1', state: started().state, now: NOW, files });
+  assert.equal(r.humanTasks.length, 1);
+  assert.equal(r.humanTasks[0].kind, 'fraudReview');
+  assert.equal(r.humanTasks[0].role, 'fraudAnalyst');
+  assert.equal(r.humanTasks[0].dueAt, '2026-03-03T09:00:00.000Z');
+  assert.equal(r.obligations.upsert[0].id, 'deadline');
+  assert.ok(Date.parse(r.obligations.upsert[0].dueAt) > Date.parse(r.humanTasks[0].dueAt));
+});
+
+const reviewing = () => fraud.onEvent(check('review'), { key: 'ORD-1', state: started().state, now: NOW, files }).state;
+const answer = (decision, at) => ({ type: 'humanTask.answered', at, payload: { taskId: 'ORD-1/K/review-1', user: 'u', answer: { decision } } });
+
+test('an approve at the deadline still counts (R2.2)', () => {
+  const r = fraud.onEvent(answer('approve', '2026-03-03T09:00:00.000Z'), { key: 'ORD-1', state: reviewing(), now: '2026-03-03T09:00:00.000Z', files });
+  assert.equal(r.output.state, 'cleared');
+});
+
+test('an answer after the deadline changes nothing; the timeout cancels after it (R2.2)', () => {
+  const late = fraud.onEvent(answer('approve', '2026-03-03T09:00:01.000Z'), { key: 'ORD-1', state: reviewing(), now: '2026-03-03T09:00:01.000Z', files });
+  assert.equal(late.output.state, 'review');
+  const timeout = fraud.onEvent({ type: 'timer.fired', at: '2026-03-03T09:30:00.000Z', payload: { obligationId: 'ORD-1/K/deadline' } },
+    { key: 'ORD-1', state: reviewing(), now: '2026-03-03T09:30:00.000Z', files });
+  assert.equal(timeout.output.state, 'cancel');
+  assert.equal(timeout.output.reason, 'fraud-review-timeout');
+});
+
+test('asking again opens a new task and keeps the deadline (R2.2, S3)', () => {
+  const r = fraud.onEvent({ type: 'humanTask.answerRejected', at: NOW, payload: { taskId: 'ORD-1/K/review-1' } },
+    { key: 'ORD-1', state: reviewing(), now: NOW, files });
+  assert.equal(r.humanTasks[0].id, 'review-2');
+  assert.equal(r.humanTasks[0].dueAt, '2026-03-03T09:00:00.000Z');
+});
+
+test('a stop from cancellation ends the review: a later answer changes nothing (R6.4)', () => {
+  const s = fraud.step({ op: 'stop' }, { key: 'ORD-1', state: reviewing(), now: NOW, files });
+  const r = fraud.onEvent(answer('approve', NOW), { key: 'ORD-1', state: s.state, now: NOW, files });
+  assert.equal(r.output.state, 'stopped');
+  assert.deepEqual(s.obligations.cancel, ['deadline']);
+});
diff -ruN a/tests/fulfilment.test.mjs b/tests/fulfilment.test.mjs
--- a/tests/fulfilment.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/fulfilment.test.mjs	2026-11-04 14:33:20.048143584 +0000
@@ -0,0 +1,129 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { programHarness } from './helpers/program.mjs';
+
+const fx = programHarness('fulfilment');
+const FID = 'ORD-1-F1';
+const T = '2026-03-02T10:00:00+01:00';
+const T2 = '2026-03-02T11:00:00+01:00';
+const files = { 'rulebook/ed-2026-1/carrier-codes.json': JSON.stringify([
+  { carrier: 'PARCELLA', code: 'COLLECTED', meaning: 'collected' },
+  { carrier: 'PARCELLA', code: 'DELIVERED', meaning: 'delivered' },
+  { carrier: 'PARCELLA', code: 'NOT_COLLECTED', meaning: 'collectionFailed' },
+]) };
+const statuses = { 'ORD-1': { order: 'processing', fulfilments: { [FID]: 'processing' } } };
+const notices = { 'ORD-1': { customerId: 'C-1', sent: [] } };
+const start = { op: 'start', orderId: 'ORD-1', customerId: 'C-1', currency: 'EUR', edition: 'ed-2026-1',
+  fulfilment: { fulfilmentId: FID, location: 'WH-AMS', items: [{ sku: 'A', qty: 2 }, { sku: 'B', qty: 1 }], amountMinor: 2093 } };
+const opts = (state, extra = {}) => ({ key: FID, state, now: T, files, states: { statuses, notices }, ...extra });
+const eff = (r, op) => r.effects.find(e => e.op === op);
+const result = (key, system, op, status, extra = {}) => ({ type: 'effect.result', at: T2, payload: { key, system, op, status, ...extra } });
+const reserveOk = { type: 'effect.result', at: T2, payload: { system: 'inventory', op: 'reserve', status: 'ok',
+  items: [{ key: 'item.A', status: 'ok' }, { key: 'item.B', status: 'ok' }] } };
+// The state after the reservation and the charge are committed, and the shipment is booked.
+function booked() {
+  let s = fx.step(start, opts(null)).state;
+  s = fx.step({ op: 'advance' }, opts(s)).state;
+  s = fx.onEvent(reserveOk, opts(s)).state;
+  s = fx.onEvent(result('charge', 'billing', 'charge', 'ok'), opts(s)).state;
+  return fx.onEvent(result('ship', 'carrier', 'create', 'ok'), opts(s)).state;
+}
+
+test('reserve is one batch whose items carry the keys, no batch key (R4.2, §2)', () => {
+  const s = fx.step(start, opts(null)).state;
+  const r = fx.step({ op: 'advance' }, opts(s));
+  assert.equal(r.effects.length, 1);
+  assert.equal(r.effects[0].key, undefined);
+  assert.deepEqual(r.effects[0].args.items.map(i => i.key), ['item.A', 'item.B']);
+  assert.equal(r.effects[0].args.location, 'WH-AMS');
+});
+
+test('the charge follows a committed reservation; the shipment follows a committed charge (R4.2)', () => {
+  const s = fx.step(start, opts(null)).state;
+  const reserved = fx.onEvent(reserveOk, opts(fx.step({ op: 'advance' }, opts(s)).state));
+  assert.equal(eff(reserved, 'charge').args.amountMinor, 2093);
+  assert.equal(eff(reserved, 'charge').key, 'charge');
+  const charged = fx.onEvent(result('charge', 'billing', 'charge', 'ok'), opts(reserved.state));
+  assert.equal(eff(charged, 'create').key, 'ship');
+  assert.equal(eff(charged, 'create').args.ref, FID);
+});
+
+test('a partial batch resubmits only the failed items, with their original keys (R4.2)', () => {
+  const s = fx.step(start, opts(null)).state;
+  const partial = { type: 'effect.result', at: T2, payload: { system: 'inventory', op: 'reserve', status: 'partial',
+    items: [{ key: 'item.A', status: 'ok' }, { key: 'item.B', status: 'error', error: { code: 503, reason: 'busy', retryable: true } }] } };
+  const r = fx.onEvent(partial, opts(fx.step({ op: 'advance' }, opts(s)).state));
+  assert.equal(r.effects.length, 1);
+  assert.deepEqual(r.effects[0].args.items.map(i => i.key), ['item.B']);
+});
+
+test('a declined card fails the fulfilment: release what committed, no refund, notice (R5.2, R5.1)', () => {
+  const declined = fx.onEvent(result('charge', 'billing', 'charge', 'error', { error: { code: 402, reason: 'card-declined', retryable: false } }),
+    opts(fx.onEvent(reserveOk, opts(fx.step({ op: 'advance' }, opts(fx.step(start, opts(null)).state)).state)).state));
+  assert.equal(declined.output.state, 'failed');
+  // the failure is noticed once, and only the reserved items are released (the charge did not commit)
+  assert.deepEqual(declined.effects.map(e => e.key), ['f.ORD-1-F1.failed', 'fulfilment-failed.ORD-1-F1', 'release.A', 'release.B']);
+  assert.equal(declined.effects.some(e => e.op === 'refund' || e.op === 'cancel'), false);
+});
+
+test('a 400 is our own mistake: the same step is re-issued, not failed (R4.2)', () => {
+  const s = fx.onEvent(reserveOk, opts(fx.step({ op: 'advance' }, opts(fx.step(start, opts(null)).state)).state)).state;
+  const r = fx.onEvent(result('charge', 'billing', 'charge', 'error', { error: { code: 400, reason: 'field-renamed', retryable: false } }), opts(s));
+  assert.equal(r.output.state, 'running');
+  assert.equal(eff(r, 'charge').key, 'charge');
+});
+
+test('a shipment after a committed charge that fails permanently refunds the charge and releases the items (R5.1)', () => {
+  const s = fx.onEvent(result('charge', 'billing', 'charge', 'ok'), opts(fx.onEvent(reserveOk, opts(fx.step({ op: 'advance' }, opts(fx.step(start, opts(null)).state)).state)).state));
