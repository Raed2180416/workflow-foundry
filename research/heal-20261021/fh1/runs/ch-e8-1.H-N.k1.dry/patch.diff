diff -ruN a/modules/cancellation.mjs b/modules/cancellation.mjs
--- a/modules/cancellation.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/modules/cancellation.mjs	2026-11-04 14:33:20.043698679 +0000
@@ -0,0 +1,75 @@
+// Module cancellation, key: the order id. Owns R6.1 (cancel an order before any step committed), R6.2 (a customer
+// cancel during processing: judged by the collection reports, S4, S6, S7, then stop and compensate), R6.3 (a refused
+// cancel: cancel-refused; a cancel for an ended order changes nothing), R6.4 (a cancel before clearing counts) and the
+// S7 rule for reports. Calls fraud, order-progress, fulfilment, statuses, notices. No effects of its own.
+// Always return `output`.
+//
+// Ops: customer-cancel { orderId, at, eventId, phase: 'not-cleared'|'processing'|'ended', fulfilmentIds: [fid] }
+//      cancel-order    { orderId, at, reason }
+
+const COLLECTED_MEANINGS = ['collected', 'inTransit', 'delivered'];
+const ENDED = ['completed', 'failed', 'cancelled'];
+
+export function step(input, ctx) {
+  switch (input.op) {
+    case 'customer-cancel': return customerCancel(input, ctx);
+    case 'cancel-order': return cancelOrder(input, ctx);
+  }
+  throw new Error(`cancellation: unknown op ${input.op}`);
+}
+
+export function onEvent(event, ctx) {
+  // Nothing of its own comes back: its calls are judged in the same tick.
+  return { output: { verdict: 'nothing', reason: null, busy: false } };
+}
+
+function customerCancel(input, ctx) {
+  const orderId = input.orderId;
+  if (input.phase === 'ended') return { output: { verdict: 'nothing', reason: null, busy: false } };   // R6.3, S15
+
+  if (input.phase === 'not-cleared') {
+    // R6.4: a cancel for a recorded order that is not yet cleared counts; a later review answer changes nothing.
+    ctx.call('fraud', orderId, { op: 'stop' });
+    return cancelOrder({ orderId, at: input.at, reason: 'customer' }, ctx, 'counts');
+  }
+
+  // processing: judge on the reports that reached us before this cancel (S4, S7). A collection (or a later
+  // carrier state that implies it) with reportedAt at or before the cancel's time refuses it (S6: one collection
+  // ends the right for the whole order).
+  const collected = input.fulfilmentIds.some(fid => {
+    const f = ctx.call('fulfilment', fid, { op: 'get' });
+    return (f.reports ?? []).some(x => COLLECTED_MEANINGS.includes(x.meaning) && Date.parse(x.reportedAt) <= Date.parse(input.at));
+  });
+  if (collected) {
+    ctx.call('notices', orderId, { op: 'send', template: 'cancel-refused', about: orderId, occurrence: input.eventId });   // R6.3
+    return { output: { verdict: 'refused', reason: null, busy: false } };
+  }
+  // R6.2: counts. Stop the order (so R4.5 does not decide its outcome), stop every open fulfilment, then cancel.
+  ctx.call('order-progress', orderId, { op: 'stop', orderId, at: input.at });
+  const st = ctx.call('statuses', orderId, { op: 'get', orderId });
+  for (const [fid, status] of Object.entries(st.fulfilments)) {
+    if (ENDED.includes(status)) continue;
+    if (status === 'processing' || status === 'dispatched' || status === 'pending') {
+      ctx.call('fulfilment', fid, { op: 'stop', at: input.at });
+    }
+    ctx.call('statuses', orderId, { op: 'set', orderId, fulfilmentId: fid, status: 'cancelled' });
+  }
+  ctx.call('statuses', orderId, { op: 'set', orderId, fulfilmentId: null, status: 'cancelled' });
+  ctx.call('notices', orderId, { op: 'send', template: 'order-cancelled', about: orderId });
+  return { output: { verdict: 'counts', reason: 'customer', busy: false } };
+}
+
+function cancelOrder(input, ctx, verdict = 'done') {
+  // R6.1, once: every fulfilment not completed, failed or cancelled is cancelled; the order is cancelled; the notice.
+  const orderId = input.orderId;
+  ctx.call('fraud', orderId, { op: 'stop' });
+  const st = ctx.call('statuses', orderId, { op: 'get', orderId });
+  for (const [fid, status] of Object.entries(st.fulfilments)) {
+    if (ENDED.includes(status)) continue;
+    if (status === 'processing') ctx.call('fulfilment', fid, { op: 'stop', at: input.at });
+    ctx.call('statuses', orderId, { op: 'set', orderId, fulfilmentId: fid, status: 'cancelled' });
+  }
+  ctx.call('statuses', orderId, { op: 'set', orderId, fulfilmentId: null, status: 'cancelled' });
+  ctx.call('notices', orderId, { op: 'send', template: 'order-cancelled', about: orderId });
+  return { output: { verdict, reason: input.reason, busy: false } };
+}
diff -ruN a/modules/customer-action.mjs b/modules/customer-action.mjs
--- a/modules/customer-action.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/modules/customer-action.mjs	2026-11-04 14:33:20.047519124 +0000
@@ -0,0 +1,145 @@
+// Module customer-action, key: the order id. Owns R3.1 (action-required within 120 min of clearing), R3.2 (the
+// customer's deadline D = p + customerActionHours; the first amend or cancel at or before D counts; a timeout after D)
+// and S1. Calls statuses and notices. Wake-up: `deadline` at D + 30 min (after D, so an action at D still wins; well
+// inside the window (D, D + 60 min]).
+//
+// It starts when the order is recorded, so that an amend that arrives during the fraud review is still judged in time
+// (R3.2 counts an action at or before D whatever the review state); R3.1 waits for the clearing.
+//
+// state: { phase, orderId, placedAt, deadline, unavailable: [fid], available: [fid], at, reason }
+//   phase: 'inert' (nothing unavailable) | 'review' (recorded, not cleared) | 'waiting' (action-required sent) |
+//          'amended' (counted amend during review) | 'ready' (counted amend, ready at `at`) | 'cancel' | 'timedOut' |
+//          'stopped'
+
+const WAKE_AFTER_MIN = 30;
+
+// Files arrive as raw text: parse a JSON file (or pass a parsed value through).
+function fileJson(files, path) {
+  const v = files?.[path];
+  return typeof v === 'string' ? JSON.parse(v) : v ?? null;
+}
+
+export function step(input, ctx) {
+  switch (input.op) {
+    case 'start': return start(input, ctx);
+    case 'advance': return advance(input, ctx);
+    case 'action': return action(input, ctx);
+    case 'stop': return stop(input, ctx);
+    case 'resume': return resume(input, ctx);
+  }
+  throw new Error(`customer-action: unknown op ${input.op}`);
+}
+
+export function onEvent(event, ctx) {
+  if (event.type === 'timer.fired' && ctx.state && (ctx.state.phase === 'review' || ctx.state.phase === 'waiting')) {
+    return timedOut(ctx.state, ctx);
+  }
+  return { output: view(ctx.state) };
+}
+
+function view(state) {
+  if (!state) return { state: 'idle', at: null, reason: null, busy: false };
+  return {
+    state: state.phase, at: state.at ?? null, reason: state.reason ?? null,
+    busy: state.phase === 'review' || state.phase === 'waiting',
+  };
+}
+
+function start(input, ctx) {
+  const unavailable = input.fulfilments.filter(f => !f.available).map(f => f.fulfilmentId);
+  const available = input.fulfilments.filter(f => f.available).map(f => f.fulfilmentId);
+  const deadline = addMinutes(input.placedAt, policyOf(input, ctx).customerActionHours * 60);     // R3.2, S1: from p
+  if (unavailable.length === 0) {
+    const state = { phase: 'inert', orderId: input.orderId, placedAt: input.placedAt, deadline, unavailable, available, at: null, reason: null };
+    return { output: view(state), state };
+  }
+  const state = { phase: 'review', orderId: input.orderId, placedAt: input.placedAt, deadline, unavailable, available, at: null, reason: null };
+  return { output: view(state), state, obligations: { upsert: [wakeUp(deadline)] } };
+}
+
+function advance(input, ctx) {
+  const state = ctx.state;
+  if (state && state.phase === 'amended') {
+    // Counted during the review (R3.2): the order is ready when it clears; R3.1 is moot (S9).
+    const next = { ...state, phase: 'ready' };
+    return { output: view(next), state: next };
+  }
+  if (!state || state.phase !== 'review') return { output: view(state) };
+  // The order is cleared now (R3.1): action-required, within 120 min of the clearing.
+  const orderId = state.orderId;
+  const next = { ...state, phase: 'waiting', at: input.clearedAt ?? null };
+  ctx.call('statuses', orderId, { op: 'set', orderId, fulfilmentId: null, status: 'customerActionRequired' });
+  ctx.call('notices', orderId, { op: 'send', template: 'action-required', about: orderId });
+  return { output: view(next), state: next };
+}
+
+function action(input, ctx) {
+  const state = ctx.state;
+  if (!state || (state.phase !== 'review' && state.phase !== 'waiting')) return { output: view(state) };
+  // The first amend or cancel at or before D counts (R3.2). Later actions change nothing.
+  if (Date.parse(input.at) > Date.parse(state.deadline)) return { output: view(state) };
+  const orderId = state.orderId;
+  if (input.action === 'cancel') {
+    const next = { ...state, phase: 'cancel', at: input.at, reason: 'customer' };
+    return { output: view(next), state: next, obligations: { cancel: ['deadline'] } };
+  }
+  if (input.action !== 'amend') return { output: view(state) };
+  // amend: every unavailable fulfilment cancelled within 60 min of the amend (R3.2). S5: nothing when none is unavailable.
+  if (state.unavailable.length === 0) return { output: view(state) };
+  for (const fid of state.unavailable) {
+    ctx.call('statuses', orderId, { op: 'set', orderId, fulfilmentId: fid, status: 'cancelled' });
+  }
+  const obligations = { cancel: ['deadline'] };
+  if (state.available.length === 0) {
+    const next = { ...state, phase: 'cancel', at: input.at, reason: 'nothing-available' };
+    return { output: view(next), state: next, obligations };
+  }
+  const next = { ...state, phase: state.phase === 'waiting' ? 'ready' : 'amended', at: input.at };
+  return { output: view(next), state: next, obligations };
+}
+
+function timedOut(state, ctx) {
+  // Nothing counted by D: after D, within 60 min of D: every fulfilment cancelled, the order timedOut (R3.2).
+  const orderId = state.orderId;
+  const all = [...state.unavailable, ...state.available];
+  for (const fid of all) ctx.call('statuses', orderId, { op: 'set', orderId, fulfilmentId: fid, status: 'cancelled' });
+  ctx.call('statuses', orderId, { op: 'set', orderId, fulfilmentId: null, status: 'timedOut' });
+  ctx.call('notices', orderId, { op: 'send', template: 'order-timed-out', about: orderId });
+  const next = { ...state, phase: 'timedOut', at: ctx.now };
+  return { output: view(next), state: next };
+}
+
+function stop(input, ctx) {
+  // A counted cancel elsewhere (R6.2, R6.1, a fraud decision) ends the order: no timeout may fire any more.
+  if (!ctx.state) return { output: view({ phase: 'stopped' }) };
+  const had = ctx.state.phase === 'review' || ctx.state.phase === 'waiting';
+  const next = { ...ctx.state, phase: 'stopped' };
+  return { output: view(next), state: next, ...(had ? { obligations: { cancel: ['deadline'] } } : {}) };
+}
+
+function resume(input, ctx) {
+  // §3.5: from the migrated records: a waiting order keeps its deadline; an order not yet cleared is in review.
+  const r = input.records ?? {};
+  const row = (r['orders.orders'] ?? [])[0];
+  const fulfilments = (r['orders.fulfilments'] ?? []).map(f => ({ fulfilmentId: f.fulfilmentId, available: (f.location ?? null) !== null }));
+  const start_ = start({ orderId: row?.orderId ?? input.orderId, placedAt: input.placedAt, fulfilments, edition: input.edition }, ctx);
+  if (!row || row.status === 'pending') return start_;
+  if (row.status === 'customerActionRequired') {
+    const state = { ...start_.state, phase: 'waiting' };
+    return { output: view(state), state, obligations: { upsert: [wakeUp(start_.state.deadline)] } };
+  }
+  const state = { ...start_.state, phase: 'stopped' };
+  return { output: view(state), state };
+}
+
+function policyOf(input, ctx) {
+  return fileJson(ctx.files, `rulebook/${input.edition}/policy.json`);
+}
+
+function wakeUp(deadline) {
+  return { id: 'deadline', kind: 'customer-deadline', anchor: 'placement', dueAt: addMinutes(deadline, WAKE_AFTER_MIN), onDue: 'deadline' };
+}
+
+function addMinutes(iso, minutes) {
+  return new Date(Date.parse(iso) + minutes * 60000).toISOString();
+}
diff -ruN a/modules/fraud.mjs b/modules/fraud.mjs
--- a/modules/fraud.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/modules/fraud.mjs	2026-11-04 14:33:20.047561219 +0000
@@ -0,0 +1,140 @@
+// Module fraud, key: the order id. Owns R2.1, R2.2 and S3 (one review deadline, from the first review task), and the
+// human-task events of §3.4. Effects: fraud.check (key `check`). Human tasks: fraudReview (ids `review-<n>`).
+// Wake-up: `deadline`, set after the review deadline (an answer exactly at the deadline still counts, R2.2; a
+// wake-up 30 min after it lets an answer delivered late still count). Always return `output`.
+//
+// state: { state: 'checking'|'review'|'cleared'|'cancel'|'stopped', placedAt, edition, deadline, tasks: n, at, reason }
+
+const WAKE_AFTER_MIN = 30;
+
+// Files arrive as raw text: parse a JSON file (or pass a parsed value through).
+function fileJson(files, path) {
+  const v = files?.[path];
+  return typeof v === 'string' ? JSON.parse(v) : v ?? null;
+}
+
+export function step(input, ctx) {
+  switch (input.op) {
+    case 'start': return start(input, ctx);
+    case 'stop': return stop(input, ctx);
+    case 'resume': return resume(input, ctx);
+  }
+  throw new Error(`fraud: unknown op ${input.op}`);
+}
+
+export function onEvent(event, ctx) {
+  const state = ctx.state;
+  if (!state) return { output: view(null) };
+  const p = event.payload ?? {};
+  if (event.type === 'effect.result' && p.key === 'check' && state.state === 'checking') return checked(state, p, event, ctx);
+  if (event.type === 'humanTask.answered') return answered(state, p, event, ctx);
+  if (event.type === 'humanTask.answerRejected' || event.type === 'humanTask.withdrawn') return unusable(state, ctx);
+  if (event.type === 'timer.fired' && state.state === 'review') return timedOut(state, ctx);
+  return { output: view(state) };
+}
+
+function view(state) {
+  if (!state) return { state: 'idle', at: null, reason: null, busy: false };
+  return { state: state.state, at: state.at ?? null, reason: state.reason ?? null, busy: state.state === 'checking' || state.state === 'review' };
+}
+
+function start(input, ctx) {
+  // R2.1: read fraud.check for every new order.
+  const state = { state: 'checking', placedAt: input.placedAt, edition: input.edition, deadline: null, tasks: 0, at: null, reason: null };
+  return { output: view(state), state, effects: [{ key: 'check', system: 'fraud', op: 'check', args: { orderId: input.orderId } }] };
+}
+
+function checked(state, p, event, ctx) {
+  const verdict = verdictOf(p);
+  const orderId = ctx.key;
+  if (verdict === 'pass') {
+    const next = { ...state, state: 'cleared', at: state.placedAt };                    // R2.1: cleared at p
+    return { output: view(next), state: next };
+  }
+  if (verdict === 'reject') {
+    const next = { ...state, state: 'cancel', at: ctx.now, reason: 'fraud' };
+    return { output: view(next), state: next };
+  }
+  if (verdict === 'review') {
+    // R2.2: one review task; the deadline is fraudReviewHours from its creation, and it never moves (S3).
+    const hours = fileJson(ctx.files, `rulebook/${state.edition}/policy.json`).fraudReviewHours;
+    const deadline = addMinutes(ctx.now, hours * 60);
+    const next = { ...state, state: 'review', deadline, tasks: 1 };
+    return { output: view(next), state: next, humanTasks: [reviewTask(orderId, 1, deadline)], obligations: { upsert: [wakeUp(deadline)] } };
+  }
+  throw new Error(`fraud: unknown verdict ${JSON.stringify(verdict)}`);
+}
+
+function answered(state, p, event, ctx) {
+  if (state.state !== 'review') return { output: view(state) };                           // a later answer changes nothing
+  const decision = p.answer?.decision ?? p.decision ?? p.value?.decision;
+  const at = p.answeredAt ?? event.at;
+  // An answer counts only if it carries `decision` and its time is at or before the deadline (R2.2). The `late`
+  // flag is not the criterion (§3.4).
+  if (decision !== 'approve' && decision !== 'reject') return unusable(state, ctx);
+  if (Date.parse(at) > Date.parse(state.deadline)) return { output: view(state) };
+  const next = decision === 'approve'
+    ? { ...state, state: 'cleared', at }
+    : { ...state, state: 'cancel', at, reason: 'fraud' };
+  return { output: view(next), state: next, obligations: { cancel: ['deadline'] } };
+}
+
+function unusable(state, ctx) {
+  // Unusable, rejected or withdrawn: ask again (new task id); the deadline stays (R2.2, S3).
+  if (state.state !== 'review' || Date.parse(ctx.now) > Date.parse(state.deadline)) return { output: view(state) };
+  const n = state.tasks + 1;
+  const next = { ...state, tasks: n };
+  return { output: view(next), state: next, humanTasks: [reviewTask(ctx.key, n, state.deadline)] };
+}
+
+function timedOut(state, ctx) {
+  // No usable answer by the deadline: cancel after it, within 120 min (R2.2).
+  const next = { ...state, state: 'cancel', at: ctx.now, reason: 'fraud-review-timeout' };
+  return { output: view(next), state: next };
+}
+
+function stop(input, ctx) {
+  // R6.4: a customer cancel before clearing stops the review: a later answer changes nothing.
+  if (!ctx.state) return { output: view({ state: 'stopped' }) };
+  const next = { ...ctx.state, state: 'stopped' };
+  return { output: view(next), state: next, obligations: { cancel: ['deadline'] } };
+}
+
+function resume(input, ctx) {
+  // §3.5: from the records: an order already past its fraud phase is cleared; otherwise the review stays open.
+  const r = input.records ?? {};
+  const state = r.state ? { state: r.state, placedAt: r.placedAt, edition: r.edition, deadline: r.deadline ?? null, tasks: r.tasks ?? 0, at: r.at ?? null, reason: r.reason ?? null } : null;
+  if (!state) return { output: view(null) };
+  return { output: view(state), state };
+}
+
+function verdictOf(p) {
+  for (const c of [p, p.result, p.value, p.output, p.data]) if (c && typeof c.verdict === 'string') return c.verdict;
+  throw new Error(`fraud: check result has no verdict: ${JSON.stringify(p).slice(0, 120)}`);
+}
+
+function reviewTask(orderId, n, deadline) {
+  return {
+    id: `review-${n}`,
+    kind: 'fraudReview',
+    role: 'fraudAnalyst',
+    subject: orderId,
+    question: `Review order ${orderId} for fraud and decide: approve or reject.`,
+    answerSchema: {
+      type: 'object',
+      required: ['decision'],
+      additionalProperties: false,
+      properties: { decision: { enum: ['approve', 'reject'] } },
+    },
+    dueAt: deadline,
+    onTimeout: 'expire',
+  };
+}
+
+function wakeUp(deadline) {
+  return { id: 'deadline', kind: 'fraud-deadline', anchor: 'review-task', dueAt: addMinutes(deadline, WAKE_AFTER_MIN), onDue: 'deadline' };
+}
+
+function addMinutes(iso, minutes) {
+  return new Date(Date.parse(iso) + minutes * 60000).toISOString();
+}
diff -ruN a/modules/fulfilment.mjs b/modules/fulfilment.mjs
--- a/modules/fulfilment.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/modules/fulfilment.mjs	2026-11-04 14:33:20.047602617 +0000
@@ -0,0 +1,413 @@
+// Module fulfilment, key: the fulfilment id. One saga per fulfilment. Owns R4.2 (reserve, charge, ship, in that order,
+// each after the previous one committed), R4.3 (collection is the point of no return: a cancel is refused after it),
+// R4.4 (carrier reports), R5.1 (compensation in reverse order of committed steps), R5.2 (failure), S2 (committed =
+// result ok, or outcome unknown and status(key) committed) and S14 (a step committing after a failure or a stop is
+// compensated when it commits). Forward steps are emitted only by `advance`, at the end of a tick (S10).
+// Effects: inventory.reserve (`reserve-<n>`, items `item.<sku>`), billing.charge (`charge`), carrier.create (`ship`),
+// carrier.cancel (`unship`), billing.refund (`refund`), inventory.release (`release.<sku>`). Calls statuses, notices.
+// Always return `output`.
+//
+// state: { orderId, fid, customerId, currency, edition, location, items: [{sku, qty}], amountMinor, phase,
+//          batches, reserve: { [sku]: 'pending'|'ok'|'failed'|'released' }, charge, ship, shipUndo, refund,
+//          collectionFailed, dispatched, reports: [{ meaning, reportedAt }], end, endedAt }
+//   phase: 'new' | 'running' | 'dispatched' | 'completed' | 'failed' | 'stopped'
+//   charge / ship / refund: 'none' | 'pending' | 'ok' | 'failed' ; shipUndo, refund undo: 'none'|'pending'|'done'
+
+const MAX_BATCHES = 5;
+const MEANINGS = ['collected', 'inTransit', 'delivered', 'collectionFailed'];
+
+// Files arrive as raw text: parse a JSON file (or pass a parsed value through).
+function fileJson(files, path) {
+  const v = files?.[path];
+  return typeof v === 'string' ? JSON.parse(v) : v ?? null;
+}
+
+export function step(input, ctx) { return withFit(stepOf(input, ctx), ctx); }
+
+function stepOf(input, ctx) {
+  switch (input.op) {
+    case 'start': return start(input, ctx);
+    case 'advance': return advance(input, ctx);
+    case 'carrier': return carrier(input, ctx);
+    case 'stop': return stop(input, ctx);
+    case 'get': return { output: view(ctx.state) };
+    case 'resume': return resume(input, ctx);
+  }
+  throw new Error(`fulfilment: unknown op ${input.op}`);
+}
+
+export function onEvent(event, ctx) { return withFit(eventOf(event, ctx), ctx); }
+
+function eventOf(event, ctx) {
+  const state = ctx.state;
+  if (!state) return { output: view(null) };
+  if (event.type !== 'effect.result') return { output: view(state) };
+  const p = event.payload ?? {};
+  const r = resultOf(p);
+  if (p.key === 'charge') return chargeResult(state, r, ctx);
+  if (p.key === 'ship') return shipResult(state, r, ctx);
+  if (p.key === 'unship' || p.key === 'refund' || (typeof p.key === 'string' && p.key.startsWith('release.'))) {
+    return undoResult(state, p, r, ctx);
+  }
+  if (p.system === 'inventory' && p.op === 'reserve') return reserveResult(state, p, r, ctx);
+  throw new Error(`fulfilment: unexpected effect result ${JSON.stringify(p).slice(0, 160)}`);
+}
+
+function view(state) {
+  if (!state) return { state: 'idle', end: null, endedAt: null, reports: [], busy: false };
+  return {
+    state: state.phase, end: state.end ?? null, endedAt: state.endedAt ?? null,
+    reports: state.reports, busy: busy(state),
+  };
+}
+
+function busy(s) {
+  if (s.charge === 'pending' || s.ship === 'pending' || s.shipUndo === 'pending' || s.refund === 'pending') return true;
+  return Object.values(s.reserve ?? {}).includes('pending');
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Start and forward steps
+
+function start(input, ctx) {
+  const items = mergeItems(input.fulfilment.items);
+  const state = {
+    orderId: input.orderId, fid: input.fulfilment.fulfilmentId, customerId: input.customerId, currency: input.currency,
+    edition: input.edition, location: input.fulfilment.location, items, amountMinor: input.fulfilment.amountMinor,
+    phase: 'running', batches: 0,
+    reserve: Object.fromEntries(items.map(i => [i.sku, 'none'])),
+    charge: 'none', ship: 'none', shipUndo: 'none', refund: 'none', collectionFailed: false, dispatched: false,
+    reports: [], end: null, endedAt: null,
+  };
+  return { output: view(state), state };
+}
+
+function advance(input, ctx) {
+  const state = ctx.state;
+  if (!state) return { output: view(null) };
+  if (state.phase === 'failed' || state.phase === 'stopped') return compensate(state, ctx);
+  if (state.phase !== 'running' && state.phase !== 'dispatched') return { output: view(state) };
+  const effects = [];
+  const s = { ...state, reserve: { ...state.reserve } };
+  // Step 1: reserve every item, as one batch (R4.2).
+  const emptyReserve = Object.values(s.reserve).every(v => v === 'none');
+  if (emptyReserve) {
+    const items = s.items.map(i => ({ key: `item.${i.sku}`, sku: i.sku, qty: i.qty }));
+    for (const i of s.items) s.reserve[i.sku] = 'pending';
+    s.batches = 1;
+    effects.push(reserveEffect(s, items));
+  }
+  // Step 2: charge once every reservation committed (R4.2).
+  if (s.charge === 'none' && Object.values(s.reserve).every(v => v === 'ok')) {
+    s.charge = 'pending';
+    effects.push({ key: 'charge', system: 'billing', op: 'charge', args: {
+      orderId: s.orderId, fulfilmentId: s.fid, customerId: s.customerId, amountMinor: s.amountMinor, currency: s.currency,
+    } });
+  }
+  // Step 3: book the shipment once the charge committed (R4.2), with the fulfilment id as the carrier ref.
+  if (s.charge === 'ok' && s.ship === 'none') {
+    s.ship = 'pending';
+    effects.push({ key: 'ship', system: 'carrier', op: 'create', args: {
+      orderId: s.orderId, fulfilmentId: s.fid, location: s.location, ref: s.fid,
+    } });
+  }
+  if (effects.length === 0) return { output: view(state) };
+  return { output: view(s), state: s, effects };
+}
+
+// A batch op keys its items, not the batch (§2): the item keys are the idempotency keys.
+function reserveEffect(s, items) {
+  return { system: 'inventory', op: 'reserve', args: { orderId: s.orderId, fulfilmentId: s.fid, location: s.location, items } };
+}
+
+function mergeItems(items) {
+  const bySku = new Map();
+  for (const i of items) bySku.set(i.sku, (bySku.get(i.sku) ?? 0) + i.qty);
+  return [...bySku].map(([sku, qty]) => ({ sku, qty }));
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Results of forward steps
+
+function reserveResult(state, p, r, ctx) {
+  const s = { ...state, reserve: { ...state.reserve } };
+  const outcome = {};
+  if (r.status === 'ok') {
+    for (const sku of Object.keys(s.reserve)) if (s.reserve[sku] === 'pending') outcome[sku] = 'ok';
+  } else if (r.status === 'partial' || Array.isArray(p.items)) {
+    for (const it of p.items ?? []) {
+      const sku = String(it.key ?? '').replace(/^item\./, '');
+      if (!(sku in s.reserve)) continue;
+      if (it.status === 'ok') outcome[sku] = 'ok';
+      else outcome[sku] = it.error?.retryable === false || it.retryable === false ? 'failed-permanent' : 'failed';
+    }
+  } else if (isInvalidRequest(r)) {
+    // R4.2: a 400 is our own mistake: correct and re-issue with the same key, inside the window (not a failure).
+    return reissueReserve(s, p, ctx);
+  } else if (r.status === 'error' && r.retryable === false) {
+    for (const sku of Object.keys(s.reserve)) if (s.reserve[sku] === 'pending') s.reserve[sku] = 'failed';
+    return fail(s, ctx, 'reserve-error', ctx.now);
+  } else {
+    throw new Error(`fulfilment: unexpected reserve result ${JSON.stringify(p).slice(0, 160)}`);
+  }
+  for (const [sku, v] of Object.entries(outcome)) {
+    if (v === 'ok') s.reserve[sku] = 'ok';
+  }
+  const permanent = Object.values(outcome).includes('failed-permanent');
+  const failed = Object.keys(outcome).filter(sku => outcome[sku] === 'failed').concat(Object.keys(s.reserve).filter(sku => s.reserve[sku] === 'pending' && !(sku in outcome)));
+  if (permanent) {
+    for (const sku of Object.keys(s.reserve)) if (s.reserve[sku] === 'pending') s.reserve[sku] = 'failed';
+    return fail(s, ctx, 'reserve-error', ctx.now);
+  }
+  if (failed.length === 0) return afterStep(s, ctx);
+  if (s.phase === 'stopped' || s.phase === 'failed') {
+    for (const sku of failed) s.reserve[sku] = 'failed';
+    return compensate(s, ctx);                                          // nothing new after a stop or a failure
+  }
+  // A partial batch is delivered, not retried: resubmit only the failed items, with their original keys (R4.2).
+  if (s.batches >= MAX_BATCHES) {
+    for (const sku of failed) s.reserve[sku] = 'failed';
+    return fail(s, ctx, 'reserve-error', ctx.now);
+  }
+  s.batches += 1;
+  const items = s.items.filter(i => failed.includes(i.sku)).map(i => ({ key: `item.${i.sku}`, sku: i.sku, qty: i.qty }));
+  for (const sku of failed) s.reserve[sku] = 'pending';
+  return { output: view(s), state: s, effects: [reserveEffect(s, items)] };
+}
+
+// After a result, forward steps that became due are emitted by advance (or here, at once when the saga moves on).
+function afterStep(s, ctx) {
+  const next = advance({}, { ...ctx, state: s });
+  return next.state ? next : { output: view(s), state: s };
+}
+
+function reissueReserve(s, p, ctx) {
+  if (s.phase === 'stopped' || s.phase === 'failed') {
+    for (const sku of Object.keys(s.reserve)) if (s.reserve[sku] === 'pending') s.reserve[sku] = 'failed';
+    return compensate(s, ctx);
+  }
+  const items = s.items.filter(i => s.reserve[i.sku] === 'pending').map(i => ({ key: `item.${i.sku}`, sku: i.sku, qty: i.qty }));
+  return { output: view(s), state: s, effects: [reserveEffect(s, items)] };
+}
+
+function chargeResult(state, r, ctx) {
+  const s = { ...state };
+  if (r.status === 'ok') { s.charge = 'ok'; return afterStepOrCompensate(s, ctx); }
+  if (isInvalidRequest(r)) return reissueCharge(s, ctx);
+  if (isDeclined(r) || r.status === 'error' || r.status === 'unknown') {
+    if (r.status === 'unknown' && ctx.status('billing', 'charge') === 'committed') { s.charge = 'ok'; return afterStepOrCompensate(s, ctx); }
+    s.charge = 'failed';
+    return fail(s, ctx, isDeclined(r) ? 'card-declined' : 'charge-error', ctx.now);
+  }
+  throw new Error(`fulfilment: unexpected charge result ${JSON.stringify(r).slice(0, 160)}`);
+}
+
+function reissueCharge(s, ctx) {
+  if (s.phase === 'stopped' || s.phase === 'failed') { s.charge = 'failed'; return compensate(s, ctx); }
+  return { output: view(s), state: s, effects: [{ key: 'charge', system: 'billing', op: 'charge', args: {
+    orderId: s.orderId, fulfilmentId: s.fid, customerId: s.customerId, amountMinor: s.amountMinor, currency: s.currency,
+  } }] };
+}
+
+function shipResult(state, r, ctx) {
+  const s = { ...state };
+  if (r.status === 'ok') { s.ship = 'ok'; return afterStepOrCompensate(s, ctx); }
+  if (isInvalidRequest(r)) {
+    if (s.phase === 'stopped' || s.phase === 'failed') { s.ship = 'failed'; return compensate(s, ctx); }
+    return { output: view(s), state: s, effects: [{ key: 'ship', system: 'carrier', op: 'create', args: {
+      orderId: s.orderId, fulfilmentId: s.fid, location: s.location, ref: s.fid,
+    } }] };
+  }
+  if (r.status === 'unknown' && ctx.status('carrier', 'ship') === 'committed') { s.ship = 'ok'; return afterStepOrCompensate(s, ctx); }
+  if (r.status === 'error' || r.status === 'unknown') {
+    s.ship = 'failed';
+    return fail(s, ctx, 'ship-error', ctx.now);
+  }
+  throw new Error(`fulfilment: unexpected ship result ${JSON.stringify(r).slice(0, 160)}`);
+}
+
+function afterStepOrCompensate(s, ctx) {
+  // S14: a step that commits after the fulfilment failed or was stopped is compensated now.
+  if (s.phase === 'failed' || s.phase === 'stopped') return compensate(s, ctx);
+  return afterStep(s, ctx);
+}
+
+function undoResult(state, p, r, ctx) {
+  const s = { ...state };
+  if (p.key === 'unship') s.shipUndo = 'done';
+  if (p.key === 'refund') s.refund = 'ok';
+  if (typeof p.key === 'string' && p.key.startsWith('release.')) {
+    const sku = p.key.slice('release.'.length);
+    if (sku in s.reserve) s.reserve[sku] = 'released';
+  }
+  return { output: view(s), state: s };
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Failure and compensation (R5.1, R5.2, S14)
+
+function fail(s, ctx, reason, at) {
+  if (s.phase === 'failed' || s.phase === 'stopped') return compensate(s, ctx);
+  s.phase = 'failed';
+  s.end = 'failed';
+  s.endedAt = at;
+  s.failReason = reason;
+  const undo = compensate(s, ctx);
+  const fs = { ...undo.state };
+  const effects = [...(undo.effects ?? [])];
+  const orderId = s.orderId;
+  ctx.call('statuses', orderId, { op: 'set', orderId, fulfilmentId: s.fid, status: 'failed' });
+  ctx.call('notices', orderId, { op: 'send', template: 'fulfilment-failed', about: s.fid });
+  return { output: view(fs), state: fs, effects };
+}
+
+// Undo every committed step that is not undone yet, in reverse order: shipment, charge, reserved items (R5.1).
+// Never undoes a step that did not commit, and never undoes one twice (the flags say which).
+function compensate(state, ctx) {
+  const s = { ...state, reserve: { ...state.reserve } };
+  const effects = [];
+  if (s.ship === 'ok' && s.shipUndo === 'none' && !s.collectionFailed) {
+    s.shipUndo = 'pending';
+    effects.push({ key: 'unship', system: 'carrier', op: 'cancel', args: { orderId: s.orderId, fulfilmentId: s.fid } });
+  }
+  if (s.charge === 'ok' && s.refund === 'none') {
+    s.refund = 'pending';
+    effects.push({ key: 'refund', system: 'billing', op: 'refund', args: { orderId: s.orderId, fulfilmentId: s.fid, amountMinor: s.amountMinor } });
+  }
+  for (const i of s.items) {
+    if (s.reserve[i.sku] === 'ok') {
+      s.reserve[i.sku] = 'released';
+      effects.push({ key: `release.${i.sku}`, system: 'inventory', op: 'release', args: { orderId: s.orderId, fulfilmentId: s.fid, sku: i.sku } });
+    }
+  }
+  if (effects.length === 0) return { output: view(s), state: s };
+  return { output: view(s), state: s, effects };
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Carrier reports (R4.4, §3.3)
+
+function carrier(input, ctx) {
+  const s = { ...ctx.state, reports: [...(ctx.state?.reports ?? [])] };
+  if (!ctx.state) return { output: view(null) };
+  const meaning = meaningOf(ctx, input.message);
+  const at = input.message.reportedAt;
+  if (MEANINGS.includes(meaning) && !s.reports.some(x => x.meaning === meaning && x.reportedAt === at)) {
+    s.reports.push({ meaning, reportedAt: at });
+  }
+  if (s.phase !== 'running' && s.phase !== 'dispatched') return { output: view(s), state: s };   // ended: changes nothing
+  if (meaning === 'collected') {
+    if (s.phase !== 'running' || s.ship !== 'ok') return { output: view(s), state: s };
+    return dispatch(s, ctx, false);
+  }
+  if (meaning === 'delivered') {
+    if (s.ship !== 'ok') return { output: view(s), state: s };
+    return complete(s, ctx, at);
+  }
+  if (meaning === 'collectionFailed') {
+    s.collectionFailed = true;
+    if (s.phase !== 'running') return { output: view(s), state: s };
+    return fail(s, ctx, 'collection-failed', at);
+  }
+  return { output: view(s), state: s };
+}
+
+function meaningOf(ctx, message) {
+  const table = fileJson(ctx.files, `rulebook/${ctx.state.edition}/carrier-codes.json`) ?? [];
+  const row = table.find(r => r.carrier === message.carrier && r.code === message.code);
+  return row ? row.meaning : 'info';
+}
+
+function dispatch(s, ctx) {
+  s.phase = 'dispatched';
+  s.dispatched = true;
+  ctx.call('statuses', s.orderId, { op: 'set', orderId: s.orderId, fulfilmentId: s.fid, status: 'dispatched' });
+  return { output: view(s), state: s };
+}
+
+function complete(s, ctx, at) {
+  const effects = [];
+  const fromDispatch = s.dispatched;
+  s.phase = 'completed';
+  s.end = 'completed';
+  s.endedAt = at;
+  ctx.call('statuses', s.orderId, { op: 'set', orderId: s.orderId, fulfilmentId: s.fid, status: 'completed', afterStatus: fromDispatch ? undefined : 'dispatched' });
+  return { output: view(s), state: s, effects };
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Stop (a counted customer cancel, R6.2): no new step; compensate what committed; later commits compensated (S14)
+
+function stop(input, ctx) {
+  const state = ctx.state;
+  if (!state) return { output: view({ phase: 'stopped', reports: [] }) };
+  if (state.phase === 'completed' || state.phase === 'failed') return { output: view(state) };
+  const s = { ...state, phase: 'stopped', end: 'stopped', endedAt: input.at };
+  return compensate(s, ctx);
+}
+
+function resume(input, ctx) {
+  // §3.5: a migrated fulfilment continues from its records.
+  const r = input.records ?? {};
+  if (!r.phase) return { output: view(ctx.state) };
+  const state = { ...r };
+  return { output: view(state), state };
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+
+// An error is { code: <http status>, reason: <name>, retryable }.
+function resultOf(p) {
+  const error = p.error ?? null;
+  return {
+    status: p.status,
+    code: error?.reason ?? null,
+    retryable: error?.retryable ?? p.retryable ?? null,
+    http: typeof error?.code === 'number' ? error.code : null,
+  };
+}
+
+const isInvalidRequest = r => r.http === 400 || r.code === 'invalid-args' || r.code === 'field-renamed';
+const isDeclined = r => r.http === 402 || r.code === 'card-declined';
+
+// Args follow the system's current schema (api/<system>.schema.json, which always shows the current names): a field the
+// system renamed is sent under its new name, so the call is not refused with 400 field-renamed (R4.2).
+function withFit(res, ctx) {
+  if (res && Array.isArray(res.effects)) {
+    res.effects = res.effects.map(e => ({ ...e, args: fitObject(argsSchema(ctx.files, e.system, e.op), e.args) }));
+  }
+  return res;
+}
+
+function argsSchema(files, system, op) {
+  const api = fileJson(files, `api/${system}.schema.json`);
+  return api?.ops?.[op]?.args ?? null;
+}
+
+function fitObject(schema, obj) {
+  if (!schema || !schema.properties || !obj || typeof obj !== 'object') return obj;
+  const props = schema.properties;
+  const free = Object.keys(props).filter(k => !(k in obj));
+  const out = {};
+  for (const [k, v] of Object.entries(obj)) {
+    if (k in props) { out[k] = fitValue(props[k], v); continue; }
+    const target = pickRename(k, free);
+    if (target) { out[target] = fitValue(props[target], v); free.splice(free.indexOf(target), 1); } else out[k] = v;
+  }
+  return out;
+}
+
+function fitValue(sch, v) {
+  if (Array.isArray(v) && sch && sch.items && sch.items.properties) return v.map(x => fitObject(sch.items, x));
+  return v;
+}
+
+function pickRename(k, free) {
+  const norm = x => x.toLowerCase().replace(/[^a-z0-9]/g, '');
+  const nk = norm(k);
+  const exact = free.find(f => norm(f) === nk);
+  if (exact) return exact;
+  const similar = free.filter(f => norm(f).includes(nk) || nk.includes(norm(f)));
+  if (similar.length === 1) return similar[0];
+  return free.length === 1 ? free[0] : null;
+}
