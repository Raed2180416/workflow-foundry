--- a/tests/order-progress.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/order-progress.test.mjs	2026-11-04 14:33:20.048459484 +0000
@@ -0,0 +1,46 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { programHarness } from './helpers/program.mjs';
+
+const op = programHarness('order-progress');
+const T = '2026-03-02T10:00:00+01:00';
+const sets = r => r.effects.map(e => `${e.args.fulfilmentId ?? 'order'}=${e.args.status}`);
+const ready = { op: 'ready', orderId: 'ORD-1', at: T, fulfilments: [{ fulfilmentId: 'ORD-1-F1', available: true }, { fulfilmentId: 'ORD-1-F2', available: false }] };
+const opts = (statuses, state = null) => ({ key: 'ORD-1', state, now: T, states: { statuses: { 'ORD-1': statuses } } });
+
+test('ready sets the order and every available fulfilment to processing, once (R4.1)', () => {
+  const r = op.step(ready, opts({ order: 'pending', fulfilments: { 'ORD-1-F1': 'pending', 'ORD-1-F2': 'unavailable' } }));
+  assert.deepEqual(sets(r), ['order=processing', 'ORD-1-F1=processing']);
+  assert.equal(r.output.state, 'processing');
+  const again = op.step(ready, { ...opts({ order: 'processing', fulfilments: {} }), state: r.state });
+  assert.equal(again.effects.length, 0);
+});
+
+test('the order completes when one fulfilment completed and the others ended (R4.5)', () => {
+  const ended = op.step({ op: 'ended', orderId: 'ORD-1', fulfilmentId: 'ORD-1-F2', end: 'failed', at: T },
+    { key: 'ORD-1', state: { state: 'processing', outcome: null, at: T }, now: T, states: { statuses: { 'ORD-1': { order: 'processing', fulfilments: { 'ORD-1-F1': 'completed', 'ORD-1-F2': 'failed' } } } } });
+  assert.deepEqual(sets(ended), ['order=completed']);
+  assert.equal(ended.output.outcome, 'completed');
+});
+
+test('the outcome is failed, else cancelled, when no fulfilment completed (R4.5)', () => {
+  const failed = op.step({ op: 'ended', orderId: 'ORD-1', fulfilmentId: 'ORD-1-F2', end: 'failed', at: T },
+    { key: 'ORD-1', state: { state: 'processing', outcome: null, at: T }, now: T, states: { statuses: { 'ORD-1': { order: 'processing', fulfilments: { 'ORD-1-F1': 'cancelled', 'ORD-1-F2': 'failed' } } } } });
+  assert.deepEqual(sets(failed), ['order=failed']);
+  const cancelled = op.step({ op: 'ended', orderId: 'ORD-1', fulfilmentId: 'ORD-1-F1', end: 'stopped', at: T },
+    { key: 'ORD-1', state: { state: 'processing', outcome: null, at: T }, now: T, states: { statuses: { 'ORD-1': { order: 'processing', fulfilments: { 'ORD-1-F1': 'cancelled', 'ORD-1-F2': 'cancelled' } } } } });
+  assert.deepEqual(sets(cancelled), ['order=cancelled']);
+});
+
+test('while a fulfilment is still open, the order is not decided (R4.5)', () => {
+  const r = op.step({ op: 'ended', orderId: 'ORD-1', fulfilmentId: 'ORD-1-F2', end: 'failed', at: T },
+    { key: 'ORD-1', state: { state: 'processing', outcome: null, at: T }, now: T, states: { statuses: { 'ORD-1': { order: 'processing', fulfilments: { 'ORD-1-F1': 'processing', 'ORD-1-F2': 'failed' } } } } });
+  assert.equal(r.effects.length, 0);
+  assert.equal(r.output.state, 'processing');
+});
+
+test('a stop from cancellation stops the order, so R4.5 does not decide it (R6.2)', () => {
+  const r = op.step({ op: 'stop', orderId: 'ORD-1', at: T }, { key: 'ORD-1', state: { state: 'processing', outcome: null, at: T }, now: T, states: {} });
+  assert.equal(r.output.state, 'stopped');
+  assert.equal(r.effects.length, 0);
+});
diff -ruN a/tests/statuses.test.mjs b/tests/statuses.test.mjs
--- a/tests/statuses.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/statuses.test.mjs	2026-11-04 14:33:20.048487627 +0000
@@ -0,0 +1,63 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { moduleHarness } from '../compose-kit/kit.mjs';
+
+const st = moduleHarness('statuses');
+const NOW = '2026-03-02T10:00:00+01:00';
+const FULS = [{ fulfilmentId: 'F1', location: 'AMS' }, { fulfilmentId: 'F2', location: null }];
+
+function init() {
+  return st.step({ op: 'init', fulfilments: FULS }, { key: 'ORD-1', state: null, now: NOW });
+}
+
+test('init records pending order and unavailable fulfilment without effects (R7.2)', () => {
+  const r = init();
+  assert.equal(r.violations.length, 0);
+  assert.equal(r.effects.length, 0);
+  assert.equal(r.state.order, 'pending');
+  assert.deepEqual(r.state.fulfilments, { F1: 'pending', F2: 'unavailable' });
+});
+
+test('set before init is refused (R4.1)', () => {
+  const r = st.step({ op: 'set', orderId: 'ORD-1', fulfilmentId: 'F1', status: 'processing' }, { key: 'ORD-1', state: null, now: NOW });
+  assert.equal(r.effects.length, 0);
+});
+
+test('forward move emits one setStatus with a stable key', () => {
+  const s = init();
+  const r = st.step({ op: 'set', orderId: 'ORD-1', fulfilmentId: 'F1', status: 'processing' }, { key: 'ORD-1', state: s.state, now: NOW });
+  assert.equal(r.effects.length, 1);
+  assert.equal(r.effects[0].key, 'f.F1.processing');
+  assert.deepEqual(r.effects[0].args, { orderId: 'ORD-1', fulfilmentId: 'F1', status: 'processing' });
+});
+
+test('a repeat or a backward move emits nothing (R7.2)', () => {
+  let s = init();
+  s = st.step({ op: 'set', orderId: 'ORD-1', fulfilmentId: 'F1', status: 'processing' }, { key: 'ORD-1', state: s.state, now: NOW });
+  const again = st.step({ op: 'set', orderId: 'ORD-1', fulfilmentId: 'F1', status: 'processing' }, { key: 'ORD-1', state: s.state, now: NOW });
+  assert.equal(again.effects.length, 0);
+  const back = st.step({ op: 'set', orderId: 'ORD-1', fulfilmentId: 'F1', status: 'pending' }, { key: 'ORD-1', state: s.state, now: NOW });
+  assert.equal(back.effects.length, 0);
+});
+
+test('unavailable to cancelled is allowed (R3.2, R6.1)', () => {
+  const s = init();
+  const r = st.step({ op: 'set', orderId: 'ORD-1', fulfilmentId: 'F2', status: 'cancelled' }, { key: 'ORD-1', state: s.state, now: NOW });
+  assert.equal(r.effects.length, 1);
+  assert.equal(r.effects[0].key, 'f.F2.cancelled');
+});
+
+test('delivered without dispatched: dispatched first, completed after it (R4.4)', () => {
+  let s = init();
+  s = st.step({ op: 'set', orderId: 'ORD-1', fulfilmentId: 'F1', status: 'processing' }, { key: 'ORD-1', state: s.state, now: NOW });
+  const r = st.step({ op: 'set', orderId: 'ORD-1', fulfilmentId: 'F1', status: 'completed', afterStatus: 'dispatched' }, { key: 'ORD-1', state: s.state, now: NOW });
+  assert.deepEqual(r.effects.map(e => e.key), ['f.F1.dispatched', 'f.F1.completed']);
+  assert.equal(r.effects[1].after, 'f.F1.dispatched');
+});
+
+test('order status is set on the order (fulfilmentId null)', () => {
+  let s = init();
+  s = st.step({ op: 'set', orderId: 'ORD-1', fulfilmentId: null, status: 'processing' }, { key: 'ORD-1', state: s.state, now: NOW });
+  assert.equal(s.effects[0].key, 'order.processing');
+  assert.equal(s.effects[0].args.fulfilmentId, null);
+});
