+test('a transient reserve error after a cancel is not re-issued: nothing new is reserved, and the fulfilment ends (R6.2)', () => {
+  const s0 = fulfilment.step({ op: 'start', fulfilment: fInput }, { key, state: null, now: NOW, files });
+  const c = fulfilment.step({ op: 'cancel', at: NOW, reason: 'customer' }, { key, state: s0.state, now: NOW, files });
+  assert.equal(c.output.ended, null);
+  const r = fulfilment.onEvent(result(RES, 'error', { error: { code: 'batch-item-not-processed', retryable: true } }), { key, state: c.state, now: NOW, files });
+  assert.equal(r.effects.some(e => e.op === 'reserve'), false);
+  assert.deepEqual(r.output.ended, { fid: 'ORD-1-F1', status: 'cancelled', at: NOW });
+});
