+  if (next.ship !== 'ok') return { state: { ...next, phase: 'shipping' }, effects: [shipEffect(next)], output: { phase: 'shipping' } };
+  return { state: { ...next, phase: 'shipped' }, output: { phase: 'shipped' } };
