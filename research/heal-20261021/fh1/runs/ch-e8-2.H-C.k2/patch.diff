+  const items = input.items.map((it, i) => ({ key: `r${i}`, sku: it.sku, qty: it.qty }));
+  const left = [...(input.reservedSkus ?? [])];
+  const res = {};
+  for (const it of items) {
+    const j = left.indexOf(it.sku);
+    if (j >= 0) { left.splice(j, 1); res[it.key] = 'ok'; }
+  }
