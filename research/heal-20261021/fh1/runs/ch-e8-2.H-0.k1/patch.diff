+// The Amsterdam calendar date of an instant: CEST (+2) from the last Sunday of March to the last Sunday of October
+// (01:00 UTC on those Sundays), CET (+1) otherwise. Written out so it does not depend on the runtime's Intl data.
+function amsterdamDate(iso) {
+  const t = Date.parse(iso);
+  const y = new Date(t).getUTCFullYear();
+  const lastSunday = m => { const d = new Date(Date.UTC(y, m + 1, 0)); return Date.UTC(y, m, d.getUTCDate() - d.getUTCDay(), 1); };
+  const summer = t >= lastSunday(2) && t < lastSunday(9);
+  return new Date(t + (summer ? 2 : 1) * 3600000).toISOString().slice(0, 10);
+}
