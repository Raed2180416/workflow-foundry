+// The order a migration is for: named by its payload, its records or the placed order it carries (§3.5).
+function migrationOrder(sub, ctx) {
+  const placedEv = (sub.events ?? []).find(e => e?.type === 'order.placed');
+  const raw = sub.orderId ?? sub.orderRef ?? sub.records?.['orders.orders']?.[0]?.orderId ?? placedEv?.payload?.orderId
+    ?? sub.records?.['orders.fulfilments']?.[0]?.orderId;
+  return raw === undefined ? '' : norm(raw);
+}
+
+// The records of one table for an order: a migration carries the records that exist for it; otherwise the store has them.
+function rowsOf(ctx, sub, table, where) {
+  const carried = sub?.records?.[table];
+  if (!Array.isArray(carried)) return ctx.query(table, { where, limit: 50 });
+  return carried.filter(r => Object.entries(where).every(([k, v]) => r?.[k] === v));
+}
