+// A go-live export (§3.5) is { records, events }: its records and the messages already received. The order it belongs
+// to is named by its records, or else by a message that names one.
+const innerEvents = ev => (Array.isArray(ev?.payload?.events) ? ev.payload.events : []);
+function exportOrderId(sub) {
+  const rows = [...(sub.records?.['orders.orders'] ?? []), ...(sub.records?.['orders.fulfilments'] ?? [])];
+  const named = [...rows.map(r => r?.orderId), ...(sub.events ?? []).map(e => e?.payload?.orderId ?? e?.payload?.orderRef), sub.orderId, sub.orderRef];
+  const id = named.find(x => typeof x === 'string' && x.trim() !== '');
+  return id === undefined ? null : norm(id);
+}
+
+// The rows of one business table for this order: the export's own copy at go-live, else the records (§3.5).
+function rowsOf(sub, ctx, table, where) {
+  const own = sub.records?.[table];
+  const rows = Array.isArray(own) ? own : ctx.query(table, { where, limit: 200 });
+  return rows.filter(r => Object.entries(where).every(([k, v]) => r?.[k] === v));
+}
