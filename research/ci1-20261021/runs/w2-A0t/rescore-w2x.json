{
 "label": "w2-A0t",
 "oracle": "v2 + post hoc w2x transforms (experiments/ci1-posthoc/rescore-w2x.mjs)",
 "decl": {
  "17175": [
   {
    "kind": "ambiguous",
    "why": "The description asks for the formula-injection apostrophe \"in both sheets\" and to answer \"with the lead itself\"; whether the answer carries the sheet-escaped values is not said. A leading apostrophe in answer fields is ignored."
   }
  ],
  "17771": [
   {
    "kind": "oracle",
    "why": "An e-mail address logged in a sheet cell differs only in letter case (the reference logs the first line's raw casing, NOOR.FAIRHURST@...); addresses are case-insensitive and the oracle already lower-cases mail recipients."
   },
   {
    "kind": "ambiguous",
    "why": "The description says to greet a customer without a name by their e-mail and to log customer_name; whether the log takes the greeting fallback is not said. A blank logged name where the reference logs the e-mail is accepted."
   }
  ],
  "18797": [
   {
    "kind": "oracle",
    "why": "A build that names the invoice Owner (a categorical column, e.g. \"Pavel Okonkwo\") in the escalation e-mail was counted as mentioning another invoice whose client shares that first name (\"Pavel Rothwell\"). Words that occur in a categorical cell no longer identify other rows."
   }
  ],
  "19014": [
   {
    "kind": "ambiguous",
    "why": "The duplicate answer's clientId: the description names \"the existing client's Client ID\" for the e-mail and only \"clientId\" for the answer; the reference answers with the newly computed ID, every build with the existing one."
   },
   {
    "kind": "oracle",
    "why": "Mentioning the project manager's address from the one-row settings sheet (onboarding-config) in the welcome e-mail counted as leaking a row the reference leaves out; a settings row is not a data row."
   }
  ],
  "19187": [
   {
    "kind": "ambiguous",
    "why": "Description: \"Evaluation Date and Logged At (now)\". Every build (6 of 6 before this audit) wrote a date for the column named Date; the reference writes the full date-time. Compared on the day."
   }
  ],
  "20090": [
   {
    "kind": "oracle",
    "why": "The answer's message: for a reschedule the description leaves it unspecified, for a cancel it asks for the appointment's date and time; the reference message also carries the appointment ID (already its own field), which the oracle required as a fact. The reschedule message is free text; the ID is not required in the cancel message."
   }
  ]
 },
