          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    }
  },
  "envelope": {
    "assumptions": [
      "Independently supplied audit graph"
    ],
    "risks": [
      "May deliberately violate public constraints"
    ],
    "successCriteria": [
      "Record real evaluator result and trace"
    ]
  },
  "budget": {
    "maxSteps": 40,
    "maxConcurrency": 1,
    "maxDurationMs": 5000,
    "maxCost": 0
  },
  "nodes": [
    {
      "id": "nothing",
      "kind": "task",
      "description": "Independent audit nothing",
      "tool": "core.identity",
      "args": {
        "done": true
      },
      "needs": [],
      "timeoutMs": 1000,
      "retry": {
        "maxAttempts": 1
      }
    }
  ],
  "acceptance": [
    {
      "op": "eq",
      "left": {
        "$ref": "nodes.nothing.done"
      },
      "right": true
    }
  ]
}
