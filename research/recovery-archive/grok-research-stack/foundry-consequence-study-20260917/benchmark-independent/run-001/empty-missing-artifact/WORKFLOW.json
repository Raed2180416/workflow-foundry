{
  "schemaVersion": "1.0",
  "id": "EmptyWithoutManifest",
  "version": 1,
  "title": "EmptyWithoutManifest",
  "goal": "Independently handcrafted evaluator attack; no construction quality claim",
  "domain": "diagnostic",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "samples"
    ],
    "properties": {
      "samples": {
        "type": "array",
        "maxItems": 6,
        "uniqueItems": true,
