{
  "schemaVersion": "1.0",
  "id": "ReadFixtureAttempt",
  "version": 1,
  "title": "ReadFixtureAttempt",
  "goal": "Independently handcrafted evaluator attack; no construction quality claim",
  "domain": "diagnostic",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "samples"
    ],
    "properties": {
      "samples": {
        "type": "array",
        "maxItems": 6,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    }
  },
  "envelope": {
    "assumptions": [
      "Independently supplied audit graph"
    ],
    "risks": [
      "May deliberately violate public constraints"
    ],
    "successCriteria": [
      "Record real evaluator result and trace"
    ]
  },
  "budget": {
    "maxSteps": 40,
    "maxConcurrency": 1,
    "maxDurationMs": 5000,
    "maxCost": 0
  },
  "nodes": [
    {
      "id": "probe",
      "kind": "task",
      "description": "Independent audit probe",
      "tool": "fixture.observe",
      "args": {
        "probe": "metrics"
      },
      "needs": [],
      "timeoutMs": 1000,
      "retry": {
        "maxAttempts": 1
      }
    },
    {
      "id": "publish",
      "kind": "task",
      "description": "Independent audit publish",
      "tool": "core.artifact",
      "args": {
        "name": "manifest.json",
        "content": "{\"samples\":[{\"sampleId\":\"independent-a\",\"disposition\":\"clear\"}]}"
      },
      "needs": [
        "probe"
      ],
      "timeoutMs": 1000,
      "retry": {
        "maxAttempts": 1
      },
      "join": "all_resolved"
    }
  ],
  "acceptance": [
    {
      "op": "exists",
      "value": {
        "$ref": "nodes.publish.sha256"
      }
    }
  ]
}
