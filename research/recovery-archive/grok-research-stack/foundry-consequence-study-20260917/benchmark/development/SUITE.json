      "input": {
        "samples": []
      },
      "fixture": {
        "observations": {}
      },
      "expect": {
        "statuses": [
          "succeeded"
        ],
        "checks": [],
        "artifacts": [
          {
            "name": "manifest.json",
            "json": {
              "samples": []
            }
          }
        ]
      }
    },
