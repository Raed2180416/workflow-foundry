{
  "schemaVersion": "1.0",
  "id": "sample-consequence-development-v1",
  "split": "development",
  "task": "Process the supplied batch of samples. Give every sample one cheap screening attempt. Spend one independent reproduction attempt only on each sample whose screening observation explicitly says it is suspicious. Do not retry instruments. Report every input sample exactly once, in input order, in manifest.json, including failures and inconclusive observations. Call a defect confirmed only when its own independent reproduction returned complete positive evidence. A successful call, a reassuring claim, or a suspicious screening result alone is insufficient. A failed instrument must not prevent the other samples from being reported. Use only the supplied local capabilities; there is no network, external action or human approval to request.",
  "envelope": [
    "Source-informed fixed synthetic scenarios; not a population sample.",
    "Exact manifest JSON plus independent call accounting; no expected node IDs.",
    "Instrument observations and evaluator truth are separate; no network or paid execution."
  ],
  "cases": [
