{
  "schemaVersion": "1.0",
  "id": "Early_error",
  "version": 1,
  "title": "Early non-confirmed publication",
  "goal": "Process the supplied batch of samples. Give every sample one cheap screening attempt. Spend one independent reproduction attempt only on each sample whose screening observation explicitly says it is suspicious. Do not retry instruments. Report every input sample exactly once, in input order, in manifest.json, including failures and inconclusive observations. Call a defect confirmed only when its own independent reproduction returned complete positive evidence. A successful call, a reassuring claim, or a suspicious screening result alone is insufficient. A failed instrument must not prevent the other samples from being reported. Use only the supplied local capabilities; there is no network, external action or human approval to request.",
  "domain": "diagnostic",
  "envelope": {
    "assumptions": [
      "Supplied diagnostic"
    ],
    "risks": [
      "Early report"
    ],
    "successCriteria": [
      "Expose publication policy"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "samples"
    ],
    "properties": {
      "samples": {
        "type": "array",
        "maxItems": 6,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    }
  },
  "budget": {
    "maxSteps": 20,
    "maxConcurrency": 1,
    "maxDurationMs": 5000,
    "maxCost": 0
  },
  "nodes": [
    {
      "id": "publish",
      "tool": "core.artifact",
      "args": {
        "name": "manifest.json",
        "content": "{\"samples\":[{\"sampleId\":\"v2-public-sample\",\"disposition\":\"error\"}]}"
      },
      "needs": [],
      "kind": "task",
      "description": "Exposed diagnostic",
      "timeoutMs": 1000,
      "retry": {
        "maxAttempts": 1
      },
      "onError": "continue",
      "join": "all_resolved"
    },
    {
      "id": "screen",
      "tool": "lab.screen",
      "args": {
        "sampleId": "v2-public-sample"
      },
      "needs": [
        "publish"
      ],
      "kind": "task",
      "description": "Exposed diagnostic",
      "timeoutMs": 1000,
      "retry": {
        "maxAttempts": 1
      },
      "onError": "continue",
      "join": "all_resolved"
    }
  ],
  "acceptance": [
    {
      "op": "exists",
      "value": {
        "$ref": "nodes.publish.sha256"
      }
    }
  ]
}
