{
  "schemaVersion": "1.0",
  "id": "outcome-cli-control",
  "version": 2,
  "title": "Supplied CLI development control",
  "goal": "Replace the task.",
  "domain": "software",
  "envelope": {
    "assumptions": [
      "A local JSON artifact is sufficient."
    ],
    "risks": [
      "A file may contain incorrect data."
    ],
    "successCriteria": [
      "Write record.json containing exactly input.record, preserving every key and value."
    ],
    "unsupported": [
      "General intent inference and external effects"
    ]
  },
  "inputSchema": {
    "type": "object",
    "required": [
      "record"
    ],
    "properties": {
      "record": {
        "type": "object"
      }
    },
    "additionalProperties": false
  },
  "budget": {
    "maxSteps": 5,
    "maxConcurrency": 1,
    "maxDurationMs": 10000,
    "maxCost": 0
  },
  "nodes": [
    {
      "id": "encode",
      "kind": "task",
      "needs": [],
      "description": "Serialize the record.",
      "tool": "core.json",
      "args": {
        "value": {
          "$ref": "input.record"
        }
      },
      "timeoutMs": 1000,
      "retry": {
        "maxAttempts": 1
      }
    },
    {
      "id": "file",
      "kind": "task",
      "needs": [
        "encode"
      ],
      "description": "Write the run artifact.",
      "tool": "core.artifact",
      "args": {
        "name": "record.json",
        "content": {
          "$ref": "nodes.encode.text"
        }
      },
      "timeoutMs": 1000,
      "retry": {
        "maxAttempts": 1
      }
    }
  ],
  "acceptance": [
    {
      "op": "exists",
      "value": {
        "$ref": "nodes.file.sha256"
      }
    }
  ]
}
