{
  "schemaVersion": "1.0",
  "id": "Objcdb582e85aad",
  "version": 1,
  "title": "Evaluate a game by running matches, scoring, and retrying flaky runs",
  "goal": "Evaluate a game by running matches, scoring, and retrying flaky runs",
  "domain": "evaluation",
  "envelope": {
    "assumptions": [
      "Local Foundry IR only",
      "Capabilities are the default registry"
    ],
    "risks": [
      "Named IR limits are not vendor protocols"
    ],
    "successCriteria": [
      "Independent acceptance checks pass",
      "Unsupported IR requests stay named and unexecuted"
    ],
    "unsupported": [
      "delayMsMax:3600000",
      "compensateKind:false",
      "continueAsNew:false",
      "timerDispatch:persisted-wake-reinvoke",
      "waitCrashRestartsDeadline:true",
      "budgetPolicyCapMs:3600000",
      "singleWriterPerKey:false",
      "eventCronTrigger:false",
      "constructionDrivesGenerator:false"
    ]
  },
  "inputSchema": {
    "type": "object"
  },
  "budget": {
    "maxSteps": 80,
    "maxConcurrency": 2,
    "maxDurationMs": 3600000,
    "maxCost": 0
  },
  "nodes": [
    {
      "id": "matches",
      "kind": "map",
      "needs": [],
      "description": "Score each match with a bounded fan-out",
      "items": {
        "$ref": "input.matches"
      },
      "maxItems": 32,
      "body": {
        "nodes": [
          {
            "id": "score",
            "kind": "task",
            "needs": [],
            "description": "Score one match",
            "tool": "core.identity",
            "args": {
              "scored": true
            },
            "timeoutMs": 5000,
            "retry": {
              "maxAttempts": 2,
              "backoffMs": 100
            }
          }
        ],
        "acceptance": [
          {
            "op": "eq",
            "left": {
              "$ref": "nodes.score.scored"
            },
            "right": true
          }
        ]
      }
    },
    {
      "id": "retryFlaky",
      "kind": "loop",
      "needs": [
        "matches"
      ],
      "description": "Retry flaky evaluation with a hard iteration cap",
      "maxIterations": 3,
      "initial": {
        "attempt": 0
      },
      "until": {
        "op": "eq",
        "left": {
          "$ref": "nodes.probe.ok"
        },
        "right": true
      },
      "body": {
        "nodes": [
          {
            "id": "probe",
            "kind": "task",
            "needs": [],
            "description": "Probe one attempt",
            "tool": "core.identity",
            "args": {
              "ok": true
            },
            "timeoutMs": 5000,
            "retry": {
              "maxAttempts": 2,
              "backoffMs": 100
            }
          }
        ],
        "acceptance": [
          {
            "op": "exists",
            "value": {
              "$ref": "nodes.probe.ok"
            }
          }
        ]
      }
    },
    {
      "id": "validate",
      "kind": "task",
      "needs": [
        "retryFlaky"
      ],
      "description": "Validate grounding before send",
      "tool": "core.validate",
      "args": {
        "value": {
          "$ref": "input.claim",
          "default": {
            "grounded": true
          }
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grounded"
          ],
          "properties": {
            "grounded": {
              "type": "boolean"
            }
          }
        }
      },
      "timeoutMs": 5000,
      "retry": {
        "maxAttempts": 2,
        "backoffMs": 100
      }
    },
    {
      "id": "verify",
      "kind": "assert",
      "needs": [
        "validate"
      ],
      "description": "Fail closed on acceptance evidence",
      "checks": [
        {
          "op": "eq",
          "left": {
            "$ref": "nodes.validate.valid"
          },
          "right": true
        }
      ]
    },
    {
      "id": "artifact",
      "kind": "task",
      "needs": [
        "verify"
      ],
      "description": "Write an inspectable receipt",
      "tool": "core.artifact",
      "args": {
        "name": "receipt.json",
        "content": "{\"status\":\"composed\"}"
      },
      "timeoutMs": 5000,
      "retry": {
        "maxAttempts": 2,
        "backoffMs": 100
      }
    }
  ],
  "acceptance": [
    {
      "op": "exists",
      "value": {
        "$ref": "nodes.verify.id",
        "default": "verify"
      }
    }
  ],
  "metadata": {
    "sources": [
      "construction-objective"
    ],
    "rationale": "Composed from grounded requirement cues onto Foundry IR; named limits are not vendor protocols.",
    "tags": [
      "recovery",
      "map-fanout",
      "loop-until",
      "verification"
    ]
  }
}
