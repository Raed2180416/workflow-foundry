{
  "schemaVersion": "1.0",
  "id": "Obj1e65c403fc34",
  "version": 1,
  "title": "Wait thirty days then verify",
  "goal": "Wait thirty days then verify",
  "domain": "business",
  "envelope": {
    "assumptions": [
      "Local Foundry IR only",
      "Capabilities are the default registry",
      "Claim input is caller-supplied and requires independent verification"
    ],
    "risks": [
      "Named IR limits are not vendor protocols",
      "delayMsMax cannot execute days-or-months-scale"
    ],
    "successCriteria": [
      "Local acceptance checks pass on supplied data",
      "Unsupported IR requests stay named and unexecuted"
    ],
    "unsupported": [
      "delayMsMax:3600000",
      "compensateKind:false",
      "continueAsNew:false",
      "timerDispatch:persisted-wake-reinvoke",
      "waitCrashRestartsDeadline:true",
      "budgetPolicyCapMs:3600000",
      "singleWriterPerKey:false",
      "eventCronTrigger:false",
      "constructionDrivesGenerator:false",
      "requested:days-or-months-scale;limit:delayMsMax"
    ]
  },
  "inputSchema": {
    "type": "object"
  },
  "budget": {
    "maxSteps": 80,
    "maxConcurrency": 2,
    "maxDurationMs": 3600000,
    "maxCost": 0
  },
  "nodes": [
    {
      "id": "pay",
      "kind": "task",
      "needs": [],
      "description": "Irreversible side effect isolated from wait replay",
      "tool": "core.identity",
      "args": {
        "paid": true
      },
      "timeoutMs": 5000,
      "retry": {
        "maxAttempts": 2,
        "backoffMs": 100
      }
    },
    {
      "id": "pause",
      "kind": "wait",
      "needs": [
        "pay"
      ],
      "description": "Bounded durable wait (Foundry delayMs max 1 hour)",
      "delayMs": 3600000
    },
    {
      "id": "validate",
      "kind": "task",
      "needs": [
        "pause"
      ],
      "description": "Require the supplied claim to be explicitly marked grounded",
      "tool": "core.validate",
      "args": {
        "value": {
          "$ref": "input.claim",
          "default": null
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grounded"
          ],
          "properties": {
            "grounded": {
              "type": "boolean",
              "const": true
            }
          }
        }
      },
      "timeoutMs": 5000,
      "retry": {
        "maxAttempts": 2,
        "backoffMs": 100
      }
    },
    {
      "id": "verify",
      "kind": "assert",
      "needs": [
        "validate"
      ],
      "description": "Fail closed on acceptance evidence",
      "checks": [
        {
          "op": "eq",
          "left": {
            "$ref": "nodes.validate.valid"
          },
          "right": true
        }
      ]
    },
    {
      "id": "artifact",
      "kind": "task",
      "needs": [
        "verify"
      ],
      "description": "Write an inspectable receipt",
      "tool": "core.artifact",
      "args": {
        "name": "receipt.json",
        "content": "{\"status\":\"composed\"}"
      },
      "timeoutMs": 5000,
      "retry": {
        "maxAttempts": 2,
        "backoffMs": 100
      }
    }
  ],
  "acceptance": [
    {
      "op": "eq",
      "left": {
        "$ref": "nodes.verify.passed",
        "default": false
      },
      "right": true
    }
  ],
  "metadata": {
    "sources": [
      "construction-objective"
    ],
    "rationale": "Keyword-based composition of local Foundry IR with supplied values; requires independent task verification.",
    "tags": [
      "durable-wait",
      "verification"
    ]
  }
}
