{
  "$comment": "Proposal (owner decision O-H, research/onboarding-20261021/SPEC.md §8). The constitution-v0 vocabulary (experiments/constitution/schema/constitution-v0.schema.json) generalised: parameters are a map {name: {value, unit}}, clause ids are free, check.kind is one of four code-evaluable kinds, and each clause carries force, mode, confirmed examples and what it does not cover. Portable subset only (no patterns, no formats).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "supersedes", "entity", "createdAt", "layers", "roles", "principals", "parameters", "bounds", "approvals", "clauses", "where", "change", "signedBy"],
  "properties": {
    "kind": { "const": "foundry.authority-map/v1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "integer", "minimum": 0 },
    "supersedes": { "type": ["string", "null"], "minLength": 64, "maxLength": 64 },
    "entity": { "type": "string", "minLength": 1, "maxLength": 120 },
    "createdAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "starter": { "enum": ["just-me", "small-team", "refund", "blank"] },
    "layers": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "enum": ["regulation", "org-policy", "entity-rule", "process", "workflow"] } },
    "roles": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 60 }, "name": { "type": "string", "minLength": 1, "maxLength": 60 }, "description": { "type": "string", "maxLength": 400 } } } },
    "principals": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "roles"],
      "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 80 }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "kind": { "enum": ["human", "service", "customer-class"] },
        "roles": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 60 } }, "self": { "type": "boolean" }, "email": { "type": "string", "maxLength": 254 } } } },
    "parameters": { "type": "object", "maxProperties": 50, "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["value", "unit"],
      "properties": { "value": { "type": "number" }, "unit": { "type": "string", "minLength": 1, "maxLength": 20 }, "label": { "type": "string", "maxLength": 120 } } } },
    "bounds": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": ["id", "layer", "owner", "parameter", "statement"],
      "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 60 }, "layer": { "enum": ["regulation", "org-policy", "entity-rule", "process", "workflow"] }, "owner": { "type": "string", "minLength": 1, "maxLength": 80 },
        "parameter": { "type": "string", "minLength": 1, "maxLength": 80 }, "min": { "type": "number" }, "max": { "type": "number" }, "statement": { "type": "string", "maxLength": 1000 } } } },
    "approvals": { "type": "array", "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["id", "actionClass", "approverRole", "remindAfterHours", "stopAfterHours", "excluded"],
      "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 40 }, "actionClass": { "enum": ["money-out", "message-outside", "change-records", "delete"] },
        "aboveParameter": { "type": "string", "maxLength": 80 }, "approverRole": { "type": "string", "maxLength": 60 }, "approverPrincipal": { "type": "string", "maxLength": 80 }, "backupPrincipal": { "type": "string", "maxLength": 80 },
        "remindAfterHours": { "type": "integer", "minimum": 1, "maximum": 720 }, "stopAfterHours": { "type": "integer", "minimum": 1, "maximum": 2160 },
        "excluded": { "type": "array", "maxItems": 4, "items": { "enum": ["requester", "entered-by"] } } } } },
    "clauses": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "title", "layer", "owner", "assurance", "statement", "check", "narrows", "exceptions", "evidence", "force", "mode", "examples", "doesNotCover"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 40 }, "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "layer": { "enum": ["regulation", "org-policy", "entity-rule", "process", "workflow"] },
        "owner": { "type": "object", "additionalProperties": false, "required": ["role", "principal"], "properties": { "role": { "type": "string", "maxLength": 60 }, "principal": { "type": "string", "maxLength": 80 } } },
        "assurance": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "enum": ["provable", "monitorable", "judged"] } },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "check": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": {
          "kind": { "enum": ["approval-above-threshold", "separation-of-duties", "never-outside-domain", "max-per-run"] },
          "parameter": { "type": "string", "maxLength": 80 }, "approverRole": { "type": "string", "maxLength": 60 }, "excludeRequester": { "type": "boolean" },
          "roles": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 60 } }, "domain": { "type": "string", "maxLength": 253 },
          "effect": { "type": "string", "maxLength": 80 }, "n": { "type": "integer", "minimum": 0, "maximum": 1000000 } } },
        "narrows": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 60 } },
        "exceptions": { "type": "array", "maxItems": 10, "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "who", "when", "requires", "reviewBy", "reviewWithinHours"],
          "properties": { "id": { "type": "string", "maxLength": 40 }, "kind": { "enum": ["break-glass", "emergency-change"] }, "who": { "type": "string", "maxLength": 60 }, "when": { "type": "string", "maxLength": 400 },
            "requires": { "type": "array", "maxItems": 3, "items": { "enum": ["justification", "after-the-fact-review", "journal"] } }, "reviewBy": { "type": "string", "maxLength": 60 }, "reviewWithinHours": { "type": "integer", "minimum": 1, "maximum": 720 } } } },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "object", "additionalProperties": false, "required": ["id", "what", "source"],
          "properties": { "id": { "type": "string", "maxLength": 40 }, "what": { "type": "string", "maxLength": 400 }, "source": { "type": "string", "maxLength": 200 } } } },
        "force": { "enum": ["tell", "stop-unless-override", "stop"] },
        "mode": { "enum": ["preview", "on"] },
        "examples": { "type": "array", "minItems": 6, "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["n", "case", "label", "answer", "confirmed"],
          "properties": { "n": { "type": "integer", "minimum": 1 }, "case": { "type": "object", "maxProperties": 6 }, "label": { "type": "string", "maxLength": 200 },
            "answer": { "enum": ["allowed", "held", "blocked"] }, "confirmed": { "type": "boolean" } } } },
        "doesNotCover": { "type": "string", "maxLength": 600 } } } },
    "where": { "type": "object", "additionalProperties": false, "required": ["allowedAI", "practiceOnly", "records"],
      "properties": { "allowedAI": { "enum": ["none", "mercury"] }, "practiceOnly": { "type": "boolean" }, "records": { "enum": ["this-computer"] } } },
    "change": { "type": "object", "additionalProperties": false, "required": ["proposerRoles", "approverRole", "proposerMayApprove", "approvalBeforeEffective"],
      "properties": { "proposerRoles": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "maxLength": 60 } }, "approverRole": { "type": "string", "maxLength": 60 },
        "proposerMayApprove": { "type": "boolean" }, "approvalBeforeEffective": { "type": "boolean" } } },
    "signedBy": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 80 } }
  }
}
