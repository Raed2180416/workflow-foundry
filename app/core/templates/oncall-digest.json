{
  "template": {
    "id": "oncall-digest",
    "title": "On-call digest of unresolved alerts to a chat channel, with optional paging",
    "author": "claude-opus-5-5 (frontier author; hand-written 2026-10-21 for research/surface-20261021 BUILDER-1)",
    "whenToUse": "Someone wants a regular summary of recent unresolved alerts (from their monitoring export) posted to a team chat channel, and optionally an e-mail page for critical alerts nobody acknowledged.",
    "notFor": "Restarting or fixing services, phone calls or SMS, creating incidents in PagerDuty/Opsgenie, or reports about tasks, sales or money.",
    "sources": ["experiments/library/cards/catalog.json P01 linear pipeline, P04 draft -> check -> deliver", "research/intent-20261021/corpus-prior.md (messaging automations: schedules 44%, failure notification 15%)"],
    "slots": [
      { "name": "channel", "type": "channel", "grounded": true, "ask": "wrong-target", "question": "Which chat channel should get the digest? (for example #ops)", "askWhy": "The digest goes to everyone in that channel; I will not guess it.", "description": "Chat channel that gets the digest, like #ops." },
      { "name": "windowHours", "type": "integer", "min": 1, "max": 168, "default": 24, "description": "How many hours back the digest looks." },
      { "name": "minSeverity", "type": "enum", "values": ["info", "warning", "critical"], "default": "warning", "description": "Lowest severity to include." },
      { "name": "page", "type": "boolean", "default": false, "description": "Also e-mail one person right away about each critical alert nobody has acknowledged." },
      { "name": "pageTo", "type": "email", "grounded": true, "default": "", "ask": "wrong-target", "askWhen": "page", "question": "Who should be paged about critical alerts? (one e-mail address)", "askWhy": "A page wakes someone up; I will not guess who.", "description": "E-mail address paged for unacknowledged critical alerts (only when page is true; empty otherwise)." }
    ],
    "capabilities": ["sheet.read", "rows.age", "rows.filter", "rows.lines", "rows.select", "core.template", "core.pluck", "chat.post", "chat.audit", "outbox.send", "outbox.audit"],
    "data": { "alerts": "one row per alert: id, at (ISO date-time), service, severity (info | warning | critical), message, acknowledged (true | false), resolved (true | false)" },
    "willDo": ["Read the alerts and keep the unresolved ones from the last [[windowHours]] hours at [[minSeverity]] or above", "Post one digest to [[channel]], after you approve the post",
      { "if": "page", "text": "E-mail [[pageTo]] about each critical alert nobody acknowledged, after you approve each one" }, "Check, by re-reading the channel and the outbox, that exactly the planned messages went out"],
    "willNotDo": ["Restart, fix or silence anything", { "if": "!page", "text": "Page or e-mail anyone" }, "Post to any other channel", "Run by itself: you (or your coding agent) start each run"],
    "example": {"channel": "#ops", "windowHours": 12, "minSeverity": "warning", "page": true, "pageTo": "oncall@practice.example"},
    "practice": {
      "now": "2026-10-18T08:00:00Z",
      "sheets": { "alerts": [
        { "id": "PA-1", "at": "2026-10-18T02:15:00Z", "service": "practice-api", "severity": "critical", "message": "5xx above 5%", "acknowledged": false, "resolved": false },
        { "id": "PA-2", "at": "2026-10-17T20:00:00Z", "service": "practice-db", "severity": "warning", "message": "Disk 85% full", "acknowledged": true, "resolved": false },
        { "id": "PA-3", "at": "2026-10-17T22:40:00Z", "service": "practice-web", "severity": "info", "message": "Deploy finished", "acknowledged": false, "resolved": false },
        { "id": "PA-4", "at": "2026-10-16T09:00:00Z", "service": "practice-api", "severity": "critical", "message": "Old outage", "acknowledged": true, "resolved": false },
        { "id": "PA-5", "at": "2026-10-18T05:00:00Z", "service": "practice-queue", "severity": "critical", "message": "Backlog", "acknowledged": true, "resolved": true } ] }
    }
  },
  "workflow": {
    "schemaVersion": "1.0", "id": "oncall-digest", "version": 1,
    "title": "On-call digest for [[channel]]",
    "goal": "Each run, post one digest of the unresolved alerts of the last [[windowHours]] hours ([[minSeverity]] and above) to [[channel]] after a person approves the post.",
    "domain": "general",
    "envelope": {
      "assumptions": ["The alerts sheet holds one row per alert with id, at, service, severity, message, acknowledged and resolved", "The channel is a local file standing in for chat and the outbox stands in for e-mail; nothing leaves this machine"],
      "risks": ["Posting to the wrong channel", "Missing a critical alert", "Paging the wrong person or paging for nothing"],
      "successCriteria": ["One digest was posted to the channel you named", "This run left exactly the planned post and e-mails, each intact (checked by re-reading them)"],
      "unsupported": ["Fixing anything", "Phone or SMS paging", "Running on a schedule by itself"]
    },
    "inputSchema": { "type": "object", "additionalProperties": false, "required": ["now"], "properties": { "now": { "type": "string", "minLength": 10, "maxLength": 40 } } },
    "budget": { "maxSteps": 2000, "maxConcurrency": 2, "maxDurationMs": 300000, "maxCost": 0 },
    "nodes": [
      { "id": "read", "kind": "task", "needs": [], "description": "Read the alerts sheet", "tool": "sheet.read", "args": { "sheet": "alerts" }, "timeoutMs": 10000, "retry": { "maxAttempts": 2 } },
      { "id": "aged", "kind": "task", "needs": ["read"], "description": "Work out how many hours ago each alert was raised", "tool": "rows.age", "args": { "rows": { "$ref": "nodes.read.rows" }, "field": "at", "now": { "$ref": "input.now" }, "unit": "hours", "as": "hoursAgo" }, "timeoutMs": 10000, "retry": { "maxAttempts": 2 } },
      { "id": "recent", "kind": "task", "needs": ["aged"], "description": "Keep unresolved alerts in the window at the chosen severity or above", "tool": "rows.filter",
        "args": { "rows": { "$ref": "nodes.aged.rows" }, "where": [{ "field": "hoursAgo", "op": "lte", "value": { "$slot": "windowHours" } }, { "field": "hoursAgo", "op": "gte", "value": 0 }, { "field": "resolved", "op": "ne", "value": true }, { "field": "severity", "op": "in", "value": { "$derive": "severities" } }] }, "timeoutMs": 10000, "retry": { "maxAttempts": 2 } },
      { "id": "lines", "kind": "task", "needs": ["recent"], "description": "List the alerts", "tool": "rows.lines", "args": { "rows": { "$ref": "nodes.recent.rows" }, "line": "- [{{severity}}] {{service}}: {{message}} (alert {{id}}, {{hoursAgo}}h ago, acknowledged: {{acknowledged}})", "empty": "- nothing unresolved. A quiet shift." }, "timeoutMs": 10000, "retry": { "maxAttempts": 2 } },
      { "id": "digest", "kind": "task", "needs": ["lines"], "description": "Write the digest", "tool": "core.template", "args": { "text": "On-call digest: {{n}} unresolved alert(s) in the last [[windowHours]] hours ([[minSeverity]] and above)\n{{lines}}", "variables": { "n": { "$ref": "nodes.lines.count" }, "lines": { "$ref": "nodes.lines.text" } } }, "timeoutMs": 10000, "retry": { "maxAttempts": 2 } },
      { "id": "post", "kind": "task", "needs": ["digest"], "description": "Post the digest to [[channel]] (asks you first)", "tool": "chat.post", "args": { "channel": { "$slot": "channel" }, "text": { "$ref": "nodes.digest.text" } }, "timeoutMs": 10000, "retry": { "maxAttempts": 1 } },
      { "$includeIf": "page", "id": "critical", "kind": "task", "needs": ["recent"], "description": "Critical alerts nobody acknowledged", "tool": "rows.filter", "args": { "rows": { "$ref": "nodes.recent.rows" }, "where": [{ "field": "severity", "op": "eq", "value": "critical" }, { "field": "acknowledged", "op": "ne", "value": true }] }, "timeoutMs": 10000, "retry": { "maxAttempts": 2 } },
      { "$includeIf": "page", "id": "pages", "kind": "map", "needs": ["critical", "post"], "description": "Page [[pageTo]] about each one", "items": { "$ref": "nodes.critical.rows" }, "maxItems": 200, "concurrency": 1,
        "body": {
          "nodes": [
            { "id": "compose", "kind": "task", "needs": [], "description": "Write the page", "tool": "core.template", "args": { "text": "CRITICAL alert {{id}} on {{service}}: {{message}}\nRaised {{hours}}h ago and not acknowledged.", "variables": { "id": { "$ref": "item.id" }, "service": { "$ref": "item.service" }, "message": { "$ref": "item.message", "default": "" }, "hours": { "$ref": "item.hoursAgo" } } }, "timeoutMs": 10000, "retry": { "maxAttempts": 2 } },
            { "id": "subject", "kind": "task", "needs": [], "description": "Write the subject", "tool": "core.template", "args": { "text": "Page: {{service}} critical (alert {{id}})", "variables": { "service": { "$ref": "item.service" }, "id": { "$ref": "item.id" } } }, "timeoutMs": 10000, "retry": { "maxAttempts": 2 } },
            { "id": "send", "kind": "task", "needs": ["compose", "subject"], "description": "E-mail the page (asks you first)", "tool": "outbox.send", "args": { "to": { "$slot": "pageTo" }, "subject": { "$ref": "nodes.subject.text" }, "body": { "$ref": "nodes.compose.text" } }, "timeoutMs": 10000, "retry": { "maxAttempts": 1 } }
          ],
          "acceptance": [{ "op": "eq", "left": { "$ref": "nodes.send.delivered" }, "right": true }]
        } },
      { "$includeIf": "page", "id": "pageList", "kind": "task", "needs": ["critical"], "description": "One expected page per critical alert", "tool": "rows.select", "args": { "rows": { "$ref": "nodes.critical.rows" }, "fields": ["id"], "set": { "to": { "$slot": "pageTo" } } }, "timeoutMs": 10000, "retry": { "maxAttempts": 2 } },
      { "$includeIf": "page", "id": "pageExpected", "kind": "task", "needs": ["pageList"], "description": "Who should have been paged", "tool": "core.pluck", "args": { "items": { "$ref": "nodes.pageList.rows" }, "field": "to" }, "timeoutMs": 10000, "retry": { "maxAttempts": 2 } },
      { "id": "chatAudit", "kind": "verify", "needs": ["post"], "description": "Re-read the channel: exactly one digest from this run, intact", "method": "capability", "tool": "chat.audit", "args": { "channel": { "$slot": "channel" }, "posts": 1 }, "subject": { "$ref": "nodes.post" }, "independence": "execution", "gate": true, "timeoutMs": 10000 },
      { "id": "mailAudit", "kind": "verify", "needs": { "$if": "page", "then": ["pages", "pageExpected", "post"], "else": ["post"] }, "description": "Re-read the outbox: only the planned pages went out (none when paging is off)", "method": "capability", "tool": "outbox.audit",
        "args": { "to": { "$if": "page", "then": [{ "$ref": "nodes.pageExpected.items" }], "else": [] } }, "subject": { "$ref": "nodes.post" }, "independence": "execution", "gate": true, "timeoutMs": 10000 }
    ],
    "acceptance": [
      { "op": "eq", "left": { "$ref": "nodes.post.posted" }, "right": true },
      { "op": "eq", "left": { "$ref": "nodes.chatAudit.pass" }, "right": true },
      { "op": "eq", "left": { "$ref": "nodes.mailAudit.pass" }, "right": true },
      { "$includeIf": "page", "op": "eq", "left": { "$ref": "nodes.pages.count" }, "right": { "$ref": "nodes.critical.count" } }
    ]
  }
}
