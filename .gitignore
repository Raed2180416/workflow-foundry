# no trailing slash: a worktree links node_modules to the main tree, and "node_modules/" does not match a symlink
node_modules
corpus/
.foundry/
.venv/
__pycache__/
evals/runs/
web/artifacts/
research/reference-swe/
research/product-demo/
*.tgz
*.log
.DS_Store
experiments/runs/

# workflow corpus: the uncompressed files are rebuilt from the gzipped copies in git
# (node research/corpus-20261006/scripts/unpack.mjs); ROADMAP §6 rule 6
research/corpus-20261006/items.jsonl
research/corpus-20261006/items-sample.jsonl
research/corpus-20261006/parts/*.jsonl

# Workflow agent worktrees (temporary git worktrees, never committed)
.claude/worktrees/

# Committed stream-run exports (BLOCKER-SYNTHESIS S0-1; stream.mjs persist.commitDir, default
# research/jit-20261008/runs/<experiment>/): text only (JSONL, solvers, MANIFEST.json), never ignored by the patterns
# above. The raw run directories under experiments/runs/ (SQLite journals, scratch) stay ignored.
!research/*/runs/
!research/*/runs/**
beds/ebed/e8/.mutants/

# need-router label-run directory locks (experiments/need-router/label-run.mjs): live-process state, never committed
**/.label-run.lock
**/.label-run.lock.stale-*

# SOP-Bench (CC BY-NC 4.0): per-row results carry upstream-derived values; kept outside git (aggregates only)
research/sopbench-20261021/runs/**/results.jsonl
research/sopbench-20261021/runs/**/rows/

# Model journals can carry host account identity (claude -p puts the session account e-mail in context); keep them outside git.
research/surface-20261021/runs/**/journal.sqlite*
